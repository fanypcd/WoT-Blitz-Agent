<rml>
	<head>
		<title>Photo</title>
		<link type="text/template" href="/rml/templates/button_icon.rml" />
		<link type="text/template" href="/rml/templates/menu.rml" />
		<script>
PhotoMenu = {}
PhotoMenu.__index = PhotoMenu
setmetatable(PhotoMenu, {__index = Menu})

function PhotoMenu:new(obj)
    local obj = Menu:new(obj)
	setmetatable(obj, self)

    obj.document:GetElementById("content"):SetClass("rounded-bl", true)
    obj.elements = {}

    local element_ids = {
        "email_button", "camera_button"
    }
    
    for _, id in ipairs(element_ids) do
        obj.elements[id] = obj.document:GetElementById(id)
    end

    PhotoMenu = obj

    if PLATFORM_EMSCRIPTEN then
        obj.elements["email_button"]:SetClass("hidden", true)
        obj.elements["camera_button"]:SetClass("hidden", true)
    end    

    -- connect signals
    screenshot_service:connect_screenshotUploadingStartedSignal(function()
        Popup.open("UI_uploading", "", false)
    end)

    screenshot_service:connect_screenshotUploadedSignal(function(url)
        local message = fmt("UI_link_copied") .. [[
<br/>
<div class="button">
<p class="mt-2 text-primary overflow-hidden whitespace-nowrap hover_underline" onclick="game:launchURL(']] .. url .. "')\">" 
.. url .. 
'</p></div>'
        Popup.open("UI_uploaded", message, false, "UI_ok", function() game:copyToClipboard(url) end)
    end)

    screenshot_service:connect_screenshotUploadFailedSignal(function(error)
        Popup.open("UI_error_title", error, true)
    end)

    -- sync ui
    return obj
end

        </script>
	</head>
	<body id="photo_menu" template="menu" class="right-0" onload="PhotoMenu:new{document = document, is_right = true}">
        <button id="email_button" class="text-secondary" onclick="screenshot_service:makeScreenshotFlashlight(ScreenshotService.SaveOption.EMAIL)">
            <template src="button_icon">
                <div class="w-8 flex flex-col truncate">
                    <p class="text-xs">UI_icon_email</p>
                    <svg src="/rml/icons/UI-email-.svg" class="w-8 flex-none" />
                </div>
            </template>
        </button>
        <button id="camera_button" class="text-secondary" onclick="screenshot_service:makeScreenshotFlashlight(ScreenshotService.SaveOption.CAMERA_ROLL)">
            <template src="button_icon">
                <div class="w-8 flex flex-col truncate">
                    <p class="text-xs">UI_icon_pic</p>
                    <svg src="/rml/icons/photo-picture-.svg" class="w-8 flex-none" />
                </div>
            </template>
        </button>
        <button class="text-secondary" onclick="screenshot_service:makeScreenshotFlashlight(ScreenshotService.SaveOption.IMGUR)">
            <template src="button_icon">
                <div class="w-8 flex flex-col truncate">
                    <p class="text-xs">UI_icon_link</p>
                    <svg src="/rml/icons/UI-Link-.svg" class="w-8 flex-none" />
                </div>
            </template>
        </button>
        <button class="text-secondary" onclick="Toolbar:open(false)">
            <template src="button_icon">
                <div class="w-8 flex flex-col truncate h-8 justify-between">
                    <p class="text-xs">UI_icon_back</p>
                    <svg src="/rml/icons/UI-Arrow-Right.svg" class="w-3 mb-1 flex-none self-center" crop-to-content="1" style="transform: scaleX(-1)" />
                </div>
            </template>
        </button>
    </body>
</rml>