<rml>
    <head>
        <title>Shot List</title>
        <link type="text/template" href="/rml/templates/info_panel.rml" />
        <link type="text/template" href="/rml/templates/button.rml" />
        <link type="text/template" href="/rml/templates/button_icon.rml" />
        <script>
ShotList = {}
setmetatable(ShotList, {__index = InfoPanel})
ShotList.__index = ShotList

local utils = require ("rml.scripts.utils")

function ShotList:new(o)
    local obj = InfoPanel:new(o)
    setmetatable(obj, self)

    obj:setSecondTitle("UI_shots_desc")
    obj:setMainTitle("UI_title_shots")

    obj.elements = {}
    obj.current_battle = nil
    obj.current_shot_index = nil
    obj.current_shot_element = nil
    obj.first_timestamp = 0
    
    local element_ids = {
        "shot_table", "not_logged_in", "no_game_account", "empty_shots",
        "shots_desc_pc", "mod_button", "shots_desc_blitz", "replays_button",
        "platform_name"
    }
    
    for _, id in ipairs(element_ids) do
        obj.elements[id] = obj.document:GetElementById(id)
    end
    
    ShotList = obj
    
    -- connect signals

    -- sync ui
    return obj
end

function ShotList:onShotClick(battles, battle_index, shot_index, new_shot_element)
    local battle = battles[battle_index]

    if self.current_shot_element then
        self.current_shot_element[1]:SetClass("bg-content-dark", false)
        self.current_shot_element[2]:SetClass("bg-content-dark", false)
    end
    new_shot_element[1]:SetClass("bg-content-dark", true)
    new_shot_element[2]:SetClass("bg-content-dark", true)
    self.current_battle = battle.timestamp
    self.current_shot_index = shot_index
    self.current_shot_element = new_shot_element
    
    battle.shots[shot_index]:simulateShot()
end

function ShotList.setShots(battles)
    local self = ShotList
    self.elements["shot_table"].inner_rml = ""

    local platform = db_service.platform
    
    self.elements["not_logged_in"]:SetClass("hidden", account_service.user)
    self.elements["no_game_account"]:SetClass("hidden", not account_service.user or account_service.user.wgid ~= 0)
    self.elements["empty_shots"]:SetClass("hidden", account_service.user and account_service.user.wgid > 0 and #battles > 0)
    self.elements["shots_desc_pc"]:SetClass("hidden", not platform or (platform.game_code ~= "pc" and platform.game_code ~= "mirtankov"))
    self.elements["mod_button"]:SetClass("hidden", not platform or (platform.game_code ~= "pc" and platform.game_code ~= "mirtankov"))
    self.elements["shots_desc_blitz"]:SetClass("hidden", not platform or (platform.game_code ~= "blitz" and platform.game_code ~= "tanksblitz"))
    self.elements["replays_button"]:SetClass("hidden", not platform or (platform.game_code ~= "blitz" and platform.game_code ~= "tanksblitz"))

    if not platform then
        return
    end    
    
    self.elements["platform_name"].inner_rml = platform.version

    local battle_template = [[
        <div class="flex items-start">
            <div class="flex-1">
                <p class="battle-time"></p>
                <div>
                    <span class="battle-map"></span> | <span class="battle-game-mode"></span>
                </div>
            </div>
            <button class="inline-flex gap-2 items-center justify-center shadow-md rounded text-xs leading-none lowercase bg-secondary text-primary-foreground p-1">
                <p>UI_watch_replay</p>
            </button>
        </div>
        <hr />
        <table class="pb-2 pt-1" style="column-gap:4dp;"></table>
    ]]

    local locked_template = [[
        <div class="flex gap-2 items-center text-premium bg-content-dark p-1 mb-2">
            <svg class="w-8" src="/rml/icons/Shop-.svg" />
            <p class="text-sm center">UI_shots_locked</p>
        </div>
    ]]

    local shot_template = [[
        <td class="w-7 pl-0_5">
            <p class="shot-time whitespace-nowrap"></p>
        </td>
        <td>
            <p class="shot-shooter font-bold"></p>
        </td>
        <td class="w-8">
            <svg class="w-4 mx-auto shot-icon" src="/rml/icons/Event-PenNO-Bounce.svg" />
        </td>
        <td class="pr-0_5">
            <p class="shot-target font-bold text-right"></p>
        </td>
    ]]
    
    local shot_details_template = [[
        <td class="w-7 pl-0_5">
        </td>
        <td>
            <p class="shot-ammo"></p>
        </td>
        <td colspan="2" class="pr-0_5">
            <div class="flex gap-1 items-center justify-end">
                <div class="shot-crits space-x-1"></div>
                <p class="shot-damage whitespace-nowrap float-right"></p>
            </div>
        </td>
    ]]
    
    for battle_index, battle in ipairs(battles) do
    
        if battle_index == 1 then
            self.first_timestamp = battle.timestamp
            settings:setInt("ui.shotsAvailable_" .. platform.game_code, self.first_timestamp)
        end
        
        if battle_index == 2 and battle.is_locked then
            local locked_row = self.elements["shot_table"]:AppendChild(self.document:CreateElement("div"))
            locked_row.inner_rml = locked_template
            locked_row:AddEventListener("click", function() self:close() ui_service:navigateToPurchase(IAPService.WOTINSPECTOR_SUB) end, true)
        end
    
        local battle_row = self.elements["shot_table"]:AppendChild(self.document:CreateElement("div"))
        battle_row.inner_rml = battle_template

        battle_row:QuerySelector(".battle-time").inner_rml = battle.battle_start_time
        battle_row:QuerySelector(".battle-map").inner_rml = battle.map_name
        battle_row:QuerySelector(".battle-game-mode").inner_rml = battle.game_mode
        
        if #battle.replay_id == 0 then
            battle_row:QuerySelector("button"):SetClass("hidden", true)
        else
            local replay_url = utils.addAppUtm("https://replays.wotinspector.com/view/" .. battle.replay_id, "shots", "replay_view")
            battle_row:QuerySelector("button"):AddEventListener("click", function() game:launchURL(replay_url) end, true)
        end
        
        local table = battle_row:QuerySelector("table")
        
        for shot_index, shot in ipairs(battle.shots) do
            local shot_row = table:AppendChild(self.document:CreateElement("tr"))
            shot_row:SetClass("px-0_5", true)
            shot_row:SetClass("pt-0_5", true)
            shot_row.inner_rml = shot_template

            local shot_details_row = table:AppendChild(self.document:CreateElement("tr"))
            shot_details_row:SetClass("px-0_5", true)
            shot_details_row:SetClass("pb-0_5", true)
            shot_details_row.inner_rml = shot_details_template

            if battle.timestamp == self.current_battle and shot_index == self.current_shot_index then
                shot_row:SetClass("bg-content-dark", true)
                shot_details_row:SetClass("bg-content-dark", true)
                self.current_shot_element = { shot_row, shot_details_row }
            end
            
            if battle.is_locked then
                shot_row:AddEventListener("click", function() self:close() ui_service:navigateToPurchase(IAPService.WOTINSPECTOR_SUB) end, true)
                shot_details_row:AddEventListener("click", function() self:close() ui_service:navigateToPurchase(IAPService.WOTINSPECTOR_SUB) end, true)
            else
                shot_row:AddEventListener("click", function() self:onShotClick(battles, battle_index, shot_index, { shot_row, shot_details_row }) end, true)
                shot_details_row:AddEventListener("click", function() self:onShotClick(battles, battle_index, shot_index, { shot_row, shot_details_row }) end, true)
            end

            local shooter_info = platform:getVehicleInfo(shot.shooter.vehicle_id)
            local shooter_name = shooter_info and platform:getTextUTF8(shooter_info.short_name) or "UI_unknown"
            local target_info = platform:getVehicleInfo(shot.target.vehicle_id)
            local target_name = target_info and platform:getTextUTF8(target_info.short_name) or "UI_unknown"
            
            local shooter_name_element = shot_row:QuerySelector(".shot-shooter")
            local target_name_element = shot_row:QuerySelector(".shot-target")
            
            shooter_name_element:SetClass("text-team-protagonist", shot.mode == ShotMode.SHOOTER_IS_PROTAGONIST)
            shooter_name_element:SetClass("text-team-enemy", shot.mode ~= ShotMode.SHOOTER_IS_PROTAGONIST)
            shooter_name_element.inner_rml = shooter_name
            target_name_element:SetClass("text-team-protagonist", shot.mode == ShotMode.TARGET_IS_PROTAGONIST)
            target_name_element:SetClass("text-team-enemy", shot.mode ~= ShotMode.TARGET_IS_PROTAGONIST)
            target_name_element.inner_rml = target_name
            
            shot_row:QuerySelector(".shot-time").inner_rml = fmt("{:02}:{:02}", shot.time // 60, shot.time % 60)
            
            local shell_info = platform:getShellInfo(shot.shooter.shell_id)
            shot_details_row:QuerySelector(".shot-ammo").inner_rml = shell_info and platform.getShellTypeName(shell_info.kind) or "UI_unknown"
            
            if shot.damage > 0 then
                shot_details_row:QuerySelector(".shot-damage").inner_rml = fmt("UI_hp_format", fmt("{:.0Lf}", shot.damage))
                shot_row:QuerySelector(".shot-icon"):SetAttribute("src", "/rml/icons/Event-Penetration-3.svg")
            else
                shot_row:QuerySelector(".shot-icon"):SetAttribute("src", "/rml/icons/Event-PenNO-Bounce.svg")
                shot_row:SetClass("opacity-70", true)
                shot_details_row:SetClass("opacity-70", true)
            end
            
            if shot.crit_modules > 0 or shot.destroyed_modules > 0 then
                local crit_container = shot_details_row:QuerySelector(".shot-crits")

                for module_id = 1, PlatformDB.DeviceType.MAX_DEVICES - 1 do
                    if shot.crit_modules & (1 << module_id) ~= 0 then
                        local icon = crit_container:AppendChild(self.document:CreateElement("svg"))
                        icon:SetClass("w-4", true)
                        icon:SetClass("text-module-crit", true)
                        icon:SetAttribute("src", "/rml/icons/" .. utils.getModuleIcon(module_id))
                    end
                    if shot.destroyed_modules & (1 << module_id) ~= 0 then
                        local icon = crit_container:AppendChild(self.document:CreateElement("svg"))
                        icon:SetClass("w-4", true)
                        icon:SetClass("text-module-destroy", true)
                        icon:SetAttribute("src", "/rml/icons/" .. utils.getModuleIcon(module_id))
                    end
                end
            end
        end
    end
end

function ShotList:checkVisibility()
    return true
end

function ShotList:updateData()
    if not self:checkVisibility() then
        return
    end
end

function ShotList:open()
    InfoPanel.open(self)

    settings:setInt("ui.shotsOpened", 1)

    if self.first_timestamp > 0 and db_service.platform then
        settings:setInt("ui.shots_" .. db_service.platform.game_code, self.first_timestamp)
    end
end

function ShotList.openConnectAccount()
    game:launchURL(account_service:addTokenToUri(utils.addAppUtm("https://wotinspector.com/accounts/3rdparty/", "shots", "connect_account")))
end

function ShotList.openModPage()
    game:launchURL(utils.addAppUtm("https://wotinspector.com/mods/armorinspector/", "shots", "mod_button"))
end

function ShotList.openReplays()
    game:launchURL(utils.addAppUtm("https://replays.wotinspector.com/", "shots", "replays"))
end
        </script>
    </head>
    <body id="shot_list" template="info_panel" onload='ShotList:new{document = document, is_right = true}' style="width:100%;max-width:230dp;">
        <div id="shot_table" class="text-xs">
        </div>
        <div id="not_logged_in" class="text-sm mb-4">
            <p class="mb-2">UI_shots_not_logged_in</p>
            <button id="login_button" class="flex bg-secondary text-primary-foreground rounded" onclick="ui_service:navigateToAccounts() account_service:startAuthFlow()">
                <template src="button">
                    <p>UI_login</p>
                </template>
            </button>
        </div>
        <div id="no_game_account" class="hidden text-sm mb-4">
            <p>UI_no_account_connected</p>
            <button class="flex mt-2 bg-secondary text-primary-foreground rounded" onclick="ShotList.openConnectAccount()">
                <template src="button">
                    <p>UI_connect_account</p>
                </template>
            </button>
        </div>
        <div id="empty_shots" class="text-sm">
            <span>UI_shots_empty</span>&nbsp;<span id="platform_name"></span>.&nbsp;<span id="shots_desc_pc" class="hidden">UI_shots_descr_pc</span><span id="shots_desc_blitz" class="hidden">UI_shots_descr_blitz</span>
            <button id="mod_button" class="flex mt-2 hidden bg-secondary text-primary-foreground rounded" onclick="ShotList.openModPage()">
                <template src="button">
                    <p>UI_download_mod</p>
                </template>
            </button>
            <button id="replays_button" class="flex mt-2 hidden bg-secondary text-primary-foreground rounded" onclick="ShotList.openReplays()">
                <template src="button">
                    <p>UI_upload_replays</p>
                </template>
            </button>
        </div>
    </body>
</rml>