<rml>
    <head>
        <title>Camera Distance</title>
        <link type="text/rcss" href="/rml/main.rcss"/>
        <style>
        </style>
        <script>
CameraDistanceWidget = {}
CameraDistanceWidget.__index = CameraDistanceWidget

local function onUpdateDataThrottle()
    local self = CameraDistanceWidget
    if self.throttle:shouldExecute() then
        self:updateData()
    end
end

function CameraDistanceWidget:new(obj)
    setmetatable(obj, self)
    
    obj.throttle = Throttle.new(0.1)
    obj.elements = {}
    obj.elements["distance"] = obj.document:GetElementById("distance")
    
    CameraDistanceWidget = obj
    
    -- connect signals
    scene_service.camera_controller:connect_cameraViewportUpdatedSignal(onUpdateDataThrottle)    
    return obj
end

function CameraDistanceWidget:updateData()
    local camera_controller = scene_service.camera_controller
    local distance = camera_controller.is_top_down and math.tan(math.rad(camera_controller.camera.field_of_view) * 0.5) * camera_controller.camera.node.translation_world.y or settings:getFloat("scene.distance")
    
    self.elements["distance"].inner_rml = fmt("UI_meters_format", fmt("{:.0Lf}", distance))
end

        </script>
    </head>
    <body id="camera_distance" class="text-hud pointer-events-none w-40" style="z-index:-10" onload="CameraDistanceWidget:new({document = document})">
        <p id="distance" class="text-center" style="margin-top:50dp">100m</p>
    </body>
</rml>