<rml>
    <head>
        <title>Cutaway Scissors0 Handle</title>
        <link type="text/rcss" href="/rml/main.rcss"/>
        <style>
        </style>
        <script>
XrayCutawayScissors0Handle = {}

function XrayCutawayScissors0Handle:onDragStart(element, x, y)
    self.offset_x = x - element.offset_left + tonumber(element:GetAttribute("data-offset-x"))
    self.offset_y = y - element.offset_top + tonumber(element:GetAttribute("data-offset-y"))
end

function XrayCutawayScissors0Handle:onDrag(x, y)
    xray_scene_objects:cutawayHandleMove(x - self.offset_x, y - self.offset_y, 0)
end

function XrayCutawayScissors0Handle:onDragEnd()
    if settings:getInt("scene.viewMode") == ViewMode.CROSS_SECTION_XRAY then
        xray_scene_objects:updateCutawayHandlesAndCutline()
    end
end
        </script>
    </head>
    <body id="xray_cutaway_scissors0_handle" class="w-8 text-hud flex" style="z-index:-10;drag:drag" 
          ondragstart="XrayCutawayScissors0Handle:onDragStart(element, event.parameters['mouse_x'], event.parameters['mouse_y'])"
          ondrag="XrayCutawayScissors0Handle:onDrag(event.parameters['mouse_x'], event.parameters['mouse_y'])"
          ondragend="XrayCutawayScissors0Handle:onDragEnd()"
          >
        <svg src="/rml/icons/AI-cutaway-Scissors-.svg" class="w-8" style="transform: scaleX(-1.0)" />
    </body>
</rml>