}

button:active:not(.disabled).bg-premium.text-primary-foreground svg {
  image-color: #ffd400;
}

.icon {
  border-color: transparent;
  border-width: 0.5dp;
  transition: border-color 0.5s cubic-in-out;
}

.icon.selected {
  border-color: #73e8ff;
}

.icon.disabled {
  filter: grayscale(1);
  opacity: 0.5;
}

