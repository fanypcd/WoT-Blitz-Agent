/* Custom classes */
.bg-content {
  background-color: #525252f0;
}

.bg-header {
  background-color: #323232;
}

.bg-content-dark {
  background-color: #424242f0;
}

.bg-tooltip {
  background-color: #00000090;
}

.bg-secondary {
  background-color: #73e8ff;
}

.bg-secondary-outline {
  box-sizing: border-box;
  background-color: #10101040;
  border: 1dp #73e8ff;
}

.bg-beta, .bg-premium {
  background-color: #ffd400;
}

.border-transparent {
  border-color: transparent;
}

.border-primary {
  border-color: #cecece;
}

.border-muted {
  border-color: #9b9b9b;
}

.border-secondary {
  border-color: #73e8ff;
}

button:hover:not(.disabled).bg-secondary {
  background-color: rgb(38.5, 219.4321428571, 255);
}

button.bg-secondary.disabled {
  background-color: rgb(0, 181.35, 217);
}

button.bg-premium.disabled {
  background-color: rgb(153, 127.2, 0);
}

button:hover:not(.disabled).bg-secondary-outline {
  background-color: #10101070;
}

button:hover:not(.disabled).bg-premium {
  background-color: rgb(219.3, 182.32, 0);
}

button:active:not(.disabled).bg-secondary {
  background-color: #323232;
}

button:active:not(.disabled).bg-secondary-outline {
  background-color: #101010;
}

button:active:not(.disabled).bg-premium {
  background-color: #323232;
}

.text-primary {
  color: #cecece;
}

.text-primary svg, svg.text-primary {
  image-color: #cecece;
}

.text-muted {
  color: #9b9b9b;
}

.text-muted svg, svg.text-muted {
  image-color: #9b9b9b;
}

.text-secondary {
  color: #73e8ff;
}

.text-secondary svg, svg.text-secondary, img.text-secondary {
  image-color: #73e8ff;
}

button.text-secondary.disabled {
  color: rgb(0, 181.35, 217);
}

button.text-secondary.disabled svg {
  image-color: rgb(0, 181.35, 217);
}

button:hover:not(.disabled, :active).text-secondary {
  color: rgb(38.5, 219.4321428571, 255);
}

button:hover:not(.disabled, :active).text-secondary svg {
  image-color: rgb(38.5, 219.4321428571, 255);
}

.text-hud {
  color: #00c8ff;
}

.text-black {
  color: black;
}

.text-white {
  color: white;
}

.text-black svg {
  image-color: black;
}

.text-hud svg {
  image-color: #00c8ff;
}

