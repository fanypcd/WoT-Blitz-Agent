/*
* Default styles for all the basic elements.
*/
body, div,
h1, h2, h3, h4,
h5, h6, p,
hr, pre,
button,
tabset tabs {
  display: block;
}

body {
  font-family: "Helvetica Neue";
  font-weight: normal;
  font-style: normal;
  font-size: 16dp;
  line-height: 24dp;
}

b {
  font-weight: 700;
}

small {
  font-size: 0.8em; /* for units */
}

em {
  font-style: italic;
}

strong {
  font-weight: bold;
}

hr {
  border-width: 0.5dp;
  border-color: #cecece;
}

table {
  box-sizing: border-box;
  display: table;
}

tr {
  box-sizing: border-box;
  display: table-row;
}

td {
  box-sizing: border-box;
  display: table-cell;
}

col {
  box-sizing: border-box;
  display: table-column;
}

colgroup {
  display: table-column-group;
}

thead, tbody, tfoot {
  display: table-row-group;
}

scrollbarvertical {
  margin-left: 4dp;
  margin-right: 2dp;
  width: 2dp;
}

sliderbar {
  width: 2dp;
  background-color: #cecece;
}

input.range slidertrack {
  height: 12dp;
  border-color: transparent;
  border-top-width: 6dp;
  border-bottom-width: 4dp;
  background-color: #9b9b9b;
  box-sizing: border-box;
}

input.range sliderprogress {
  height: 2dp;
  border-radius: 9999px;
  background-color: #73e8ff;
}

input.range sliderbar {
  background-color: #73e8ff;
}

input.range.player sliderprogress, input.range.player sliderbar {
  background-color: #6aff00;
}

input.range.player slidertrack {
  background-color: #29a600;
}

input.range.target sliderprogress, input.range.target sliderbar {
  background-color: #ff335c;
}

input.range.target slidertrack {
  background-color: #bf0010;
}

input.range sliderbar {
  margin-top: 1dp;
  width: 12dp;
  height: 12dp;
  border-radius: 9999px;
}

@keyframes progress-bar {
  0% {
    background-color: rgb(0, 138.7285714286, 166);
  }
  to {
    background-color: #73e8ff;
  }
}
progress {
  height: 4dp;
  background-color: #444;
}

progress fill {
  background-color: #73e8ff;
  animation: 1s cubic-in-out infinite alternate progress-bar;
}

table {
  box-sizing: border-box;
  display: table;
}

tr {
  box-sizing: border-box;
  display: table-row;
}

td {
  box-sizing: border-box;
  display: table-cell;
}

col {
  box-sizing: border-box;
  display: table-column;
}

colgroup {
  display: table-column-group;
}

thead, tbody, tfoot {
  display: table-row-group;
}

select {
  text-align: left;
}

select selectvalue {
  color: #73e8ff;
}

select selectarrow {
  display: none;
  width: 16dp;
  height: 16dp;
  margin-top: auto;
  margin-bottom: auto;
  margin-right: 12dp;
  decorator: image("/ui/icons/chevron-down.png");
}

.text-primary select selectvalue svg, select selectvalue svg, select selectarrow {
  image-color: #73e8ff;
}

select selectvalue:hover {
  color: rgb(38.5, 219.4321428571, 255);
}

select selectvalue:hover svg, select:hover selectarrow {
  image-color: rgb(38.5, 219.4321428571, 255);
}

select selectbox {
  margin-top: 4dp;
  margin-bottom: 4dp;
  width: 200dp;
  background-color: #525252f0;
  padding: 4dp;
  border-radius: 4dp;
  border-color: #323232;
  border-width: 0.5dp;
}

select selectbox option, .list > .option {
  border-radius: 4dp;
}

select selectbox option:checked, .list > .option.checked {
  background-color: #424242f0;
  color: #73e8ff;
}

select selectbox option:checked svg, .list > .option.checked svg {
  image-color: #73e8ff;
}

select selectbox option:hover, .list > .option:hover {
  background-color: #424242f0;
}

switch {
  display: block;
  position: relative;
  border-radius: 9999px;
  background-color: transparent;
  width: 32dp;
  height: 16dp;
  border: 1dp #323232;
  transition: background-color 0.1s;
}

switch.small {
  width: 24dp;
  height: 12dp;
}

switch.checked {
  background-color: #323232;
}

switch > .thumb {
  position: absolute;
  border-radius: 9999px;
  background-color: #73e8ff;
  transform: translateX(2dp);
  top: 1dp;
  width: 14dp;
  height: 14dp;
  transition: transform 0.1s;
}

switch.small > .thumb {
  width: 10dp;
  height: 10dp;
}

switch.checked > .thumb {
  transform: translateX(16dp);
}

switch.small.checked > .thumb {
  transform: translateX(12dp);
}

