<rml>
	<head>
		<title>Xray Menu</title>
		<link type="text/template" href="/rml/templates/button_icon.rml" />
		<link type="text/template" href="/rml/templates/menu.rml" />
		<script>
XrayMenu = {}
XrayMenu.__index = XrayMenu
setmetatable(XrayMenu, {__index = Menu})

local function onPlatformChanged(platform)
    local self = XrayMenu
    self.elements["hdmodel_button"]:SetClass("hidden", not platform or not platform.has_web_visual_models)
    self.elements["stats_button"]:SetClass("hidden", not platform or platform.game_code == "reforged" or platform.game_code == "console")
end

local function updateButtonColors()
    local self = XrayMenu
    self:updateButtonColors()
end

function XrayMenu:updateButtonColors()
    local view_mode = settings:getInt("scene.viewMode")
    local show_modules = settings:getBool("scene.showModules")
    local specs_opened = XraySpecs and XraySpecs:isVisible()
    local stats_opened = (XrayStats and XrayStats:isVisible())
        or (EarlyAccessTab and EarlyAccessTab:isVisible())

    self.elements["specs_button"]:SetClass("bg-header", specs_opened)
    self.elements["stats_button"]:SetClass("bg-header", stats_opened)
    self.elements["modules_button"]:SetClass("bg-header", not specs_opened and not stats_opened and view_mode == ViewMode.ARMOR and show_modules)
    self.elements["armor_button"]:SetClass("bg-header", not specs_opened and not stats_opened and view_mode == ViewMode.ARMOR and not show_modules)
    self.elements["crosssection_button"]:SetClass("bg-header", not specs_opened and not stats_opened and view_mode == ViewMode.CROSS_SECTION_XRAY)
    self.elements["model_button"]:SetClass("bg-header", not specs_opened and not stats_opened and view_mode == ViewMode.WHITE)
    self.elements["hdmodel_button"]:SetClass("bg-header", not specs_opened and not stats_opened and view_mode == ViewMode.TEXTURED)
end

function XrayMenu:new(obj)
    local obj = Menu:new(obj)
    setmetatable(obj, self)

    obj.elements = {}

    local element_ids = {
        "specs_button", "stats_button", "modules_button", "crosssection_button", 
        "armor_button", "model_button", "hdmodel_button",
    }
    
    for _, id in ipairs(element_ids) do
        obj.elements[id] = obj.document:GetElementById(id)
    end

    XrayMenu = obj
    
    local content = obj.document:GetElementById("content")
    content:SetClass("bg-content", false)
    content:SetClass("p-0_5", false)
    content:SetClass("gap-1", false)

    -- connect signals
    runOnChange(updateButtonColors, "scene.viewMode", "scene.showModules")
    db_service:connect_platformChangedSignal(onPlatformChanged)

    -- sync ui
    onPlatformChanged(db_service.platform)
    return obj
end

function XrayMenu:open(slide_in_left)
    Menu.open(self, slide_in_left)
    
    local view_mode = settings:getInt("scene.viewMode")
    if view_mode ~= ViewMode.ARMOR and view_mode ~= ViewMode.WHITE and view_mode ~= ViewMode.TEXTURED and view_mode ~= ViewMode.CROSS_SECTION_XRAY then
        settings:setInt("scene.viewMode", ViewMode.ARMOR)
    end
end

function XrayMenu:onStatsButton()
    if iap_service:hasProduct(IAPService.WOTINSPECTOR_SUB) then
        XrayStats:toggle()
    elseif EarlyAccessTab:isVisible() then
        EarlyAccessTab:close()
    else
        EarlyAccessTab:open("UI_title_stats")
    end
    self:updateButtonColors()
end

function XrayMenu:onModulesButton()
    if XrayInfoPanel:checkVisibility() and settings:getInt("scene.viewMode") == ViewMode.ARMOR and settings:getBool("scene.showModules") then
        XrayInfoPanel:toggle()
    else
        settings:setInt("scene.viewMode", ViewMode.ARMOR)
        settings:setBool("scene.showModules", true)
        XrayInfoPanel:open()
    end
    self:updateButtonColors()
end

function XrayMenu:onCrossSectionButton()
    if XrayInfoPanel:checkVisibility() and settings:getInt("scene.viewMode") == ViewMode.CROSS_SECTION_XRAY then
        XrayInfoPanel:toggle()
    else
        settings:setInt("scene.viewMode", ViewMode.CROSS_SECTION_XRAY)
        settings:setBool("scene.showModules", true)
        XrayInfoPanel:open()
    end
    XrayCutawayLocked:updateVisibility()
    self:updateButtonColors()
end

function XrayMenu:onArmorButton()
    if XrayInfoPanel:checkVisibility() and settings:getInt("scene.viewMode") == ViewMode.ARMOR and not settings:getBool("scene.showModules") then
        XrayInfoPanel:toggle()
    else
        settings:setInt("scene.viewMode", ViewMode.ARMOR)
        settings:setBool("scene.showModules", false)
        XrayInfoPanel:open()
    end
    self:updateButtonColors()
end

function XrayMenu:onModelButton()
    if XrayTextures:checkVisibility() and settings:getInt("scene.viewMode") == ViewMode.WHITE then
        XrayTextures:toggle()
    else
        settings:setInt("scene.viewMode", ViewMode.WHITE)
        XrayTextures:open()
    end
    self:updateButtonColors()
end

function XrayMenu:onHDModelButton()
    if XrayTextures:checkVisibility() and settings:getInt("scene.viewMode") == ViewMode.TEXTURED then
        XrayTextures:toggle()
    else
        settings:setInt("scene.viewMode", ViewMode.TEXTURED)
        XrayTextures:open()
    end
    self:updateButtonColors()
end

        </script>
	</head>
	<body id="xray_menu" template="menu" style="top:42dp" onload="XrayMenu:new{document = document}">
        <button id="specs_button" class="bg-content text-secondary p-0_5 rounded-tr" onclick="XraySpecs:toggle() XrayMenu:updateButtonColors()">
            <template src="button_icon">
                <div class="w-8 flex flex-col truncate">
                    <p class="text-xs">UI_icon_specs</p>
                    <svg src="/rml/icons/Specs-Stats-1.svg" class="w-8 flex-none" />
                </div>
            </template>
        </button>
        <button id="stats_button" class="bg-content text-secondary p-0_5" onclick="XrayMenu:onStatsButton()">
            <template src="button_icon">
                <div class="w-8 flex flex-col truncate">
                    <p class="text-xs">UI_icon_stats</p>
                    <svg src="/rml/icons/Specs-TankStats-.svg" class="w-8 flex-none" />
                </div>
            </template>
        </button>
        <button id="modules_button" class="bg-content text-secondary p-0_5" onclick="XrayMenu:onModulesButton()">
            <template src="button_icon">
                <div class="w-8 flex flex-col truncate">
                    <p class="text-xs">UI_icon_modules</p>
                    <svg src="/rml/icons/Modules-.svg" class="w-8 flex-none" />
                </div>
            </template>
        </button>
        <button id="crosssection_button" class="bg-content text-secondary p-0_5" onclick="XrayMenu:onCrossSectionButton()">
            <template src="button_icon">
                <div class="w-8 flex flex-col truncate">
                    <p class="text-xs">UI_icon_crosssection</p>
                    <svg src="/rml/icons/Tank-View-Cutaway-Vertical.svg" class="w-8 flex-none" />
                </div>
            </template>
        </button>
        <button id="armor_button" class="bg-content text-secondary p-0_5" onclick="XrayMenu:onArmorButton()">
            <template src="button_icon">
                <div class="w-8 flex flex-col truncate">
                    <p class="text-xs">UI_icon_armor</p>
                    <svg src="/rml/icons/Tank-Armor-HitBox.svg" class="w-8 flex-none" />
                </div>
            </template>
        </button>
        <button id="model_button" class="bg-content text-secondary p-0_5" onclick="XrayMenu:onModelButton()">
            <template src="button_icon">
                <div class="w-8 flex flex-col truncate">
                    <p class="text-xs">UI_icon_model</p>
                    <svg src="/rml/icons/Tank-ViewRight-1.svg" class="w-8 flex-none" />
                </div>
            </template>
        </button>
        <button id="hdmodel_button" class="bg-content text-secondary p-0_5" onclick="XrayMenu:onHDModelButton()">
            <template src="button_icon">
                <div class="w-8 flex flex-col truncate">
                    <p class="text-xs">UI_icon_hdmodel</p>
                    <svg src="/rml/icons/Tank-resolution-HD-.svg" class="w-8 flex-none" />
                </div>
            </template>
        </button>
        <button class="bg-content text-secondary p-0_5 rounded-br" onclick="RootMenu:open(true)">
            <template src="button_icon">
                <div class="w-8 flex flex-col truncate h-8 justify-between">
                    <p class="text-xs">UI_icon_back</p>
                    <svg src="/rml/icons/UI-Arrow-Right.svg" class="w-3 mb-1 flex-none self-center" crop-to-content="1" />
                </div>
            </template>
        </button>
    </body>
</rml>