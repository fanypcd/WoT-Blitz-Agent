<rml>
    <head>
        <title>About Tab</title>
        <link type="text/template" href="/rml/templates/info_panel.rml" />
        <link type="text/template" href="/rml/templates/button.rml" />
        <script>
AboutTab = {}
AboutTab.__index = AboutTab

function AboutTab:new(o)
    setmetatable(self, {__index = InfoPanel})

    local obj = InfoPanel:new(o)
    setmetatable(obj, self)

    obj:setMainTitle("UI_about_title")
    obj:setSecondTitle("UI_title_options")

    obj.elements = {}
    
    local element_ids = {
        "about_text"
    }

    for _, id in ipairs(element_ids) do
        obj.elements[id] = obj.document:GetElementById(id)
    end

    AboutTab = obj
    
    obj.elements["about_text"].inner_rml = fmt("UI_about_text", game.version)
    
    -- connect signals
    
    -- sync ui
    return obj
end

        </script>
    </head>
    <body id="about_tab" template="info_panel" onload="AboutTab:new{document = document}">
        <div class="text-xs">
            <p id="about_text">UI_about_text</p>
        </div>
    </body>
</rml>