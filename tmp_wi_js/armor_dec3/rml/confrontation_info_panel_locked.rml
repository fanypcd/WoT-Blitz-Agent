<rml>
    <head>
        <title>Confrontation Info Panel</title>
        <link type="text/template" href="/rml/templates/info_panel.rml" />
        <link type="text/template" href="/rml/templates/button.rml" />
        <script>
ConfrontationInfoPanelLocked = {}

local function onViewModeChanged()
    local self = ConfrontationInfoPanelLocked
    self:updateVisibility()
end

local function onTargetVehicleChanged(old_vehicle, vehicle, vehicle_info)
    local self = ConfrontationInfoPanelLocked
    self:updateVisibility()
end
    
function ConfrontationInfoPanelLocked:new(o)
    self.__index = self
    setmetatable(self, {__index = InfoPanel})

    local obj = InfoPanel:new(o)
    setmetatable(obj, self)

    obj:setMainTitle("UI_title_locked")
    obj:setSecondTitle("UI_title_confrontation")

    obj.document:GetElementById("header"):SetClass("text-premium", true)
    
    ConfrontationInfoPanelLocked = obj
    
    -- connect signals
    runOnChange(onViewModeChanged, "scene.viewMode")
    arena_service:connect_targetVehicleChangedSignal(onTargetVehicleChanged)

    -- sync ui
    onTargetVehicleChanged(nil, arena_service.target_vehicle, arena_service.target_vehicle_info)
    return obj
end

function ConfrontationInfoPanelLocked:checkVisibility()
    local view_mode = settings:getInt("scene.viewMode")
    local target_locked = arena_service.target_vehicle_info and account_service:isVehicleLocked(arena_service.target_vehicle_info.shared, false)
    return view_mode == ViewMode.PENETRATION and target_locked
end

function ConfrontationInfoPanelLocked:tryLowTier()
    local target_locked = arena_service.target_vehicle_info and account_service:isVehicleLocked(arena_service.target_vehicle_info.shared, false)
    if target_locked then
        local descr = WOTVehicleDescriptor.new(0x0f21)
        arena_service:setTarget(descr)
    end
end
        </script>
    </head>
    <body id="confrontation_info_panel_locked" template="info_panel" onload="ConfrontationInfoPanelLocked:new{document = document}">
        <div class="text-xs">
            <p>UI_paid_content_descr_confrontation</p>
            <button class="mt-3 w-full flex bg-secondary-outline text-secondary rounded" onclick="ConfrontationInfoPanelLocked:tryLowTier()">
                <template src="button">
                    <svg src="/rml/icons/UI-smiley-.svg" class="w-8 flex-none" />
                    <p>UI_try_low_tier</p>
                </template>
            </button>
            <button class="mt-1 w-full flex bg-premium text-primary-foreground rounded" onclick="ui_service:navigateToPurchase(IAPService.CONFRONTATION_MODE)">
                <template src="button">
                    <svg src="/rml/icons/Shop-.svg" class="w-8 flex-none" />
                    <p>UI_visit_purchases</p>
                </template>
            </button>
        </div>
    </body>
</rml>