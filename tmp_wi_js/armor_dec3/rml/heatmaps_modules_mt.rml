<rml>
    <head>
        <title>Heatmaps Modules MT</title>
        <link type="text/template" href="/rml/templates/info_panel.rml" />
        <link type="text/template" href="/rml/templates/button_icon.rml" />
        <script>
HeatmapsModulesMTPanel = {}

local function onCheckVisibility()
    local self = HeatmapsModulesMTPanel
    self:updateVisibility()
end

local function onHeatmapUpdated()
    local self = HeatmapsModulesMTPanel
    self:updateData()
end

local function onHeatmapTypeChanged()
    local self = HeatmapsModulesMTPanel
    local heatmap_type = settings:getInt("scene.heatmapType")
    
    self.elements["row_ammorack"]:SetClass("border-secondary", heatmap_type == HeatmapType.HEATMAP_MODULES)
    self.elements["row_fire"]:SetClass("border-secondary", heatmap_type == HeatmapType.HEATMAP_FIRE)
end

local function onTargetVehicleChanged(old_vehicle, vehicle, vehicle_info)
    local self = HeatmapsModulesMTPanel
    self:updateVisibility()
end

function HeatmapsModulesMTPanel._onAmmorackClick()
    local module_id = PlatformDB.DeviceType.AMMO_BAY
    settings:setInt("scene.heatmapType", HeatmapType.HEATMAP_MODULES)
    settings:setInt("scene.heatmapModule", module_id)
   
    local shots_heatmap = scene_service.shots_heatmap
    local module_point = ShotsHeatmap.Point.new()

    shots_heatmap:getAveragePoint(ShotsHeatmap.TextureType.MODULES_START + module_id, module_point)
    
    if not module_point.direction.is_empty then
        local camera_yaw, camera_pitch, turret_yaw, gun_pitch = shots_heatmap:getMaxDamageAngles(1 << (ShotsHeatmap.TextureType.MODULES_START + module_id))
        scene_service.camera_controller:setupCamera(camera_pitch, camera_yaw)
        scene_service:resetIdealTargetGunAngles(Vector2.new(math.deg(turret_yaw), math.deg(gun_pitch)))
    end
end

function HeatmapsModulesMTPanel._onFireClick()
    settings:setInt("scene.heatmapType", HeatmapType.HEATMAP_FIRE)
   
    local shots_heatmap = scene_service.shots_heatmap
    local module_point = ShotsHeatmap.Point.new()

    shots_heatmap:getAveragePoint(ShotsHeatmap.TextureType.EVENT_FIRE, module_point)
    
    if not module_point.direction.is_empty then
        local camera_yaw, camera_pitch, turret_yaw, gun_pitch = shots_heatmap:getMaxDamageAngles(1 << (ShotsHeatmap.TextureType.EVENT_FIRE))
        scene_service.camera_controller:setupCamera(camera_pitch, camera_yaw)
        scene_service:resetIdealTargetGunAngles(Vector2.new(math.deg(turret_yaw), math.deg(gun_pitch)))
    end
end
    
function HeatmapsModulesMTPanel:new(o)
    self.__index = self
    setmetatable(self, {__index = InfoPanel})

    local obj = InfoPanel:new(o)
    setmetatable(obj, self)

    obj:setMainTitle("UI_title_heatmap_modules")
    obj:setSecondTitle(fmt("UI_title_heatmaps") .. '<span class="text-black bg-beta px-1 ml-1">' .. fmt("UI_beta_badge") .. '</span>')

    obj.elements = {}
    
    local label_ids = {
        "row_ammorack", "row_fire", "chance_to_crit", "total_shots", "total_crits",
        "ammorack_chance", "fire_chance"
    }
    
    for _, id in ipairs(label_ids) do
        obj.elements[id] = obj.document:GetElementById(id)
    end
    
    HeatmapsModulesMTPanel = obj
    
    -- connect signals
    runOnChange(onCheckVisibility, "scene.viewMode", "scene.heatmapType", "db.platformCode")
    runOnChange(onHeatmapTypeChanged, "scene.heatmapType")
    scene_service.shots_heatmap:connect_heatmapUpdatedSignal(onHeatmapUpdated)
    arena_service:connect_targetVehicleChangedSignal(onTargetVehicleChanged)

    -- sync ui
    onTargetVehicleChanged(nil, arena_service.target_vehicle, arena_service.target_vehicle_info)
    return obj
end

function HeatmapsModulesMTPanel:checkVisibility()
    local view_mode = settings:getInt("scene.viewMode")
    local heatmap_type = settings:getInt("scene.heatmapType")
    local target_locked = arena_service.target_vehicle_info and account_service:isVehicleLocked(arena_service.target_vehicle_info.shared, false)
    local platform = db_service.platform
    return false -- view_mode == ViewMode.HEATMAP and not target_locked and platform and (platform.game_code == "mirtankov" or platform.game_code == "mtmod") and (heatmap_type == HeatmapType.HEATMAP_MODULES or heatmap_type == HeatmapType.HEATMAP_FIRE)
end

function HeatmapsModulesMTPanel:updateData()
    if not self:checkVisibility() then
        return
    end
    
    local shots_heatmap = scene_service.shots_heatmap
    local target_stats = shots_heatmap.target_stats

    local total_damage_shots = target_stats and target_stats.damage_per_type[ShotsHeatmap.TextureType.MODULES_START + 1].shots or 0
    local total_module_crits = 0

    local module_id = PlatformDB.DeviceType.AMMO_BAY
    local module_row = self.elements["row_ammorack"]
    if module_row then
        local module_shots = target_stats and target_stats.damage_per_type[ShotsHeatmap.TextureType.MODULES_START + 1 + module_id].weight or 0
        total_module_crits = total_module_crits + module_shots
            
        self.elements["ammorack_chance"].inner_rml = total_damage_shots > 0 and fmt("UI_percent_format", fmt("{:.2Lf}", module_shots / total_damage_shots * 100)) or "--"
    end

    module_row = self.elements["row_fire"]
    if module_row then
        local module_shots = target_stats and target_stats.damage_per_type[ShotsHeatmap.TextureType.EVENT_FIRE + 1].shots or 0
        total_module_crits = total_module_crits + module_shots
            
        self.elements["fire_chance"].inner_rml = total_damage_shots > 0 and fmt("UI_percent_format", fmt("{:.2Lf}", module_shots / total_damage_shots * 100)) or "--"
    end

    self.elements["total_shots"].inner_rml = fmt("{:.0Lf}", total_damage_shots)
    self.elements["total_crits"].inner_rml = fmt("{:.0Lf}", total_module_crits)
    self.elements["chance_to_crit"].inner_rml = total_damage_shots > 0 and fmt("UI_percent_format", fmt("{:.2Lf}", total_module_crits / total_damage_shots * 100)) or "--"
end
        </script>
    </head>
    <body id="heatmaps_modules_mt_panel" template="info_panel" onload="HeatmapsModulesMTPanel:new{document = document}">
        <div class="text-xs">
            <div class="flex justify-between items-end">
                <div>
                    <p class="font-bold">UI_statistics</p>
                    <p>UI_crit_chance</p>
                </div>
                <p id="chance_to_crit" class="text-xl font-light leading-none">100</p>
            </div>
            <div class="flex justify-between items-end">
                <p>UI_total_shots</p>
                <p id="total_shots">100</p>
            </div>
            <div class="flex justify-between items-end">
                <p>UI_total_ammoracks_and_fires</p>
                <p id="total_crits">100</p>
            </div>

            <div class="flex justify-between font-bold mt-3">
                <p>UI_internal_modules_legend</p>
                <p>UI_crit_chance</p>
            </div>
            <div id="row_ammorack" class="flex justify-between items-end p-0_5 border border-transparent" onclick="HeatmapsModulesMTPanel._onAmmorackClick()">
                <div class="flex gap-1 items-center">
                    <svg src="/rml/icons/Event-ammorack.svg" class="w-8"/>
                    <p>UI_module_ammo_bay</p>
                </div>
                <p id="ammorack_chance"></p>
            </div>
            <div id="row_fire" class="flex justify-between items-end p-0_5 border border-transparent" onclick="HeatmapsModulesMTPanel._onFireClick()">
                <div class="flex gap-1 items-center">
                    <svg src="/rml/icons/Event-critical-Fire-1.svg" class="w-8"/>
                    <p>UI_fire_event</p>
                </div>
                <p id="fire_chance"></p>
            </div>
        </div>
    </body>
</rml>