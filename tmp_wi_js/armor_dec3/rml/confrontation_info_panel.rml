<rml>
    <head>
        <title>Confrontation Info Panel</title>
        <link type="text/template" href="/rml/templates/info_panel.rml" />
        <link type="text/template" href="/rml/templates/button.rml" />
        <link type="text/template" href="/rml/templates/button_icon.rml" />
        <script>
local Params = require('rml.scripts.vehicle_params')
local utils = require('rml.scripts.utils')
local VA = VehicleAttributeId

ConfrontationInfoPanel = {}

local function onTargetVehicleChanged(old_vehicle, vehicle, vehicle_info)
    local self = ConfrontationInfoPanel
    local platform = vehicle_info and vehicle_info.shared and vehicle_info.shared.platform
    local target_name = platform and platform:getTextUTF8(vehicle_info.shared.localized_name) or "UI_not_set"

    self:setMainTitle("<span class='normal-case'>" .. target_name .. "</span>")
    self.elements["target"].inner_rml = target_name
end

local function distanceUpdate()
    local self = ConfrontationInfoPanel

    if self.throttle:shouldExecute() and self.player_specs then
        if arena_service.target_specs then
            local dispersion = Params.getItemValue(Params.ShotDispersionRadius, self.player_specs, true)
            if dispersion[1] ~= nil then
                dispersion[1] = dispersion[1] * 0.01 * settings:getFloat("scene.distance")
            end
            self.elements["dispersion"].inner_rml = Params.format(table.unpack(dispersion))
        end
    
        self:updatePiercingPowerLabel()
        self:updateData()
    end
end

local function onPlayerVehicleChanged(old_vehicle, vehicle, vehicle_info)
    local self = ConfrontationInfoPanel
    self.elements["shooter"].inner_rml = vehicle_info and vehicle_info.shared and vehicle_info.shared.platform:getTextUTF8(vehicle_info.shared.localized_name) or "UI_not_set"
    
    if vehicle_info then
        self.player_specs = arena_service.player_specs
        distanceUpdate()
    end
end

local function onArmorTraced(ray, points, bounding_box)
    local self = ConfrontationInfoPanel
    self.points = points
    self.ray = ray
    self.bounding_box = bounding_box

    -- Sibling deferred panels may not be constructed yet; treat missing as not visible.
    local help_visible = ConfrontationInfoPanelHelp and ConfrontationInfoPanelHelp.isVisible and ConfrontationInfoPanelHelp:isVisible()
    local shot_list_visible = ShotList and ShotList.isVisible and ShotList:isVisible()
    if #self.points == 0 or help_visible or not shot_list_visible then
        self:updateVisibility()
    end
    self:updateData()
end

local function onShellPropertiesChanged(properties)
    local self = ConfrontationInfoPanel
    
    self.elements["caliber"].inner_rml = fmt("UI_millimeters_format", fmt("{:g}", properties.shell.caliber))
    self.elements["ammo_type"].inner_rml = PlatformDB.getShellTypeName(properties.shell.kind)
    self.elements["damage_to_modules"].inner_rml = fmt("UI_hp_format", fmt("{:g}", properties.damage_devices))
    
    self:updatePiercingPowerLabel()
    
    local is_he = PlatformDB.isHEShell(properties.shell.kind)
    self.elements["summary_min_damage"].parent_node:SetClass("hidden", not is_he)

    self:updateData()
end

local function updateModulesElements()
    local self = ConfrontationInfoPanel
    
    local view_mode = settings:getInt("scene.viewMode")
    local show_modules = settings:getBool("scene.showModules")
    
    self.elements["modules"]:SetClass("hidden", not show_modules or view_mode == ViewMode.CROSS_SECTION)
    self.elements["pen_result"]:SetClass("hidden", show_modules or view_mode == ViewMode.CROSS_SECTION)
    self.elements["armor_details"]:SetClass("hidden", view_mode ~= ViewMode.CROSS_SECTION)
end

local function requestUpdate()
    local self = ConfrontationInfoPanel
    self:updateData()
end

local function gunAnglesUpdate()
    local self = ConfrontationInfoPanel
    
    if #self.points > 0 then
        self.points = {}
        self:updateVisibility()
    end
end

local function onHEDamageCalculated(he_min, he_max, he_avg)
    local self = ConfrontationInfoPanel
    self.he_damage_min = he_min
    self.he_damage_max = he_max
    self.he_damage_avg = he_avg
end

local function hasInternalsUpdate()
    local self = ConfrontationInfoPanel
    local has_internals = settings:getBool("arena.target.hasInternals")

    self.elements["no_modules"]:SetClass("hidden", has_internals)
    local platform = db_service.platform
    if platform then
        self.elements["no_modules_text"].inner_rml = fmt("UI_modules_no_information", (platform.game_code == "mirtankov" or platform.game_code == "tanksblitz" or platform.game_code == "mtmod") and "Lesta" or "Wargaming")
    end
end

function ConfrontationInfoPanel:updatePiercingPowerLabel()
    local distance = settings:getFloat("scene.distance")
    local piercing_power = arena_service.shell_properties:getEffectivePiercingPower(distance)
    self.elements["piercing_power"].inner_rml = fmt("UI_millimeters_format", fmt("{:.0Lf}", piercing_power))

    local internal_distance = self.internal_travel_distance or 0.0
    self.elements["damage"].inner_rml = fmt("UI_hp_format", fmt("{:.0Lf}", arena_service.shell_properties:getDamageArmorForDistance(internal_distance, distance)))
end

function ConfrontationInfoPanel:new(o)
    self.__index = self
    setmetatable(self, {__index = InfoPanel})

    local obj = InfoPanel:new(o)
    setmetatable(obj, self)

    obj:setSecondTitle("UI_title_confrontation")

    obj.elements = {}
    obj.points = {}
    obj.he_damage_min = 0.0
    obj.he_damage_max = 0.0
    obj.he_damage_avg = 0.0
    obj.armor_idx = 0
    obj.throttle = Throttle.new(0.1)
    obj.internal_travel_distance = 0.0
    
    local element_ids = {
        "summary_pen_chance", "summary_min_damage", "ammo_type", "caliber", "piercing_power", "effective_armor",
        "shot_result", "modules", "damage", "damage_to_modules", "modules_result", "shooter", "target", "dispersion",
        "shooter_pen_by", "shooter_total_dmg", "shooter_hitpoints", "shooter_result", "shooter_result_time",
        "target_pen_by", "target_total_dmg", "target_hitpoints", "target_result", "target_result_time",
        "armor_groups", "pen_result", "armor_details", "armor_plates", "module_details",
        "no_modules", "no_modules_text"
    }
    
    for _, id in ipairs(element_ids) do
        obj.elements[id] = obj.document:GetElementById(id)
    end
    
    ConfrontationInfoPanel = obj
    
    -- connect signals
    runOnChange(updateModulesElements, "scene.viewMode", "scene.showModules")
    runOnChange(requestUpdate, "scene.viewMode")
    runOnChange(distanceUpdate, "scene.distance")
    runOnChange(gunAnglesUpdate, "arena.target.gunAngles")
    runOnChange(hasInternalsUpdate, "arena.target.hasInternals")
    arena_service:connect_targetVehicleChangedSignal(onTargetVehicleChanged)
    arena_service:connect_playerVehicleChangedSignal(onPlayerVehicleChanged)
    scene_service:connect_armorTracedSignal(onArmorTraced)
    scene_service:connect_damageHECalculatedSignal(onHEDamageCalculated)
    arena_service:connect_shellPropertiesChangedSignal(onShellPropertiesChanged)
    
    -- sync ui
    onTargetVehicleChanged(nil, arena_service.target_vehicle, arena_service.target_vehicle_info)
    onPlayerVehicleChanged(nil, arena_service.player_vehicle, arena_service.player_vehicle_info)
    onShellPropertiesChanged(arena_service.shell_properties)

    -- Shot may have been placed before this deferred panel connected to armorTracedSignal.
    scene_service:retraceLastShot()
    return obj
end

-- function ConfrontationInfoPanel:open()
-- end

function ConfrontationInfoPanel:checkVisibility()
    local view_mode = settings:getInt("scene.viewMode")
    local target_locked = arena_service.target_vehicle_info and account_service:isVehicleLocked(arena_service.target_vehicle_info.shared, false)
    return (view_mode == ViewMode.PENETRATION or view_mode == ViewMode.CROSS_SECTION) and not target_locked and #self.points > 0
end

function ConfrontationInfoPanel:addFarModuleEntry(device_type, device_name)
    local module_name_template = [[
        <svg src="/rml/icons/Modules-Ammorack-.svg" class="w-4 flex-none icon" style="image-color:#b0b0b0" />
        <p class="flex-1 label">ammorack</p>
        <p class="flex-none">UI_too_far_away</p>
    ]]

    local module_name_element = self.elements["modules_result"]:AppendChild(self.document:CreateElement("div"))
    module_name_element.inner_rml = module_name_template
    module_name_element:SetClass("flex", true)
    module_name_element:SetClass("gap-1", true)
    module_name_element:SetClass("items-center", true)
    module_name_element.style.color = "#b0b0b0"

    local icon = module_name_element:QuerySelector(".icon")
    icon:SetAttribute("src", "/rml/icons/" .. utils.getModuleIcon(device_type))
    
    local module_name = module_name_element:QuerySelector(".label")
    module_name.inner_rml = device_name
end

function ConfrontationInfoPanel:addDetailsRow(container, idx, label, value, icon, color)
    local template = [[
        <p class="idx w-6"></p>
        <svg class="w-4 flex-none mr-1" />
        <p class="label flex-1"></p>
        <p class="value"></p>
    ]]
    
    local row_element = container:AppendChild(self.document:CreateElement("div"))
    row_element.inner_rml = template
    row_element:SetClass("flex", true)
    row_element:SetClass("items-center", true)
    row_element.style.color = color
    
    local icon_element = row_element:QuerySelector("svg")
    icon_element.style["image-color"] = color
    icon_element:SetAttribute("src", "/rml/icons/" .. icon)
    
    row_element:QuerySelector(".label").inner_rml = label;
    row_element:QuerySelector(".value").inner_rml = value;
    
    if idx then
        row_element:QuerySelector(".idx").inner_rml = idx;
    end
end

function ConfrontationInfoPanel:addModuleRow(container, label, chance1, chance2, show_crit)
    local module_row_template = [[
        <div class="w-4 flex-none" />
        <p class="flex-1 label">ammorack</p>
        <div class="w-8 flex-none" />
        <p class="w-8 flex-none damage text-right" style="color:orange"></p>
        <p class="w-8 flex-none crit text-right" style="color:red"></p>
    ]]

    local module_row_element = container:AppendChild(self.document:CreateElement("div"))
    module_row_element.inner_rml = module_row_template
    module_row_element:SetClass("flex", true)
    module_row_element:SetClass("gap-1", true)
    module_row_element:SetClass("items-center", true)
    
    module_row_element:QuerySelector(".label").inner_rml = label
    module_row_element:QuerySelector(".damage").inner_rml = chance1
    module_row_element:QuerySelector(".crit").inner_rml = chance2
    module_row_element:QuerySelector(".crit"):SetClass("hidden", not show_crit)
end

function ConfrontationInfoPanel:addModuleDamageEntry(
                        device_type, 
                        crit_chance1, 
                        crit_chance2, 
                        crit_chance3,
                        destroy_chance1, 
                        destroy_chance2, 
                        destroy_chance3, 
                        device_name, 
                        show_crit,
                        crit_health, 
                        destroy_health, 
                        device_hit_chance1
                    )
                    
    local module_info = self.elements["modules_result"]:AppendChild(self.document:CreateElement("div"))
                    
    local module_name_template = [[
        <svg src="/rml/icons/Modules-Ammorack-.svg" class="w-4 flex-none icon" />
        <p class="flex-1">ammorack</p>
        <svg src="/rml/icons/UI-heart-.svg" class="w-4 flex-none" style="image-color:lime" />
        <svg src="/rml/icons/UI-heartbreak-.svg" class="w-4 flex-none pl-4" style="image-color:orange" />
        <svg src="/rml/icons/UI-heart-.svg" class="w-4 flex-none pl-4 crit" style="image-color:red" />
    ]]

    local module_name_element = module_info:AppendChild(self.document:CreateElement("div"))
    module_name_element.inner_rml = module_name_template
    module_name_element:SetClass("flex", true)
    module_name_element:SetClass("gap-1", true)
    module_name_element:SetClass("items-center", true)

    local icon_path = utils.getModuleIcon(device_type)
    local icon = module_name_element:QuerySelector(".icon")
    icon:SetAttribute("src", "/rml/icons/" .. icon_path)
    
    local module_color = ui_service.palette:getModuleColor(device_type)
    icon.style["image-color"] = module_color
    
    local module_name = module_name_element:QuerySelector("p")
    module_name.inner_rml = device_name
    module_name.style.color = module_color
    
    module_name_element:QuerySelector(".crit"):SetClass("hidden", not show_crit)
    
    local chance1 = fmt("UI_percent_format", fmt("{:.0Lf}", crit_chance1 * 100.0))
    
    self:addModuleRow(module_info, "UI_damage", ">" .. fmt("UI_hp_format", fmt("{:.0Lf}", crit_health)), ">" .. fmt("UI_hp_format", fmt("{:.0Lf}", destroy_health)), show_crit)
    self:addModuleRow(module_info, "UI_1st_shot", chance1, fmt("UI_percent_format", fmt("{:.0Lf}", destroy_chance1 * 100.0)), show_crit)
    self:addModuleRow(module_info, "UI_2nd_shot", fmt("UI_percent_format", fmt("{:.0Lf}", crit_chance2 * 100.0)), fmt("UI_percent_format", fmt("{:.0Lf}", destroy_chance2 * 100.0)), show_crit)
    self:addModuleRow(module_info, "UI_3rd_shot", fmt("UI_percent_format", fmt("{:.0Lf}", crit_chance3 * 100.0)), fmt("UI_percent_format", fmt("{:.0Lf}", destroy_chance3 * 100.0)), show_crit)

    self:addDetailsRow(self.elements["module_details"], nil, device_name, chance1, utils.getModuleIcon(device_type), module_color)
end

function ConfrontationInfoPanel:addArmorGroupsRow(label, value)
    local template = [[
        <p class="label flex-1"></p>
        <p class="value"></p>
    ]]
    
    local row_element = self.elements["armor_groups"]:AppendChild(self.document:CreateElement("div"))
    row_element.inner_rml = template
    row_element:SetClass("flex", true)
    row_element:SetClass("gap-1", true)
    
    row_element:QuerySelector(".label").inner_rml = label
    row_element:QuerySelector(".value").inner_rml = value
end

function ConfrontationInfoPanel:addPenetrationResultEntry(
                impact_angle, 
                normalization_angle, 
                armor, 
                full_armor, 
                piercing_loss_min, 
                piercing_loss_max, 
                hit_distance, 
                ricochet, 
                device_name, 
                material
            )
            
    local icon
    if not ricochet then
        local armor_text = fmt("UI_millimeters_format", fmt("{:g}", armor))
        if material.use_hit_angle then
            local angle_text = fmt("UI_degrees_format", fmt("{:.0Lf}", impact_angle)) .. "/" .. fmt("UI_degrees_format", fmt("{:.0Lf}", normalization_angle))
            self:addArmorGroupsRow("UI_pen_impact_angle", angle_text)
        end
        
        if material.use_hit_angle then
            armor_text = armor_text .. "/" .. fmt("UI_millimeters_format", fmt("{:.0Lf}", full_armor))
        end
        
        self:addArmorGroupsRow(device_name, armor_text)
        
        if material.device_type == PlatformDB.DeviceType.ARMOR then
            icon = material.vehicle_damage_factor > 0 and "Specs-ArmorPrimary.svg" or "Specs-ArmorSpace.svg"
        else
            icon = utils.getModuleIcon(material.device_type)
        end
    else
        self:addArmorGroupsRow("UI_pen_ricochet", fmt("UI_degrees_format", fmt("{:.0Lf}", impact_angle)))
        icon = "Events-Armor-ricochetYES-.svg"
    end
    
    if piercing_loss_min > 0.0 or piercing_loss_max > 0.0 then
        self:addArmorGroupsRow("UI_pen_piercing_power_loss", fmt("UI_millimeters_range_format", piercing_loss_min, piercing_loss_max))
    end

    -- details
    local details_container = self.elements["armor_plates"]
    
    self.armor_idx = self.armor_idx + 1
    self:addDetailsRow(details_container, fmt("{}", self.armor_idx), device_name, "", icon, "white")
    
    local color = ui_service.palette:getArmorColor(arena_service.target_vehicle_info and arena_service.target_vehicle_info.shared or nil, material)

    self:addDetailsRow(details_container, nil, "UI_thickness", fmt("UI_millimeters_format", fmt("{:Lg}", armor)), "Specs-Armor-ThicknessNominal-.svg", color)
    if material.use_hit_angle then
        self:addDetailsRow(details_container, nil, "UI_pen_impact_angle", fmt("UI_degrees_format", fmt("{:.0Lf}", impact_angle)), "Specs-Armor-ImpactAngle-.svg", color)
    end
    
    if ricochet then
        self:addDetailsRow(details_container, nil, "UI_pen_ricochet", "", "Events-Armor-ricochetYES-.svg", color)
    else
        if material.use_hit_angle then
            self:addDetailsRow(details_container, nil, "UI_pen_normalization_angle", fmt("UI_degrees_format", fmt("{:.0Lf}", normalization_angle)), "Specs-Armor-ImpactAngle-.svg", color)
        end
        self:addDetailsRow(details_container, nil, "UI_pen_effective_armor", fmt("UI_millimeters_format", fmt("{:.1Lf}", full_armor)), "Specs-Armor-ThicknessEffective-.svg", color)
    end

    if piercing_loss_min > 0.0 or piercing_loss_max > 0.0 then
        self:addDetailsRow(details_container, nil, "UI_pen_piercing_power_loss", fmt("UI_millimeters_range_format", piercing_loss_min, piercing_loss_max), "Event-Penetration-3.svg", color)
    end
end

function ConfrontationInfoPanel:updateData()
    if not self:checkVisibility() then
        return
    end
    
    self.elements["modules_result"].inner_rml = ""
    self.elements["armor_groups"].inner_rml = ""
    self.elements["module_details"].inner_rml = ""
    self.elements["armor_plates"].inner_rml = ""
    self.armor_idx = 0
    
    local target_info = arena_service.target_vehicle_info
    if not target_info then
        return
    end
    
    local platform = target_info.shared.platform
    
    local shell = arena_service.shell_properties
    local is_he = PlatformDB.isHEShell(shell.shell.kind)
    local player_specs = arena_service.player_specs
    
    local distance = settings:getFloat("scene.distance")
    local damage_armor = shell:getDamageArmorForDistance(0.0, distance)
    local damage_devices = shell.damage_devices
    local damage_lower = player_specs and Params.getItemValue(Params.DamageLowerBoundFactor, player_specs, true)[1] or (1.0 - platform.damage_distribution)
    local damage_upper = player_specs and Params.getItemValue(Params.DamageUpperBoundFactor, player_specs, true)[1] or (1.0 + platform.damage_distribution)
    local damage_devices_min = damage_devices * damage_lower
    local damage_devices_avg = damage_devices
    local damage_devices_max = damage_devices * damage_upper
    local device_piercing_chance = 1.0
    local impact_angle = 0.0
  
    local shot_visitor = ShotResultVisitor.new()

    -- Visit armor callback
    shot_visitor.visit_armor = function(p)
        impact_angle = math.max(0.0, math.deg(math.acos(p.cos_angle)))
    end

    -- Visit point post callback
    local effective_values = settings:getInt("ui.specsEffectiveValues")
    shot_visitor.visit_point_post = function(p, normalization_angle, full_armor, piercing_loss_min, piercing_loss_max, hit_distance)
        local device_name = ""
        local device_health = 0.0
        local device_health_regen = 0.0

        if p.material.device_type == PlatformDB.DeviceType.ARMOR then
            if p.material.vehicle_damage_factor > 0 then
                device_name = fmt("UI_primary_armor")
            else
                device_name = fmt("UI_spaced_armor")
            end
        else
            local device_health, device_health_regen = Params.getModuleHealth(p.material.device_type, arena_service.target_specs, effective_values)
            
            device_name = PlatformDB.getModuleName(p.material.device_type)

            local distance = p.distance - shot_visitor.penetration_hit_distance
            local max_distance = math.max(0.5, 0.01 * shell.shell.caliber)

            if shot_visitor.vehicle_damaged and distance > max_distance then
                self:addFarModuleEntry(p.material.device_type, device_name)
            elseif not shot_visitor.vehicle_damaged or distance < max_distance then
                local crit_health = device_health - device_health_regen
                local destroy_health = device_health

                local is_crew = PlatformDB.isCrew(p.material.device_type)
                if is_crew then
                    destroy_health = 1.0
                    crit_health = 1.0
                end

                local dmin, davg, dmax

                if p.material.device_type ~= PlatformDB.DeviceType.TRACK then
                    dmin = damage_devices_min
                    davg = damage_devices_avg
                    dmax = damage_devices_max
                else
                    -- Assuming _collision_model_bbox is available
                    
                    local point_z = (self.ray.origin + self.ray.direction * p.distance).z
                    local middle_of_tracks = 0.5 * (self.bounding_box.max.z + self.bounding_box.min.z)
                    local tracks_size = self.bounding_box.max.z - self.bounding_box.min.z
                    local damage_factor = math.abs(point_z - middle_of_tracks) < tracks_size * 0.333 and 0.333 or 1.0

                    if shell.shell.kind == PlatformDB.ShellType.ARMOR_PIERCING_FSDS then
                        dmin = damage_armor * damage_factor
                        davg = damage_armor * damage_factor
                        dmax = damage_armor * damage_factor
                    else
                        dmin = damage_armor * damage_lower * damage_factor
                        davg = damage_armor * damage_factor
                        dmax = damage_armor * damage_upper * damage_factor
                    end
                end

                device_piercing_chance = device_piercing_chance * Params.getEffectiveChanceToHit(p.material, arena_service.target_specs, effective_values)
                local device_penetration_chance = device_piercing_chance * shot_visitor.piercing_chance * 
                    (p.material.armor > 0.0 and platform:getPiercingChance(0.0, shot_visitor.piercing_min, shot_visitor.piercing_max) or 1.0)
            
                local device_hit_chance = math.min(1.0, math.max(0.0, 1.0 - (0.0 - dmin) / (dmax - dmin)))
                local device_crit_hpchance = math.min(1.0, math.max(0.0, 1.0 - (crit_health - dmin) / (dmax - dmin)))
                local device_crit_hpchance2 = math.min(1.0, math.max(0.0, 1.0 - (crit_health - davg - dmin) / (dmax - dmin)))
                local device_crit_hpchance3 = math.min(1.0, math.max(0.0, 1.0 - (crit_health - 2.0 * davg - dmin) / (dmax - dmin)))
                local device_destroy_hpchance = math.min(1.0, math.max(0.0, 1.0 - (destroy_health - dmin) / (dmax - dmin)))
                local device_destroy_hpchance2 = math.min(1.0, math.max(0.0, 1.0 - (destroy_health - davg - dmin) / (dmax - dmin)))
                local device_destroy_hpchance3 = math.min(1.0, math.max(0.0, 1.0 - (destroy_health - 2.0 * davg - dmin) / (dmax - dmin)))

                local device_hit_chance1 = device_penetration_chance * device_hit_chance
                -- local device_hit_chance2 = 1.0 - (1.0 - device_hit_chance1) * (1.0 - device_hit_chance1)
                -- local device_hit_chance3 = 1.0 - (1.0 - device_hit_chance1) * (1.0 - device_hit_chance1) * (1.0 - device_hit_chance1)

                local device_crit_chance1 = device_penetration_chance * device_crit_hpchance
                local device_crit_chance2 = device_crit_chance1 + device_penetration_chance * 
                    (
                        (1.0 - device_penetration_chance) * device_crit_hpchance + 
                        device_penetration_chance * (1.0 - device_crit_hpchance) * device_crit_hpchance2
                    )
                local device_crit_chance3 = device_crit_chance2 + device_penetration_chance * 
                    (
                        (1.0 - device_penetration_chance) * (1.0 - device_penetration_chance) * device_crit_hpchance +
                        2.0 * device_penetration_chance * (1.0 - device_penetration_chance) * (1.0 - device_crit_hpchance) * device_crit_hpchance2 +
                        device_penetration_chance * device_penetration_chance * (1.0 - device_crit_hpchance) * (1.0 - device_crit_hpchance2) * device_crit_hpchance3
                    )

                local device_destroy_chance1 = device_penetration_chance * device_destroy_hpchance
                local device_destroy_chance2 = device_destroy_chance1 + device_penetration_chance * 
                    (
                        (1.0 - device_penetration_chance) * device_destroy_hpchance + 
                        device_penetration_chance * (1.0 - device_destroy_hpchance) * device_destroy_hpchance2
                    )
                local device_destroy_chance3 = device_destroy_chance2 + device_penetration_chance * 
                    (
                        (1.0 - device_penetration_chance) * (1.0 - device_penetration_chance) * device_destroy_hpchance +
                        2.0 * device_penetration_chance * (1.0 - device_penetration_chance) * (1.0 - device_destroy_hpchance) * device_destroy_hpchance2 +
                        device_penetration_chance * device_penetration_chance * (1.0 - device_destroy_hpchance) * (1.0 - device_destroy_hpchance2) * device_destroy_hpchance3
                    )

                if p.material.device_type ~= PlatformDB.DeviceType.TRACK then
                    damage_devices_min = damage_devices_min - device_health
                    damage_devices_avg = damage_devices_avg - device_health
                    damage_devices_max = damage_devices_max - device_health
                end

                local show_hit = true  -- not is_crew and device_hit_chance1 > device_crit_chance1 and device_hit_chance1 < 0.95 and device_hit_chance3 > 0.05
                local show_crit = not is_crew  -- and device_crit_chance3 > 0.05 and device_crit_chance1 < 0.95 and device_crit_chance3 > 0.05
                local show_destroy = true  -- device_crit_chance1 > 0.05 or device_destroy_chance3 > 0.05

                if show_hit or show_crit or show_destroy then
                    self:addModuleDamageEntry(
                        p.material.device_type, 
                        device_crit_chance1, 
                        device_crit_chance2, 
                        device_crit_chance3,
                        device_destroy_chance1, 
                        device_destroy_chance2, 
                        device_destroy_chance3, 
                        device_name, 
                        show_crit,
                        crit_health, 
                        destroy_health, 
                        device_hit_chance1
                    )
                end
            end
        end

        if not shot_visitor.vehicle_damaged then
            self:addPenetrationResultEntry(
                impact_angle, 
                normalization_angle, 
                p.material.armor, 
                full_armor, 
                piercing_loss_min, 
                piercing_loss_max, 
                hit_distance, 
                p.ricochet, 
                device_name, 
                p.material
            )
        end
    end

    if #self.points > 0 then
        ShotResult.computeShotResult(
            Ray.new(),
            self.points, 
            shell, 
            arena_service.player_vehicle_info, 
            arena_service.target_vehicle.equipment_descriptor, 
            target_info,
            shot_visitor
        )

        self.internal_travel_distance = shot_visitor.internal_travel_distance or 0.0

        local internal_distance = self.internal_travel_distance or 0.0
        self.elements["damage"].inner_rml = fmt("UI_hp_format", fmt("{:.0Lf}", arena_service.shell_properties:getDamageArmorForDistance(internal_distance, distance)))
    end
    
    local pen_color = ui_service.palette:getPenetrationColor(shot_visitor.piercing_chance)
    self.elements["summary_pen_chance"].inner_rml = fmt("UI_percent_format", fmt("{:.1Lf}", shot_visitor.piercing_chance * 100.0))
    self.elements["summary_pen_chance"].style.color = pen_color
    
    if is_he then
        self.elements["shot_result"]:SetClass("hidden", true)
        self.elements["effective_armor"].inner_rml = fmt("UI_millimeters_format", fmt("{:.0Lf}", shot_visitor.effective_thickness))
    else
        if shot_visitor.ricochet then
            self.elements["shot_result"]:SetClass("hidden", false)
            self.elements["shot_result"].inner_rml = "UI_pen_ricochet"
            self.elements["effective_armor"].inner_rml = "--"
        elseif not shot_visitor.vehicle_damaged then
            self.elements["shot_result"]:SetClass("hidden", false)
            self.elements["shot_result"].inner_rml = "UI_primary_armor_not_hit"
            self.elements["effective_armor"].inner_rml = "--"
        else
            self.elements["shot_result"]:SetClass("hidden", true)
            self.elements["effective_armor"].inner_rml = fmt("UI_millimeters_format", fmt("{:.0Lf}", shot_visitor.effective_thickness))
        end
    end
    
    if not is_he or shot_visitor.piercing_chance >= 1.0 then
        self.elements["summary_min_damage"].inner_rml = fmt("UI_hp_format", fmt("{:.0Lf}", damage_armor * damage_lower))
    else
        self.elements["summary_min_damage"].inner_rml = fmt("UI_hp_format", fmt("{:.0Lf}", self.he_damage_min))
    end

    -- Update survivability
    local player_info = arena_service.player_vehicle_info
    local player_turret = player_info and player_info:getTurret(arena_service.player_vehicle.turret_id) or nil
    local player_gun_info = player_info and player_turret and player_info:getGun(player_turret, arena_service.player_vehicle.gun_id) or nil
    
    local target_turret = target_info:getTurret(arena_service.target_vehicle.turret_id)
    local target_gun_info = target_info:getGun(target_turret, arena_service.target_vehicle.gun_id)
    local target_shell_info_shared = target_gun_info and target_gun_info.shells[1].shared or nil

    if player_info and player_gun_info and target_gun_info and target_shell_info_shared and #self.points > 0 then
        local player_desc = arena_service.player_vehicle
        local target_desc = arena_service.target_vehicle
        local player_reload_time = player_info:getEffectiveAttribute(VA.VEHICLE_ATTR_RELOAD_TIME, player_desc)
        local player_clip_count = player_info:getEffectiveAttribute(VA.VEHICLE_ATTR_CLIP_COUNT, player_desc, 1)
        local player_clip_rate = player_info:getEffectiveAttribute(VA.VEHICLE_ATTR_CLIP_RATE, player_desc)
        local target_reload_time = target_info:getEffectiveAttribute(VA.VEHICLE_ATTR_RELOAD_TIME, target_desc)
        local target_clip_count = target_info:getEffectiveAttribute(VA.VEHICLE_ATTR_CLIP_COUNT, target_desc, 1)
        local target_clip_rate = target_info:getEffectiveAttribute(VA.VEHICLE_ATTR_CLIP_RATE, target_desc)
        local max_kill_time = 99.0
        local player_specs = arena_service.player_specs
        local target_specs = arena_service.target_specs
        local target_hitpoints = (target_specs and Params.getItemValue(Params.MaxHealth, target_specs, true)[1]) or target_info:calcHealth(target_desc)
        local player_hitpoints = (player_specs and Params.getItemValue(Params.MaxHealth, player_specs, true)[1]) or player_info:calcHealth(player_desc)
        local player_damage = damage_armor
        local player_damage_min = is_he and self.he_damage_avg or 0.0
        local player_damage_avg = player_damage * shot_visitor.piercing_chance + player_damage_min * (1.0 - shot_visitor.piercing_chance)
        local target_damage = (target_specs and Params.getItemValue(Params.DamageArmor, target_specs, true)[1]) or target_shell_info_shared.damage_armor
        local shot_count_to_kill_target = player_damage_avg > 0.0 and math.ceil(target_hitpoints / player_damage_avg) or 0.0
        local pen_count_to_kill_target = math.floor(shot_count_to_kill_target * (shot_visitor.piercing_chance + 0.01))
        
        local player_burst_time = player_clip_rate > 0.0 and 60.0 / player_clip_rate * (player_clip_count - 1) or 0.0
        local player_full_clips_needed = math.floor(shot_count_to_kill_target / player_clip_count)
        local player_remaining_shots = shot_count_to_kill_target - player_full_clips_needed * player_clip_count
    
        local time_to_kill_target = shot_count_to_kill_target > 0.0 and math.min(max_kill_time, 
            player_reload_time * math.max(0.0, player_full_clips_needed - 1.0) + 
            player_full_clips_needed * player_burst_time + 
            (player_clip_rate > 0.0 and 60.0 / player_clip_rate * math.max(0.0, player_remaining_shots - 1.0) or 0.0)
        ) or max_kill_time

        if player_remaining_shots > 0.0 and shot_count_to_kill_target > player_clip_count then
            time_to_kill_target = time_to_kill_target + player_reload_time
        end

        if time_to_kill_target >= max_kill_time then
            shot_count_to_kill_target = player_gun_info:getShotCountByTime(time_to_kill_target)[1]
            pen_count_to_kill_target = math.floor(shot_count_to_kill_target * (shot_visitor.piercing_chance + 0.01))
        end

        local player_effective_dmg = is_he and shot_count_to_kill_target * player_damage_avg or pen_count_to_kill_target * player_damage
        local pen_count_to_kill_player = target_gun_info:getShotCountByTime(time_to_kill_target)[1]
        local target_potential_dmg = pen_count_to_kill_player * target_damage
    
        if player_hitpoints < target_potential_dmg then
            pen_count_to_kill_player = math.ceil(player_hitpoints / target_damage)
        end

        local target_burst_time = target_clip_rate > 0.0 and 60.0 / target_clip_rate * (target_clip_count - 1) or 0.0
        local target_full_clips_needed = math.floor(pen_count_to_kill_player / target_clip_count)
        local target_remaining_shots = pen_count_to_kill_player - target_full_clips_needed * target_clip_count
    
        local time_to_kill_player = pen_count_to_kill_player > 0.0 and math.min(max_kill_time,
            target_reload_time * math.max(0.0, target_full_clips_needed - 1.0) +
            target_full_clips_needed * target_burst_time +
            (target_clip_rate > 0.0 and 60.0 / target_clip_rate * math.max(0.0, target_remaining_shots - 1.0) or 0.0)
        ) or max_kill_time

        if target_remaining_shots > 0.0 and pen_count_to_kill_player > target_clip_count then
            time_to_kill_player = time_to_kill_player + target_reload_time
        end

        if target_potential_dmg >= player_hitpoints then
            target_potential_dmg = pen_count_to_kill_player * target_damage
            shot_count_to_kill_target = player_gun_info:getShotCountByTime(time_to_kill_player)[1]
            pen_count_to_kill_target = math.floor(shot_count_to_kill_target * (shot_visitor.piercing_chance + 0.001))
            player_effective_dmg = is_he and shot_count_to_kill_target * player_damage_avg or pen_count_to_kill_target * player_damage
            time_to_kill_target = max_kill_time
        else
            time_to_kill_player = max_kill_time
        end

        if shot_visitor.piercing_chance <= 0.0 and not is_he then
            player_effective_dmg = 0.0
        end

        -- Update UI elements
        self.elements["shooter_hitpoints"].inner_rml = fmt("UI_hp_format", fmt("{:.0Lf}", player_hitpoints))
        self.elements["target_hitpoints"].inner_rml = fmt("UI_hp_format", fmt("{:.0Lf}", target_hitpoints))

        self.elements["target_total_dmg"].inner_rml = fmt("UI_hp_format", fmt("{:.0Lf}", player_effective_dmg))
        self.elements["shooter_total_dmg"].inner_rml = fmt("UI_hp_format", fmt("{:.0Lf}", target_potential_dmg))

        self.elements["target_pen_by"].inner_rml = fmt("UI_pen_by_format", pen_count_to_kill_target, shot_count_to_kill_target)
        self.elements["shooter_pen_by"].inner_rml = fmt("UI_pen_by_format", pen_count_to_kill_player, pen_count_to_kill_player)

        if time_to_kill_target < max_kill_time then
            self.elements["target_result"].inner_rml = "UI_dead_in"
            self.elements["target_result_time"].inner_rml = fmt("UI_seconds_format", fmt("{:.0Lf}", time_to_kill_target))
        else
            local hp_left = math.max(0.0, target_hitpoints - player_effective_dmg)
            self.elements["target_result"].inner_rml = "UI_survived_with"
            self.elements["target_result_time"].inner_rml = fmt("UI_hp_format", fmt("{:.0Lf}", hp_left))
        end

        if target_potential_dmg >= player_hitpoints then
            self.elements["shooter_result"].inner_rml = "UI_dead_in"
            self.elements["shooter_result_time"].inner_rml = fmt("UI_seconds_format", fmt("{:.0Lf}", time_to_kill_player))
        else
            local hp_left = math.max(0.0, player_hitpoints - target_potential_dmg)
            self.elements["shooter_result"].inner_rml = "UI_survived_with"
            self.elements["shooter_result_time"].inner_rml = fmt("UI_hp_format", fmt("{:.0Lf}", hp_left))
        end

        self.elements["shooter_result"]:SetClass("hidden", false)
        self.elements["target_result"]:SetClass("hidden", false)
            
        local target_green = time_to_kill_target >= max_kill_time
        self.elements["target_pen_by"].parent_node:SetClass("text-team-ally", target_green)
        self.elements["target_pen_by"].parent_node:SetClass("text-team-enemy", not target_green)
        self.elements["target_total_dmg"].parent_node:SetClass("text-team-ally", target_green)
        self.elements["target_total_dmg"].parent_node:SetClass("text-team-enemy", not target_green)
        self.elements["target_hitpoints"].parent_node:SetClass("text-team-ally", target_green)
        self.elements["target_hitpoints"].parent_node:SetClass("text-team-enemy", not target_green)
        self.elements["target_result"].parent_node:SetClass("bg-team-ally-dead", target_green)
        self.elements["target_result"].parent_node:SetClass("bg-team-enemy-dead", not target_green)

        local shooter_green = target_potential_dmg < player_hitpoints
        self.elements["shooter_pen_by"].parent_node:SetClass("text-team-ally", shooter_green)
        self.elements["shooter_pen_by"].parent_node:SetClass("text-team-enemy", not shooter_green)
        self.elements["shooter_total_dmg"].parent_node:SetClass("text-team-ally", shooter_green)
        self.elements["shooter_total_dmg"].parent_node:SetClass("text-team-enemy", not shooter_green)
        self.elements["shooter_hitpoints"].parent_node:SetClass("text-team-ally", shooter_green)
        self.elements["shooter_hitpoints"].parent_node:SetClass("text-team-enemy", not shooter_green)
        self.elements["shooter_result"].parent_node:SetClass("bg-team-ally-dead", shooter_green)
        self.elements["shooter_result"].parent_node:SetClass("bg-team-enemy-dead", not shooter_green)
    else
        self.elements["shooter_result"]:SetClass("hidden", true)
        self.elements["target_result"]:SetClass("hidden", true)
    end                    
end
        </script>
    </head>
    <body id="confrontation_info_panel" template="info_panel" onload="ConfrontationInfoPanel:new{document = document}">
        <div class="text-xs">
            <div class="flex gap-1 items-center mb-1">
                <svg src="/rml/icons/Event-Penetration-3.svg" class="w-6 flex-none" />
                <p class="flex-1 font-bold">UI_pen_chance</p>
                <p id="summary_pen_chance" class="text-xl font-light leading-none">58%</p>
            </div>
            <div class="flex justify-between" style="color:#F58021FF">
                <p>UI_minimal_damage</p>
                <p id="summary_min_damage">100</p>
            </div>
            <div class="flex justify-between">
                <p>UI_type</p>
                <p id="ammo_type">100</p>
            </div>
            <div class="flex justify-between">
                <p>UI_damage</p>
                <p id="damage">100</p>
            </div>
            <div class="flex justify-between">
                <p>UI_caliber</p>
                <p id="caliber">100</p>
            </div>
            <div class="flex justify-between">
                <p>UI_pen</p>
                <p id="piercing_power">100</p>
            </div>
            <div class="flex justify-between">
                <p>UI_pen_effective_armor</p>
                <p id="effective_armor">100</p>
            </div>
            <p id="shot_result" class="mt-2 text-sm"></p>
            <div id="pen_result" class="mt-4">
                <div class="flex gap-2 items-end mb-1">
                    <svg src="/rml/icons/AI-Confrontation-Shooter-1.svg" class="w-6 flex-none" />
                    <p id="shooter" class="font-bold">T29</p>
                </div>
                <div class="flex gap-2 justify-between">
                    <p>UI_dispersion</p>
                    <p id="dispersion">100</p>
                </div>
                <div class="flex gap-2 justify-between">
                    <p>UI_pen_by</p>
                    <p id="shooter_pen_by">100</p>
                </div>
                <div class="flex gap-2 justify-between">
                    <p>UI_total_damage_received</p>
                    <p id="shooter_total_dmg">100</p>
                </div>
                <div class="flex gap-2 justify-between">
                    <p>UI_hitpoints</p>
                    <p id="shooter_hitpoints">100</p>
                </div>
                <div class="flex gap-2 justify-between px-1">
                    <p id="shooter_result" class="text-black"></p>
                    <p id="shooter_result_time" class="text-black">100</p>
                </div>
                <div class="flex gap-2 items-end mt-4 mb-1">
                    <svg src="/rml/icons/AI-Confrontation-Target.svg" class="w-6 flex-none" />
                    <p id="target" class="font-bold">T29</p>
                </div>
                <div id="armor_groups"></div>
                <div class="flex gap-2 justify-between">
                    <p>UI_pen_by</p>
                    <p id="target_pen_by">100</p>
                </div>
                <div class="flex gap-2 justify-between">
                    <p>UI_total_damage_received</p>
                    <p id="target_total_dmg">100</p>
                </div>
                <div class="flex gap-2 justify-between">
                    <p>UI_hitpoints</p>
                    <p id="target_hitpoints">100</p>
                </div>
                <div class="flex gap-2 justify-between px-1">
                    <p id="target_result" class="text-black"></p>
                    <p id="target_result_time" class="text-black">100</p>
                </div>
            </div>
            <div id="modules" class="mt-4">
                <div class="flex gap-1 items-center">
                    <svg src="/rml/icons/Modules-.svg" class="w-6 flex-none" />
                    <p class="flex-1 font-bold">UI_damage_to_modules</p>
                    <p id="damage_to_modules" class="text-xl font-light leading-none">50</p>
                </div>
                <div id="modules_result" class="mt-2 space-y-2">
                </div>
                <div id="no_modules" class="mt-2 space-y-2">
                    <p id="no_modules_text"></p>
                    <p>UI_modules_try_heatmaps</p>
                    <button class="flex bg-secondary text-primary-foreground rounded" onclick="XrayInfoPanel.openHeatmaps()">
                        <template src="button">
                            <p>UI_open_heatmaps</p>
                        </template>
                    </button>
                </div>
            </div>
            <div id="armor_details" class="mt-4">
                <p class="text-base font-light text-white pl-6">UI_details</p>
                <hr class="mb-1" style="border-color:white" />
                <div id="armor_plates">
                </div>
                <p class="text-base font-light text-white pl-6 mt-2">UI_modules</p>
                <hr class="mb-1" style="border-color:white" />
                <div id="module_details">
                </div>
            </div>
        </div>
    </body>
</rml>