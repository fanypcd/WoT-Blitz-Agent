<rml>
	<head>
		<title>Popup</title>
		<link type="text/template" href="/rml/templates/window.rml" />
		<link type="text/template" href="/rml/templates/button.rml" />
		<style>
			body
			{
				width: 60%;
				max-height: 80%;
			}
		</style>
		<script>
Popup = {}

function Popup.open(title, message, close_button, action_text, action_script)
	local doc = main_context.documents['popup']
	if doc then
		doc:GetElementById("title").inner_rml = title
		doc:GetElementById("message").inner_rml = message
		doc:GetElementById("close_button"):SetClass("hidden", not close_button)
		doc:GetElementById("action_button"):SetClass("hidden", action_text == nil)
		
		if action_text then
			doc:GetElementById("action_text").inner_rml = action_text
		end
		
		Popup._action_script = action_script

        Window.centerVertically(doc)
	end
	return doc
end

function Popup.onActionButton(document)
	if Popup._action_script then
		local chunk, err = load(Popup._action_script, "=popup_action", "t", _ENV or _G)
		if chunk then
			pcall(chunk)
		end
	end
	document:Hide()
end

function Popup.hide()
	local doc = main_context.documents['popup']
	if doc then
		doc:Hide()
	end
end
	
		</script>
	</head>
	<body id="popup" class="m-auto" template="window">
		<div>
			<p id="message" class="mb-4">
				message
			</p>
			<div class="flex justify-end gap-2">
				<button id="close_button" class="bg-secondary text-primary-foreground rounded" onclick="document:Hide()">
					<template src="button">
						<p>UI_ok</p>
					</template>
				</button>
                <button id="action_button" class="bg-secondary text-primary-foreground rounded" onclick="Popup.onActionButton(document)">
					<template src="button">
						<p id="action_text">action</p>
					</template>
				</button>
			</div>
		</div>
	</body>
</rml>