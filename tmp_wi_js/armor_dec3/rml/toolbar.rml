<rml>
	<head>
		<title>Toolbar</title>
		<link type="text/template" href="/rml/templates/button_icon.rml" />
		<link type="text/template" href="/rml/templates/menu.rml" />
		<script>
Toolbar = {}
Toolbar.__index = Toolbar
setmetatable(Toolbar, {__index = Menu})

local function updateShotsNotification()
    local self = Toolbar
    self:updateShotsNotification()
end

function Toolbar:new(obj)
    local obj = Menu:new(obj)
	setmetatable(obj, self)
    
    obj.document:GetElementById("content"):SetClass("rounded-bl", true)
    
    obj.elements = {}

    local element_ids = {
        "fullscreen_button", "shots_notification"
    }
    
    for _, id in ipairs(element_ids) do
        obj.elements[id] = obj.document:GetElementById(id)
    end

    Toolbar = obj
    
    if not PLATFORM_EMSCRIPTEN or VERSION_MOD then
        obj.elements["fullscreen_button"]:SetClass("hidden", true)
    end
    
    -- connect signals
    runOnChange(updateShotsNotification,
            "ui.shotsOpened", "db.platformCode",
            "ui.shots_pc", "ui.shots_blitz", "ui.shots_mirtankov", "ui.shots_tanksblitz",
            "ui.shotsAvailable_pc", "ui.shotsAvailable_blitz", "ui.shotsAvailable_mirtankov", "ui.shotsAvailable_tanksblitz"
            )

    -- sync ui
    return obj
end

function Toolbar:updateShotsNotification()
    local game_code = settings:getString("db.platformCode")
    local shots_tab_opened = settings:getInt("ui.shotsOpened")
    local shots_available = settings:getInt("ui.shotsAvailable_" .. game_code)
    local shots_opened = settings:getInt("ui.shots_" .. game_code)
    
    self.elements["shots_notification"]:SetClass("hidden", shots_tab_opened and shots_available <= shots_opened)
end

        </script>
	</head>
	<body id="toolbar" template="menu" onload="Toolbar:new{document = document, is_right = true, opened = true}">
        <button class="text-secondary" onclick="PhotoMenu:open(true)">
            <template src="button_icon">
                <div class="w-8 flex flex-col truncate">
                    <p class="text-xs">UI_icon_photo</p>
                    <svg src="/rml/icons/Photo-Camera-PhotoStudio.svg" class="w-8 flex-none" />
                </div>
            </template>
        </button>
        <button class="text-secondary" onclick="ViewsMenu:open(true)">
            <template src="button_icon">
                <div class="w-8 flex flex-col truncate">
                    <p class="text-xs">UI_icon_views</p>
                    <svg src="/rml/icons/Tank-ViewRight-1.svg" class="w-8 flex-none" />
                </div>
            </template>
        </button>
        <button class="text-secondary relative" onclick="ShotList:toggle()">
            <template src="button_icon">
                <div class="w-8 flex flex-col truncate">
                    <p class="text-xs">UI_icon_shots</p>
                    <svg src="/rml/icons/LastShots-Replay.svg" class="w-8 flex-none" />
                </div>
            </template>
            <div id="shots_notification" class="absolute top-1 w-1 h-1 rounded-xl hidden right-0 top-0" style="background-color:red"></div>
        </button>
        <button id="fullscreen_button" class="text-secondary" onclick="ui_service:toggleFullscreen()">
            <template src="button_icon">
                <div class="w-8 flex flex-col truncate">
                    <p class="text-xs">UI_icon_fullscreen</p>
                    <svg src="/rml/icons/Controls-FullScreen.svg" class="w-8 flex-none" />
                </div>
            </template>
        </button>
    </body>
</rml>