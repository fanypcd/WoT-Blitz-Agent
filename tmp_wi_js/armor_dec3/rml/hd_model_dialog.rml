<rml>
    <head>
        <title>HD Model Dialog</title>
        <link type="text/template" href="/rml/templates/window.rml" />
        <link type="text/template" href="/rml/templates/button.rml" />
        <style>
            body
            {
                width: 60%;
                max-height: 80%;
            }
        </style>
        <script>
HDModelDialog = {}

function HDModelDialog.open()
	local document = HDModelDialog.document
	if document then
        local time_now = os.time()
        local last_download_time = settings:getDouble("pkg.downloadTime")
        local time_since_last_download = os.difftime(time_now, last_download_time)
        if time_since_last_download > 3600.0 * 24.0 or iap_service.has_premium_features then
            document:GetElementById("download_progress"):SetAttribute("value", 0)
            data_packages_service:requestHDPackageSize(db_service:getPlatform(), arena_service.target_vehicle.vehicle_id, arena_service.target_vehicle_info.default_skin)
            document:GetElementById("download_button"):SetClass("disabled", false)
        else
            local seconds = math.floor(24.0 * 3600.0 - time_since_last_download)
            local hours = seconds // 3600
            local minutes = (seconds // 60) % 60
            document:GetElementById("texture_size").inner_rml = fmt("UI_hd_time_left", hours, minutes)
            document:GetElementById("download_button"):SetClass("disabled", true)
        end
    
        document:GetElementById("download_progress"):SetAttribute("value", "0")

        Window.centerVertically(document)
	end
	return document
end

function HDModelDialog.onLoad(document)
    local self = HDModelDialog
    self.document = document
        
	document:GetElementById("title").inner_rml = "UI_hd_textures"
    
    if PLATFORM_EMSCRIPTEN then
    	document:GetElementById("erase_descr"):SetClass("hidden", true)
    end
    
    -- connect signals
    data_packages_service:connect_hdPackageDownloadFailed(function(error, is_sd)
        local self = HDModelDialog
        if not is_sd then
            Popup.open("UI_error_title", error, true);
            data_packages_service:requestHDPackageSize(db_service:getPlatform(), arena_service.target_vehicle.vehicle_id, arena_service.target_vehicle_info.default_skin)
            self.document:Hide()
        end
        self.document:GetElementById("download_progress"):SetAttribute("value", "0")
    end)
    
    data_packages_service:connect_hdPackageDownloading(function(dl_now, dl_total)
        local self = HDModelDialog
        self.document:GetElementById("download_progress"):SetAttribute("value", 100 * dl_now / (dl_total + 1.0))
    end)
    
    data_packages_service:connect_hdPackageSizeObtained(function(size) 
        local self = HDModelDialog
        self.document:GetElementById("texture_size").inner_rml = fmt("UI_hd_download_desc", size / 1024.0 / 1024.0)
        self.document:GetElementById("download_progress"):SetAttribute("value", 0)
    end)
    
    data_packages_service:connect_hdPackageDownloaded(function(vehicle_id)
        local self = HDModelDialog
        self.document:GetElementById("download_progress"):SetAttribute("value", 100)
        self.document:GetElementById("texture_size").inner_rml = "UI_hd_already_downloaded"
        self.document:Hide()
    end)
end

        </script>
    </head>
    <body id="hd_model_dialog" class="m-auto" template="window" onload="HDModelDialog.onLoad(document)">
        <div>
            <p class="mb-4">UI_hd_textures_desc</p>
            <p id="erase_descr" class="mb-4">UI_hd_textures_erase_desc</p>
            <div class="flex gap-2">
                <button id="download_button" class="bg-secondary text-primary-foreground rounded" onclick="if not element:IsClassSet('disabled') then data_packages_service:requestHDPackage() end">
                    <template src="button">
                        <p>UI_download</p>
                    </template>
                </button>
                <div class="flex-1">
                    <progress id="download_progress" class="w-full" value="50" max="100" />
                    <p id="texture_size" class="text-xs"></p>
                </div>
            </div>
        </div>
    </body>
</rml>