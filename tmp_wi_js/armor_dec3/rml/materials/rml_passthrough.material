material:
  sampler:
  - id: _tex
    path: materials/system/white.png
    mipmap: false
    wrapS: CLAMP
    wrapT: CLAMP
    minFilter: LINEAR
    magFilter: LINEAR

  technique:
  - id: blend
    renderState:
      blend: true
      blendSrc: ONE
      blendDst: ONE_MINUS_SRC_ALPHA
    pass:
      vertexShader: rml/shaders/shader_vert_passthrough.vert
      fragmentShader: rml/shaders/shader_frag_passthrough.frag
  - id: noBlend
    pass:
      vertexShader: rml/shaders/shader_vert_passthrough.vert
      fragmentShader: rml/shaders/shader_frag_passthrough.frag
  - id: texTransform
    pass:
      vertexShader: rml/shaders/shader_vert_passthrough.vert
      fragmentShader: rml/shaders/shader_frag_passthrough.frag
      defines: "UV_TRANSFORM"
  