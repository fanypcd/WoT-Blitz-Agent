material:

  sampler:
  - id: _tex
    path: materials/system/white.png
    mipmap: false
    wrapS: CLAMP
    wrapT: CLAMP
    minFilter: LINEAR
    magFilter: LINEAR

  technique:
  - id: default
    pass:
      vertexShader: rml/shaders/shader_vert_blur.vert
      fragmentShader: rml/shaders/shader_frag_blur.frag
  