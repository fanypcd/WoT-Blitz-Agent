<template name="modules" content="modules_container">
<head>
	<link type="text/rcss" href="/rml/main.rcss"/>
    <style>
        select {
            height: 34dp;
        }

        select selectvalue{
            height: 34dp;
        }
    </style>
    <script>
local utils = require ("rml.scripts.utils")

ModuleSelector = {}
ModuleSelector.__index = ModuleSelector

function ModuleSelector:new(obj)
    setmetatable(obj, self)

    obj.elements = {}
    
    local element_ids = {
        "hull_select", "chassis_select", "engine_select", "turret_select", 
        "gun_select", "radio_select",
    }
    
    for _, id in ipairs(element_ids) do
        obj.elements[id] = obj.document:GetElementById(id)
    end
    
    obj.elements["hull_select"]:AddEventListener("change", function(event) obj:onChangeModule("hull", event.parameters["value"]) end, true)
    obj.elements["chassis_select"]:AddEventListener("change", function(event) obj:onChangeModule("chassis", event.parameters["value"]) end, true)
    obj.elements["engine_select"]:AddEventListener("change", function(event) obj:onChangeModule("engine", event.parameters["value"]) end, true)
    obj.elements["turret_select"]:AddEventListener("change", function(event) obj:onChangeModule("turret", event.parameters["value"]) end, true)
    obj.elements["gun_select"]:AddEventListener("change", function(event) obj:onChangeModule("gun", event.parameters["value"]) end, true)
    obj.elements["radio_select"]:AddEventListener("change", function(event) obj:onChangeModule("radio", event.parameters["value"]) end, true)
    
    return obj
end

local function split(str, sep)
    local t = {}
    local pattern = "([^" .. sep .. "]+)"
    if sep == "" then
        pattern = "."
    end

    for s in string.gmatch(str, pattern) do
        table.insert(t, s)
    end
    return t
end

function ModuleSelector:fillHulls()
    local module_list = split(self.specs["/hull/list"] or "", ",")
    local container = self.elements["hull_select"]
    local has_multiple = #module_list > 1

    container:SetClass("hidden", not has_multiple)
    if not has_multiple then
        return
    end

    Element.As["ElementFormControlSelect"](container):RemoveAll()

    local option_template = [[
        <div class="flex gap-2 items-start">
            <div class="w-8 text-xs flex flex-col flex-none">
                <p class="module-tier text-center">1</p>
                <svg src="/rml/icons/modules-Hull-.svg" class="w-8 flex-none module-icon" />
            </div>
            <p class="module-name text-sm self-center"></p>
        </div>
    ]]

    local tier_labels = utils.tier_labels
    local current_id = self.specs["/hull/id"]

    for idx, module in ipairs(module_list) do
        local option = container:AppendChild(self.document:CreateElement("option"))
        option.inner_rml = option_template
        option:SetAttribute("value", module)

        option:QuerySelector(".module-tier").inner_rml = tier_labels[idx]
        option:QuerySelector(".module-name").inner_rml = self.specs["/hull/" .. module .. "/localizedName"] or module

        if module == current_id then
            Element.As["ElementFormControlSelect"](container).selection = idx
        end
    end
end

function ModuleSelector:fillModules(type, icon)
    local list_key = type ~= "gun" and ("/" .. type .. "/list") or ("/turret/" .. self.specs["/turret/id"] .. "/gun/list")
    local module_list = split(self.specs[list_key], ",")
    
    local container = self.elements[type .. "_select"]
    Element.As["ElementFormControlSelect"](container):RemoveAll()
       
    local option_template = [[
        <div class="flex gap-2 items-start">
            <div class="w-8 text-xs flex flex-col flex-none">
                <p class="module-tier text-center">IX</p>
                <svg src="/rml/icons/Modules-Tracks-.svg" class="w-8 flex-none module-icon" />
            </div>
            <p class="module-name text-sm self-center"></p>
        </div>
    ]]
    
    local tier_labels = utils.tier_labels
    local current_id = self.specs["/" .. type .. "/id"]
    
    for idx, module in ipairs(module_list) do
        local option = container:AppendChild(self.document:CreateElement("option"))
        option.inner_rml = option_template
        option:SetAttribute("value", module)
        
        local module_prefix = type == "gun" and "/turret/" .. self.specs["/turret/id"] or ""
        
        option:QuerySelector(".module-tier").inner_rml = tier_labels[tonumber(self.specs[module_prefix .. "/" .. type .. "/" .. module .. "/level"] or "1")]
        option:QuerySelector(".module-name").inner_rml = self.specs[module_prefix .. "/" .. type .. "/" .. module .. "/localizedName"]
        option:QuerySelector(".module-icon"):SetAttribute("src", "/rml/icons/" .. icon)
        
        if module == current_id then
            Element.As["ElementFormControlSelect"](container).selection = idx
        end
    end
end

function ModuleSelector:onChangeModule(type, module_id)
    local current_id = self.specs["/" .. type .. "/id"]
    if module_id and #module_id > 0 and current_id ~= module_id then
        self.vehicle_descr[type .. "_id"] = tonumber(module_id)
        self.on_change_module()
        self.specs["/" .. type .. "/id"] = module_id
        if type == "turret" then
            self:fillModules("gun", utils.getModuleIcon(PlatformDB.DeviceType.GUN))
        end
    end
end

function ModuleSelector:init(vehicle_descr, specs)
    self.vehicle_descr = vehicle_descr
    self.specs = specs
    
    local platform = db_service.platform
    
    self:fillHulls()
    self:fillModules("chassis", utils.getModuleIcon(PlatformDB.DeviceType.TRACK))
    self:fillModules("engine", utils.getModuleIcon(PlatformDB.DeviceType.ENGINE))
    self:fillModules("turret", utils.getModuleIcon(PlatformDB.DeviceType.TURRET_ROTATOR))
    self:fillModules("gun", utils.getModuleIcon(PlatformDB.DeviceType.GUN))
    
    local is_blitz = platform and (platform.game_code == "blitz" or platform.game_code == "tanksblitz" or platform.game_code == "reforged")
    self.elements["radio_select"]:SetClass("hidden", is_blitz)
    if not is_blitz then
        self:fillModules("radio", utils.getModuleIcon(PlatformDB.DeviceType.RADIO))
    end
end

    </script>
</head>
<body>
    <div>
        <p class="text-xs mb-1">UI_modules</p>
        <div class="flex gap-1">
            <select id="chassis_select" class="w-8">
            </select>
            <select id="hull_select" class="w-8 hidden">
            </select>
            <select id="engine_select" class="w-8">
            </select>
            <select id="turret_select" class="w-8">
            </select>
            <select id="gun_select" class="w-8">
            </select>
            <select id="radio_select" class="w-8">
            </select>
        </div>
    </div>
</body>
</template>