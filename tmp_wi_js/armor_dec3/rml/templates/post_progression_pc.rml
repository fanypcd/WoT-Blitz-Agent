<template name="post_progression_pc" content="">
<head>
	<link type="text/rcss" href="/rml/main.rcss"/>
    <script>
local utils = require ("rml.scripts.utils")

PostProgressionPc = {}
PostProgressionPc.__index = PostProgressionPc

function PostProgressionPc:new(obj)
    setmetatable(obj, self)

    obj.elements = {}
    
    local element_ids = {
        "post_progression_pc_container", "reset_button_post_progression_pc", "post_progression_slider",
        "post_progression_level", "post_progression_upgrades_toggle", "post_progression_title"
    }
    
    for _, id in ipairs(element_ids) do
        obj.elements[id] = obj.document:GetElementById(id)
    end
    
    obj.slider_change_guard = false
    obj.elements["reset_button_post_progression_pc"]:AddEventListener("click", function() obj:reset() end)
    obj.elements["post_progression_slider"]:AddEventListener("change", function() obj:onPostProgressionSliderChange() end)
    obj.elements["post_progression_upgrades_toggle"].parent_node:AddEventListener("click", function() obj:toggleUpgrades() end)
    
    return obj
end

function PostProgressionPc:init(vehicle_descr, vehicle_info)
    self.vehicle_descr = vehicle_descr
    self.vehicle_info = vehicle_info
    self.original_post_progression_descriptor = PostProgressionDescriptor.new(self.vehicle_descr.post_progression_descriptor)
    
    self:updateData()
end

function PostProgressionPc:getConfiguration(vehicle_info)
    local platform = vehicle_info and vehicle_info.shared.platform_pc
    local game_code = utils.toWebGameCode(platform.game_code)
    local is_pc = platform and (game_code == "pc" or platform.game_code == "mirtankov")
    local tree_name = vehicle_info.post_progression_tree
    local tree = platform and tree_name ~= "" and platform:getPostProgressionTree(tree_name)
    local has_upgrades = platform and vehicle_info and vehicle_info.shared.level == 11 and game_code == "pc"
    local is_hidden = not is_pc or not vehicle_info or vehicle_info.shared.level < 6 or not tree
    
    local result = {}

    result.is_hidden = is_hidden
    result.has_upgrades = has_upgrades
    result.max_progression_level = vehicle_info and math.min(8, 5 + math.max(0, vehicle_info.shared.level - 7)) or 0
    result.steps = {}
    
    if tree then
        for _, step in ipairs(tree.steps) do
            local modification1_name = step.value .. "_1"
            local modification2_name = step.value .. "_2"
            local modification1 = platform:getPostProgressionModification(modification1_name)
            local modification2 = platform:getPostProgressionModification(modification2_name)
            table.insert(result.steps, { 
                type = step.type,
                level = step.level,
                value = step.value,
                modification1_name = modification1_name,
                modification2_name = modification2_name,
                modification1_img = modification1 and modification1.img_name,
                modification2_img = modification2 and modification2.img_name,
            })
        end
    end
        
    return result
end

function PostProgressionPc:updateData()
    local configuration = self:getConfiguration(self.vehicle_info)

    local is_hidden = configuration.is_hidden
    local has_upgrades = configuration.has_upgrades
    
    self.elements["post_progression_pc_container"].parent_node:SetClass("hidden", is_hidden)
    
    self.elements["post_progression_pc_container"]:SetClass("hidden", has_upgrades)
    self.elements["post_progression_slider"].parent_node:SetClass("hidden", has_upgrades)
    self.elements["post_progression_upgrades_toggle"].parent_node:SetClass("hidden", not has_upgrades)

    local container = self.elements["post_progression_pc_container"]
    container.inner_rml = ""
    
    self.elements["post_progression_title"].inner_rml = has_upgrades and "UI_upgrades" or "UI_field_mods"
    
    if is_hidden then
        return
    end

    if not has_upgrades then
        local slider = Element.As["ElementFormControlInput"](self.elements["post_progression_slider"])
        local max_progression_level = configuration.max_progression_level
        local level = self.vehicle_descr.post_progression_descriptor.level
        slider.min = 0
        slider.max = max_progression_level
        self.slider_change_guard = true
        slider.value = level
        self.slider_change_guard = false

        self.elements["post_progression_level"].inner_rml = level > 0 and utils.tier_labels[level] or "--"
        
        for _, step in ipairs(configuration.steps) do
            if step.type == 1 and max_progression_level >= step.level then
                local modification1_name = step.modification1_name
                local modification2_name = step.modification2_name
                local modification1_img = step.modification1_img
                local modification2_img = step.modification2_img
                if modification1_img and modification2_img then
                    local group = container:AppendChild(container.owner_document:CreateElement("div"))
                    group:SetClass("flex", true)
                    group:SetClass("bg-content-dark", true)
                    group:SetClass("rounded", true)

                    local device1 = group:AppendChild(container.owner_document:CreateElement("img"))
                    device1.style["padding-left"] = "1px"
                    device1.style["padding-top"] = "1px"
                    device1.style["padding-bottom"] = "1px"
                    device1:SetClass("w-6", true)
                    device1:SetClass("h-6", true)
                    device1:SetClass("flex-none", true)
                    device1:SetClass("icon", true)
                    device1:SetClass("rounded-l", true)
                    device1:SetClass("selected", self.vehicle_descr.post_progression_descriptor:has(modification1_name))
                    device1:SetAttribute("data-modification-name", modification1_name)
                    device1:SetAttribute("src", utils.resolveUiIcon("/ui/icons/pc/post_progression/" .. modification1_img .. "_disabled.png"))
                    device1:AddEventListener("click", function()
                        if not device1:IsClassSet("disabled") then
                            self:toggleModifierPair(modification1_name, modification2_name)
                        end
                    end)

                    local device2 = group:AppendChild(container.owner_document:CreateElement("img"))
                    device2.style["padding-right"] = "1px"
                    device2.style["padding-top"] = "1px"
                    device2.style["padding-bottom"] = "1px"
                    device2:SetClass("w-6", true)
                    device2:SetClass("h-6", true)
                    device2:SetClass("flex-none", true)
                    device2:SetClass("icon", true)
                    device2:SetClass("rounded-r", true)
                    device2:SetClass("selected", self.vehicle_descr.post_progression_descriptor:has(modification2_name))
                    device2:SetAttribute("data-modification-name", modification2_name)
                    device2:SetAttribute("src", utils.resolveUiIcon("/ui/icons/pc/post_progression/" .. modification2_img .. "_disabled.png"))
                    device2:AddEventListener("click", function()
                        if not device2:IsClassSet("disabled") then
                            self:toggleModifierPair(modification2_name, modification1_name)
                        end
                    end)
                end
            end
        end
    end
    
    self:updateStates()
end

function PostProgressionPc:reset()
    self.vehicle_descr.post_progression_descriptor = PostProgressionDescriptor.new(self.original_post_progression_descriptor)
    self:updateData()

    if self.on_toggle_equipment then
        self.on_toggle_equipment()
    end
end

function PostProgressionPc:toggleModifierPair(modifier_to_set, modifier_to_clear)
    if self.vehicle_descr.post_progression_descriptor:has(modifier_to_set) then
        self.vehicle_descr.post_progression_descriptor:remove(modifier_to_set)
        self.elements["post_progression_pc_container"]:QuerySelector('img[data-modification-name="' .. modifier_to_set .. '"]'):SetClass("selected", false)
    else
        self.vehicle_descr.post_progression_descriptor:add(modifier_to_set)
        self.vehicle_descr.post_progression_descriptor:remove(modifier_to_clear)
        self.elements["post_progression_pc_container"]:QuerySelector('img[data-modification-name="' .. modifier_to_set .. '"]'):SetClass("selected", true)
        self.elements["post_progression_pc_container"]:QuerySelector('img[data-modification-name="' .. modifier_to_clear .. '"]'):SetClass("selected", false)
    end

    if self.on_toggle_equipment then
        self.on_toggle_equipment()
    end
end

function PostProgressionPc:onPostProgressionSliderChange()
    if self.slider_change_guard then
        return
    end

    local slider = Element.As["ElementFormControlInput"](self.elements["post_progression_slider"])
    local value = tonumber(slider.value)
    self.elements["post_progression_level"].inner_rml = value > 0 and utils.tier_labels[value] or "--"
    
    self.vehicle_descr.post_progression_descriptor.level = math.floor(value)
    self:updateStates()
    if self.on_toggle_equipment then
        self.on_toggle_equipment()
    end
end

function PostProgressionPc:toggleUpgrades()
    if self.vehicle_descr.post_progression_descriptor.level == 0 then
        self.vehicle_descr.post_progression_descriptor.level = 100
    else
        self.vehicle_descr.post_progression_descriptor.level = 0
    end
    
    self:updateStates()
    if self.on_toggle_equipment then
        self.on_toggle_equipment()
    end
end

function PostProgressionPc:updateStates()
    local platform = self.vehicle_info and self.vehicle_info.shared.platform_pc
    local tree_name = self.vehicle_info.post_progression_tree
    local tree = platform and tree_name ~= "" and platform:getPostProgressionTree(tree_name)

    local current_level = self.vehicle_descr.post_progression_descriptor.level
    for _, step in ipairs(tree.steps) do
        if step.type == 1 then
            local modification1_name = step.value .. "_1"
            local modification2_name = step.value .. "_2"
            local icon1 = self.elements["post_progression_pc_container"]:QuerySelector('img[data-modification-name="' .. modification1_name .. '"]')
            local icon2 = self.elements["post_progression_pc_container"]:QuerySelector('img[data-modification-name="' .. modification2_name .. '"]')

            if icon1 then
                icon1:SetClass("disabled", current_level < step.level)
            end

            if icon2 then
                icon2:SetClass("disabled", current_level < step.level)
            end
        end
    end
    
    self.elements["post_progression_upgrades_toggle"]:SetClass("checked", current_level > 0)
end

    </script>
</head>
<body>
    <div style="min-width:164dp;">
        <div class="flex gap-2 text-xs mb-1 justify-between">
            <p id="post_progression_title">UI_field_mods</p>
            <div id="reset_button_post_progression_pc" class="flex flex-nowrap items-center text-secondary">
                <svg src="/rml/icons/UI-return-reload-reset-.svg" class="w-3 flex-none" />
                <p>UI_reset</p>
            </div>
        </div>
        <div class="flex gap-1 items-center h-4 mb-1">
            <input id="post_progression_slider" class="flex-1" type="range" />
            <p id="post_progression_level" class="w-4 text-xs text-center flex-none"></p>
        </div>
        <div id="post_progression_pc_container" class="flex gap-1 flex-wrap text-xs">
        </div>
        <div class="text-sm flex gap-1 items-center text-secondary">
            <switch id="post_progression_upgrades_toggle">
                <div class="thumb"></div>
            </switch>
            <p>UI_all_upgrades</p>
        </div>
    </div>
</body>
</template>