<template name="perks_blitz" content="">
<head>
	<link type="text/rcss" href="/rml/main.rcss"/>
    <script>
local utils = require ("rml.scripts.utils")

PerksSelectorBlitz = {}
PerksSelectorBlitz.__index = PerksSelectorBlitz

function PerksSelectorBlitz:new(obj)
    setmetatable(obj, self)

    obj.elements = {}
    
    local element_ids = {
        "perks_blitz_container", "reset_button_perks_blitz", "max_perks_blitz",
        "perks_blitz_lt", "perks_blitz_mt", "perks_blitz_ht", "perks_blitz_td", 
    }
    
    for _, id in ipairs(element_ids) do
        obj.elements[id] = obj.document:GetElementById(id)
    end
    
    obj.elements["reset_button_perks_blitz"]:AddEventListener("click", function() obj:reset() end)
    obj.elements["max_perks_blitz"]:AddEventListener("click", function() obj:onMaxPerksButton() end)

    return obj
end

function PerksSelectorBlitz:init(vehicle_descr, original_descr)
    self.vehicle_descr = vehicle_descr
    self.original_perks = CrewPerksDescriptor.new((original_descr or self.vehicle_descr).crew_perks)
    
    self:updatePerks()
end

function PerksSelectorBlitz:createPerkElement(container, perk_name)
    local perk_template = [[
        <img class="w-8 h-8 box-border icon" />
        <small class="absolute text-secondary font-bold" style="bottom:3dp;left:2dp"></small>
        <div class="bg-header w-full box-border absolute bottom-0 left-0" style="height:3dp;"></div>
        <div class="bg-secondary box-border absolute bottom-0 left-0" style="height:3dp;width:0%"></div>
    ]]
    
    local icon_name = perk_name
    if icon_name == "skilled_ranging" then
        icon_name = icon_name .. "_1"
    elseif icon_name == "fast_capture" then
        icon_name = icon_name .. "_0"
    end
    
    local perk_level = self.vehicle_descr.crew_perks:get(perk_name)
    
    local perk_element = container:AppendChild(container.owner_document:CreateElement("div"))
    perk_element:SetClass("h-8", true)
    perk_element:SetClass("relative", true)
    perk_element:SetClass("rounded", true)
    perk_element:SetClass("bg-content-dark", true)
    perk_element:SetClass("overflow-hidden", true)
    perk_element:SetClass("opacity-70", perk_level == 0.0)
    perk_element:SetAttribute("data-perk-name", perk_name)

    perk_element.inner_rml = perk_template
    perk_element:QuerySelector("img"):SetAttribute("src", utils.resolveUiIcon("/ui/icons/blitz/skills/" .. icon_name .. ".packed.png"))
    perk_element:QuerySelector(".text-secondary").inner_rml = perk_level > 0 and utils.tier_labels[perk_level] or ""
    perk_element:QuerySelector(".bg-secondary").style.width = (perk_level / 7.0 * 100) .. "%"
    
    perk_element:AddEventListener("click", function()
        local perk_level = self.vehicle_descr.crew_perks:get(perk_name)
        local next_level = perk_level < 7 and perk_level + 1 or 0
        
        perk_element:SetClass("opacity-70", next_level == 0.0)
        perk_element:QuerySelector(".text-secondary").inner_rml = next_level > 0 and utils.tier_labels[next_level] or ""
        perk_element:QuerySelector(".bg-secondary").style.width = (next_level / 7.0 * 100) .. "%"
        
        self.vehicle_descr.crew_perks:set(perk_name, next_level)
        if self.on_update_perks then
            self.on_update_perks()
        end
    end)
end

function PerksSelectorBlitz:updatePerks()
    local platform = db_service.platform
    local is_blitz = platform and (platform.game_code == "blitz" or platform.game_code == "tanksblitz" or platform.game_code == "reforged")
    self.elements["perks_blitz_container"].parent_node:SetClass("hidden", not is_blitz)
    
    if is_blitz then
        self.elements["perks_blitz_lt"].inner_rml = ""
        self:createPerkElement(self.elements["perks_blitz_lt"], "lucky_shot")
        self:createPerkElement(self.elements["perks_blitz_lt"], "surrounded_by_enemy")
        self:createPerkElement(self.elements["perks_blitz_lt"], "soft_recoil")
        self:createPerkElement(self.elements["perks_blitz_lt"], "skilled_ranging")
        self:createPerkElement(self.elements["perks_blitz_lt"], "fast_capture")
        
        self.elements["perks_blitz_mt"].inner_rml = ""
        self:createPerkElement(self.elements["perks_blitz_mt"], "battle_rage")
        self:createPerkElement(self.elements["perks_blitz_mt"], "armour_piercing")
        self:createPerkElement(self.elements["perks_blitz_mt"], "tutor")
        self:createPerkElement(self.elements["perks_blitz_mt"], "smooth_driving")
        self:createPerkElement(self.elements["perks_blitz_mt"], "smooth_turret")
        
        self.elements["perks_blitz_ht"].inner_rml = ""
        self:createPerkElement(self.elements["perks_blitz_ht"], "skilled_repairer")
        self:createPerkElement(self.elements["perks_blitz_ht"], "close_combat_master")
        self:createPerkElement(self.elements["perks_blitz_ht"], "fire_fighting")
        self:createPerkElement(self.elements["perks_blitz_ht"], "desperado")
        self:createPerkElement(self.elements["perks_blitz_ht"], "repair")
        
        self.elements["perks_blitz_td"].inner_rml = ""
        self:createPerkElement(self.elements["perks_blitz_td"], "sniper")
        self:createPerkElement(self.elements["perks_blitz_td"], "deadly_accuracy")
        self:createPerkElement(self.elements["perks_blitz_td"], "camouflage")
        self:createPerkElement(self.elements["perks_blitz_td"], "virtuoso")
        self:createPerkElement(self.elements["perks_blitz_td"], "smooth_turn")
    end
end

function PerksSelectorBlitz:reset()
    self.vehicle_descr.crew_perks = CrewPerksDescriptor.new(self.original_perks)
    self:updatePerks()

    if self.on_update_perks then
        self.on_update_perks()
    end
end

function PerksSelectorBlitz:onMaxPerksButton()
    local all_max = true
    for _, perk_element in ipairs(self.elements["perks_blitz_container"]:QuerySelectorAll("div[data-perk-name]")) do
        local perk_level = self.vehicle_descr.crew_perks:get(perk_element:GetAttribute("data-perk-name"))
        all_max = all_max and perk_level == 7.0
    end
    
    for _, perk_element in ipairs(self.elements["perks_blitz_container"]:QuerySelectorAll("div[data-perk-name]")) do
        self.vehicle_descr.crew_perks:set(perk_element:GetAttribute("data-perk-name"), all_max and 0.0 or 7.0)
    end
    
    self:updatePerks()
    if self.on_update_perks then
        self.on_update_perks()
    end
end

    </script>
</head>
<body>
    <div>
        <div class="flex gap-2 text-xs mb-1 justify-between">
            <p>UI_crew_skills</p>
            <p id="max_perks_blitz" class="text-secondary">UI_max</p>
            <div id="reset_button_perks_blitz" class="flex flex-nowrap items-center text-secondary">
                <svg src="/rml/icons/UI-return-reload-reset-.svg" class="w-3 flex-none" />
                <p>UI_reset</p>
            </div>
        </div>
        <div id="perks_blitz_container" class="space-y-1 text-xs">
            <div id="perks_blitz_lt" class="flex gap-1"></div>
            <div id="perks_blitz_mt" class="flex gap-1"></div>
            <div id="perks_blitz_ht" class="flex gap-1"></div>
            <div id="perks_blitz_td" class="flex gap-1"></div>
        </div>
    </div>
</body>
</template>