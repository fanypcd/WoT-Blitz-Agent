<template name="boosters_pc" content="">
<head>
	<link type="text/rcss" href="/rml/main.rcss"/>
    <script>
local utils = require ("rml.scripts.utils")

BoostersSelectorPc = {}
BoostersSelectorPc.__index = BoostersSelectorPc

function BoostersSelectorPc:new(obj)
    setmetatable(obj, self)

    obj.elements = {}
    
    local element_ids = {
        "boosters_pc_container", "reset_button_boosters_pc",
    }
    
    for _, id in ipairs(element_ids) do
        obj.elements[id] = obj.document:GetElementById(id)
    end
    
    obj.elements["reset_button_boosters_pc"]:AddEventListener("click", function() obj:reset() end)

    return obj
end

function BoostersSelectorPc:init(vehicle_descr, vehicle_info, original_descr)
    self.vehicle_descr = vehicle_descr
    self.vehicle_info = vehicle_info
    self.original_equipment = EquipmentDescriptor.new((original_descr or self.vehicle_descr).equipment_descriptor)
    
    self:updateIcons()
end

function BoostersSelectorPc:createElement(container, artefact_name, artefact)
    local icon_name = artefact_name
    
    local element = container:AppendChild(container.owner_document:CreateElement("img"))
    element:SetClass("h-6", true)
    element:SetClass("w-6", true)
    element:SetClass("rounded", true)
    element:SetClass("bg-content-dark", true)
    element:SetClass("box-border", true)
    element:SetClass("icon", true)
    element:SetClass("selected", self.vehicle_descr.equipment_descriptor:has(artefact_name))
    element:SetAttribute("data-artefact-name", artefact_name)
    element:SetAttribute("src", utils.resolveUiIcon("/ui/icons/pc/boosters/" .. icon_name .. ".png"))
    
    element:AddEventListener("click", function()
        if not element:IsClassSet("disabled") then 
            self.vehicle_descr.equipment_descriptor:toggle(artefact_name)
            element:SetClass("selected", self.vehicle_descr.equipment_descriptor:has(artefact_name))
            self:updateStates()
            if self.on_toggle_equipment then
                self.on_toggle_equipment()
            end
        end 
    end)
end

function BoostersSelectorPc:getArtefactList(vehicle_info)
    local platform = vehicle_info and vehicle_info.shared.platform

    local result = {}
    local supported_artefacts = platform and platform:getSupportedBattleBoosters(vehicle_info) or {}
    for artefact_name, artefact in pairs(supported_artefacts) do
        table.insert(result, {artefact_name, { id = artefact.id, tags = artefact.tags }})
    end
    
    table.sort(result, function(a, b)
        local a_is_equipment = a[2].tags["equipmentBattleBooster"]
        local b_is_equipment = b[2].tags["equipmentBattleBooster"]
        return a_is_equipment and not b_is_equipment or a_is_equipment == b_is_equipment and a[2].id < b[2].id
    end)
    
    return result
end

function BoostersSelectorPc:updateIcons()
    local platform = db_service.platform
    local is_pc = platform and (platform.game_code == "pc" or platform.game_code == "pcmod" or platform.game_code == "mirtankov" or platform.game_code == "mtmod")
    
    self.elements["boosters_pc_container"].parent_node:SetClass("hidden", not is_pc)    
    self.elements["boosters_pc_container"].inner_rml = ""
    self.artefacts = {}
    
    if not is_pc then
        return
    end
    
    self.artefacts = self:getArtefactList(self.vehicle_info)

    for _, group in ipairs(self.artefacts) do
        self:createElement(self.elements["boosters_pc_container"], group[1], group[2])
    end
    
    self:updateStates()
end

function BoostersSelectorPc:reset()
    self.vehicle_descr.equipment_descriptor = EquipmentDescriptor.new(self.original_equipment)
    self:updateIcons()

    if self.on_toggle_equipment then
        self.on_toggle_equipment()
    end
end

function BoostersSelectorPc:updateStates()
    local platform = self.vehicle_info.shared.platform
    
    local selected_items = self.elements["boosters_pc_container"]:QuerySelectorAll(".icon.selected")
    
    for _, icon in ipairs(self.elements["boosters_pc_container"]:QuerySelectorAll(".icon")) do
        local artefact_name = icon:GetAttribute("data-artefact-name")
        local artefact = platform:getBattleBooster(artefact_name)
        local can_install = artefact:canInstall(self.vehicle_descr, self.vehicle_info.shared)
        if not icon:IsClassSet("selected") then
            icon:SetClass("disabled", #selected_items >= 1 or not can_install)
        elseif not can_install then
            self.vehicle_descr.equipment_descriptor:remove(artefact_name)
            icon:SetClass("selected", false)
            icon:SetClass("disabled", true)
            if self.on_toggle_equipment then
                self.on_toggle_equipment()
            end
        end
    end
end
            
    </script>
</head>
<body>
    <div>
        <div class="flex gap-2 text-xs mb-1 justify-between">
            <p>UI_boosters</p>
            <div id="reset_button_boosters_pc" class="flex flex-nowrap items-center text-secondary">
                <svg src="/rml/icons/UI-return-reload-reset-.svg" class="w-3 flex-none" />
                <p>UI_reset</p>
            </div>
        </div>
        <div id="boosters_pc_container" class="flex gap-1 flex-wrap">
        </div>
    </div>
</body>
</template>