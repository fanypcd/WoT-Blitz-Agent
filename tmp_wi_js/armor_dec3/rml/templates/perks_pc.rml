<template name="perks_pc" content="">
<head>
	<link type="text/rcss" href="/rml/main.rcss"/>
    <script>
local utils = require ("rml.scripts.utils")

PerksSelectorPc = {}
PerksSelectorPc.__index = PerksSelectorPc

function PerksSelectorPc:new(obj)
    setmetatable(obj, self)

    obj.elements = {}
    
    local element_ids = {
        "perks_pc_container", "reset_button_perks_pc", "max_perks_pc",
        "perks_pc_common", "perks_pc_commander", "perks_pc_driver",
        "perks_pc_gunner", "perks_pc_loader", "perks_pc_radioman"
    }
    
    for _, id in ipairs(element_ids) do
        obj.elements[id] = obj.document:GetElementById(id)
    end
    
    obj.elements["reset_button_perks_pc"]:AddEventListener("click", function() obj:reset() end)
    obj.elements["max_perks_pc"]:AddEventListener("click", function() obj:onMaxPerksButton() end)

    return obj
end

function PerksSelectorPc:init(vehicle_descr, original_descr)
    self.vehicle_descr = vehicle_descr
    self.original_perks = CrewPerksDescriptor.new((original_descr or self.vehicle_descr).crew_perks)
    
    self:updatePerks()
end

function PerksSelectorPc:createPerkElement(container, perk_name)
    local icon_name = perk_name
    local perk_level = self.vehicle_descr.crew_perks:get(perk_name)
    
    local perk_element = container:AppendChild(container.owner_document:CreateElement("img"))
    perk_element:SetClass("h-6", true)
    perk_element:SetClass("w-6", true)
    perk_element:SetClass("rounded", true)
    perk_element:SetClass("bg-content-dark", true)
    perk_element:SetClass("box-border", true)
    perk_element:SetClass("icon", true)
    perk_element:SetClass("selected", perk_level ~= 0.0)
    perk_element:SetAttribute("data-perk-name", perk_name)
    perk_element:SetAttribute("src", utils.resolveUiIcon("/ui/icons/pc/skills/" .. icon_name .. ".png"))
    
    perk_element:AddEventListener("click", function()
        local perk_level = self.vehicle_descr.crew_perks:get(perk_name)
        local next_level = perk_level == 0.0 and 1.0 or 0.0
        
        perk_element:SetClass("selected", next_level ~= 0.0)
        
        self.vehicle_descr.crew_perks:set(perk_name, next_level)
        if self.on_update_perks then
            self.on_update_perks()
        end
    end)
end

function PerksSelectorPc:updatePerks()
    local platform = db_service.platform
    local is_pc = platform and (platform.game_code == "pc" or platform.game_code == "pcmod")
    self.elements["perks_pc_container"].parent_node:SetClass("hidden", not is_pc)
    
    if is_pc then
        for _, img in ipairs(self.elements["perks_pc_container"]:QuerySelectorAll("img[data-ui-icon]")) do
            img:SetAttribute("src", utils.resolveUiIcon("/ui/icons/" .. img:GetAttribute("data-ui-icon")))
        end
        self.elements["perks_pc_common"].inner_rml = ""
        self:createPerkElement(self.elements["perks_pc_common"], "brotherhood")
        self:createPerkElement(self.elements["perks_pc_common"], "repair")
        self:createPerkElement(self.elements["perks_pc_common"], "camouflage")

        self.elements["perks_pc_commander"].inner_rml = ""
        self:createPerkElement(self.elements["perks_pc_commander"], "commander_tutor")
        self:createPerkElement(self.elements["perks_pc_commander"], "commander_coordination")
        self:createPerkElement(self.elements["perks_pc_commander"], "commander_enemyShotPredictor")
        self:createPerkElement(self.elements["perks_pc_commander"], "commander_eagleEye")
        self:createPerkElement(self.elements["perks_pc_commander"], "commander_emergency")
        self:createPerkElement(self.elements["perks_pc_commander"], "commander_practical")
        self:createPerkElement(self.elements["perks_pc_commander"], "commander_holdLine")
        self:createPerkElement(self.elements["perks_pc_commander"], "commander_staySharp")

        self.elements["perks_pc_driver"].inner_rml = ""
        self:createPerkElement(self.elements["perks_pc_driver"], "driver_smoothDriving")
        self:createPerkElement(self.elements["perks_pc_driver"], "driver_virtuoso")
        self:createPerkElement(self.elements["perks_pc_driver"], "driver_badRoadsKing")
        self:createPerkElement(self.elements["perks_pc_driver"], "driver_rammingMaster")
        self:createPerkElement(self.elements["perks_pc_driver"], "driver_motorExpert")
        self:createPerkElement(self.elements["perks_pc_driver"], "driver_reliablePlacement")
        self:createPerkElement(self.elements["perks_pc_driver"], "driver_bulletproof")
        self:createPerkElement(self.elements["perks_pc_driver"], "driver_suspensionRepair")

        self.elements["perks_pc_gunner"].inner_rml = ""
        self:createPerkElement(self.elements["perks_pc_gunner"], "gunner_smoothTurret")
        self:createPerkElement(self.elements["perks_pc_gunner"], "gunner_armorer")
        self:createPerkElement(self.elements["perks_pc_gunner"], "gunner_sniper")
        self:createPerkElement(self.elements["perks_pc_gunner"], "gunner_rancorous")
        self:createPerkElement(self.elements["perks_pc_gunner"], "gunner_focus")
        self:createPerkElement(self.elements["perks_pc_gunner"], "gunner_quickAiming")
        self:createPerkElement(self.elements["perks_pc_gunner"], "gunner_pointBlast")
        self:createPerkElement(self.elements["perks_pc_gunner"], "gunner_loneWolf")

        self.elements["perks_pc_loader"].inner_rml = ""
        self:createPerkElement(self.elements["perks_pc_loader"], "loader_pedant")
        self:createPerkElement(self.elements["perks_pc_loader"], "loader_desperado")
        self:createPerkElement(self.elements["perks_pc_loader"], "loader_intuition")
        self:createPerkElement(self.elements["perks_pc_loader"], "loader_perfectCharge")
        self:createPerkElement(self.elements["perks_pc_loader"], "loader_melee")
        self:createPerkElement(self.elements["perks_pc_loader"], "loader_ammunitionImprove")
        self:createPerkElement(self.elements["perks_pc_loader"], "loader_secondChance")
        self:createPerkElement(self.elements["perks_pc_loader"], "loader_magMastery")

        self.elements["perks_pc_radioman"].inner_rml = ""
        self:createPerkElement(self.elements["perks_pc_radioman"], "radioman_finder")
        self:createPerkElement(self.elements["perks_pc_radioman"], "radioman_expert")
        self:createPerkElement(self.elements["perks_pc_radioman"], "radioman_sideBySide")
        self:createPerkElement(self.elements["perks_pc_radioman"], "fireFighting")
        self:createPerkElement(self.elements["perks_pc_radioman"], "radioman_interference")
        self:createPerkElement(self.elements["perks_pc_radioman"], "radioman_signalInterception")
        self:createPerkElement(self.elements["perks_pc_radioman"], "radioman_threatSearch")
        self:createPerkElement(self.elements["perks_pc_radioman"], "radioman_battleTempered")
    end
end

function PerksSelectorPc:onPerkClick(perk_name)
    if self.on_update_perks then
        self.on_update_perks()
    end
end

function PerksSelectorPc:reset()
    self.vehicle_descr.crew_perks = CrewPerksDescriptor.new(self.original_perks)
    self:updatePerks()

    if self.on_update_perks then
        self.on_update_perks()
    end
end

function PerksSelectorPc:onMaxPerksButton()
    local all_max = true
    for _, perk_element in ipairs(self.elements["perks_pc_container"]:QuerySelectorAll("img[data-perk-name]")) do
        local perk_level = self.vehicle_descr.crew_perks:get(perk_element:GetAttribute("data-perk-name"))
        all_max = all_max and perk_level > 0
    end
    
    for _, perk_element in ipairs(self.elements["perks_pc_container"]:QuerySelectorAll("img[data-perk-name]")) do
        self.vehicle_descr.crew_perks:set(perk_element:GetAttribute("data-perk-name"), all_max and 0.0 or 1.0)
    end
    
    self:updatePerks()
    if self.on_update_perks then
        self.on_update_perks()
    end
end

    </script>
</head>
<body>
    <div>
        <div class="flex gap-2 text-xs mb-1 justify-between">
            <p>UI_crew_skills</p>
            <p id="max_perks_pc" class="text-secondary">UI_max</p>
            <div id="reset_button_perks_pc" class="flex flex-nowrap items-center text-secondary">
                <svg src="/rml/icons/UI-return-reload-reset-.svg" class="w-3 flex-none" />
                <p>UI_reset</p>
            </div>
        </div>
        <div id="perks_pc_container" class="flex flex-row gap-1">
            <div class="flex flex-col gap-1">
                <img class="h-6 w-6" data-ui-icon="pc/skills/crewOperations.png" />
                <div id="perks_pc_common" class="flex flex-col gap-1">
                </div>
            </div>
            <div class="flex flex-col gap-1">
                <img class="h-6 w-6" data-ui-icon="pc/skills/commander.png" />
                <div id="perks_pc_commander" class="flex flex-col gap-1">
                </div>
            </div>
            <div class="flex flex-col gap-1">
                <img class="h-6 w-6" data-ui-icon="pc/skills/driver.png" />
                <div id="perks_pc_driver" class="flex flex-col gap-1">
                </div>
            </div>
            <div class="flex flex-col gap-1">
                <img class="h-6 w-6" data-ui-icon="pc/skills/gunner.png" />
                <div id="perks_pc_gunner" class="flex flex-col gap-1">
                </div>
            </div>
            <div class="flex flex-col gap-1">
                <img class="h-6 w-6" data-ui-icon="pc/skills/loader.png" />
                <div id="perks_pc_loader" class="flex flex-col gap-1">
                </div>
            </div>
            <div class="flex flex-col gap-1">
                <img class="h-6 w-6" data-ui-icon="pc/skills/radioman.png" />
                <div id="perks_pc_radioman" class="flex flex-col gap-1">
                </div>
            </div>
        </div>
    </div>
</body>
</template>