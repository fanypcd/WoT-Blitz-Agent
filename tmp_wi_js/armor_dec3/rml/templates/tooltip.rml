<template name="tooltip" content="content">
	<head>
		<link type="text/rcss" href="/rml/main.rcss"/>
		<style>
            body {
            max-width:200dp;
            transform-origin: 0 0;
            }
        </style>
		<script>
Tooltip = Tooltip or {_registry = {}}

function Tooltip:new(o)
	o = o or {}
    setmetatable(o, self)
    self.__index = self
    
    environment:bindTooltipTransform(o.document)
    o._connection_tooltipVisibleSignal = environment:connect_tooltipVisibleSignal(function(visible)
        o._tooltip_ready = visible
        o:updateVisibility()
    end)
    
    Tooltip._registry[o.document.id] = o
    
    return o
end

function Tooltip:destroy()
    self._connection_tooltipVisibleSignal:disconnect()
end

function Tooltip:open()
    self.document:Show()
end

function Tooltip:close()
    self.document:Hide()
end

function Tooltip:checkVisibility()
    return self._tooltip_ready
end

function Tooltip:updateVisibility()
    if self:checkVisibility() then
        self:open()
    else
        self:close()
    end
end

function Tooltip:setHeader(rml)
    self.document:GetElementById("header").inner_rml = rml
end

-- support for hot reload because of signal connections
function Tooltip.onDocumentUnload(document)
    local tooltip = Tooltip._registry[document.id]
    if tooltip then
        tooltip:destroy()
    end
end
		</script>
	</head>
    <body onunload="Tooltip.onDocumentUnload(document)">
        <div class="p-4" style="transform: scale(0.005, -0.005) translateY(-100%);transform-origin: 0 0;">
            <div class="flex flex-col text-hud text-xl font-light">
                <div id="header" class="bg-header p-2 pb-1 rounded-t-xl">
                </div>
                <div id="content" class="bg-tooltip p-2 pt-1 rounded-b-xl space-y-1" style="border-bottom-left-radius:0px">
                </div>
            </div>
        </div>
    </body>
</template>