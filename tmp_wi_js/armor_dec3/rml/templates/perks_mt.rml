<template name="perks_mt" content="">
<head>
	<link type="text/rcss" href="/rml/main.rcss"/>
    <script>
local utils = require ("rml.scripts.utils")

PerksSelectorMt = {}
PerksSelectorMt.__index = PerksSelectorMt

function PerksSelectorMt:new(obj)
    setmetatable(obj, self)

    obj.elements = {}
    
    local element_ids = {
        "perks_mt_container", "reset_button_perks_mt", "max_perks_mt",
        "perks_mt_common", "perks_mt_commander", "perks_mt_driver",
        "perks_mt_gunner", "perks_mt_loader", "perks_mt_radioman"
    }
    
    for _, id in ipairs(element_ids) do
        obj.elements[id] = obj.document:GetElementById(id)
    end
    
    obj.elements["reset_button_perks_mt"]:AddEventListener("click", function() obj:reset() end)
    obj.elements["max_perks_mt"]:AddEventListener("click", function() obj:onMaxPerksButton() end)

    return obj
end

function PerksSelectorMt:init(vehicle_descr, original_descr)
    self.vehicle_descr = vehicle_descr
    self.original_perks = CrewPerksDescriptor.new((original_descr or self.vehicle_descr).crew_perks)
    
    self:updatePerks()
end

function PerksSelectorMt:createPerkElement(container, perk_name)
    local icon_name = perk_name
    local perk_level = self.vehicle_descr.crew_perks:get(perk_name)
    
    local perk_element = container:AppendChild(container.owner_document:CreateElement("img"))
    perk_element:SetClass("h-6", true)
    perk_element:SetClass("w-6", true)
    perk_element:SetClass("rounded", true)
    perk_element:SetClass("bg-content-dark", true)
    perk_element:SetClass("box-border", true)
    perk_element:SetClass("icon", true)
    perk_element:SetClass("selected", perk_level ~= 0.0)
    perk_element:SetAttribute("data-perk-name", perk_name)
    perk_element:SetAttribute("src", utils.resolveUiIcon("/ui/icons/pc/skills/" .. icon_name .. ".png"))
    
    perk_element:AddEventListener("click", function()
        local perk_level = self.vehicle_descr.crew_perks:get(perk_name)
        local next_level = perk_level == 0.0 and 1.0 or 0.0
        
        perk_element:SetClass("selected", next_level ~= 0.0)
        
        self.vehicle_descr.crew_perks:set(perk_name, next_level)
        if self.on_update_perks then
            self.on_update_perks()
        end
    end)
end

function PerksSelectorMt:updatePerks()
    local platform = db_service.platform
    local is_mt = platform and (platform.game_code == "mirtankov" or platform.game_code == "mtmod")
    self.elements["perks_mt_container"].parent_node:SetClass("hidden", not is_mt)
    
    if is_mt then
        for _, img in ipairs(self.elements["perks_mt_container"]:QuerySelectorAll("img[data-ui-icon]")) do
            img:SetAttribute("src", utils.resolveUiIcon("/ui/icons/" .. img:GetAttribute("data-ui-icon")))
        end
        self.elements["perks_mt_common"].inner_rml = ""
        self:createPerkElement(self.elements["perks_mt_common"], "brotherhood")
        self:createPerkElement(self.elements["perks_mt_common"], "repair")
        self:createPerkElement(self.elements["perks_mt_common"], "camouflage")
        self:createPerkElement(self.elements["perks_mt_common"], "fireFighting")

        self.elements["perks_mt_commander"].inner_rml = ""
        self:createPerkElement(self.elements["perks_mt_commander"], "commander_eagleEye")
        self:createPerkElement(self.elements["perks_mt_commander"], "commander_universalist")
        self:createPerkElement(self.elements["perks_mt_commander"], "commander_tutor")
        self:createPerkElement(self.elements["perks_mt_commander"], "commander_expert")
        self:createPerkElement(self.elements["perks_mt_commander"], "commander_enemyShotPredictor")

        self.elements["perks_mt_driver"].inner_rml = ""
        self:createPerkElement(self.elements["perks_mt_driver"], "driver_tidyPerson")
        self:createPerkElement(self.elements["perks_mt_driver"], "driver_smoothDriving")
        self:createPerkElement(self.elements["perks_mt_driver"], "driver_virtuoso")
        self:createPerkElement(self.elements["perks_mt_driver"], "driver_badRoadsKing")
        self:createPerkElement(self.elements["perks_mt_driver"], "driver_rammingMaster")

        self.elements["perks_mt_gunner"].inner_rml = ""
        self:createPerkElement(self.elements["perks_mt_gunner"], "gunner_smoothTurret")
        self:createPerkElement(self.elements["perks_mt_gunner"], "gunner_gunsmith")
        self:createPerkElement(self.elements["perks_mt_gunner"], "gunner_sniper")
        self:createPerkElement(self.elements["perks_mt_gunner"], "gunner_rancorous")

        self.elements["perks_mt_loader"].inner_rml = ""
        self:createPerkElement(self.elements["perks_mt_loader"], "loader_pedant")
        self:createPerkElement(self.elements["perks_mt_loader"], "loader_desperado")
        self:createPerkElement(self.elements["perks_mt_loader"], "loader_intuition")

        self.elements["perks_mt_radioman"].inner_rml = ""
        self:createPerkElement(self.elements["perks_mt_radioman"], "radioman_finder")
        self:createPerkElement(self.elements["perks_mt_radioman"], "radioman_inventor")
        self:createPerkElement(self.elements["perks_mt_radioman"], "radioman_lastEffort")
        self:createPerkElement(self.elements["perks_mt_radioman"], "radioman_retransmitter")
    end
end

function PerksSelectorMt:onPerkClick(perk_name)
    if self.on_update_perks then
        self.on_update_perks()
    end
end

function PerksSelectorMt:reset()
    self.vehicle_descr.crew_perks = CrewPerksDescriptor.new(self.original_perks)
    self:updatePerks()

    if self.on_update_perks then
        self.on_update_perks()
    end
end

function PerksSelectorMt:onMaxPerksButton()
    local all_max = true
    for _, perk_element in ipairs(self.elements["perks_mt_container"]:QuerySelectorAll("img[data-perk-name]")) do
        local perk_level = self.vehicle_descr.crew_perks:get(perk_element:GetAttribute("data-perk-name"))
        all_max = all_max and perk_level > 0
    end
    
    for _, perk_element in ipairs(self.elements["perks_mt_container"]:QuerySelectorAll("img[data-perk-name]")) do
        self.vehicle_descr.crew_perks:set(perk_element:GetAttribute("data-perk-name"), all_max and 0.0 or 1.0)
    end
    
    self:updatePerks()
    if self.on_update_perks then
        self.on_update_perks()
    end
end

    </script>
</head>
<body>
    <div>
        <div class="flex gap-2 text-xs mb-1 justify-between">
            <p>UI_crew_skills</p>
            <p id="max_perks_mt" class="text-secondary">UI_max</p>
            <div id="reset_button_perks_mt" class="flex flex-nowrap items-center text-secondary">
                <svg src="/rml/icons/UI-return-reload-reset-.svg" class="w-3 flex-none" />
                <p>UI_reset</p>
            </div>
        </div>
        <div id="perks_mt_container" class="flex flex-row gap-1">
            <div class="flex flex-col gap-1">
                <img class="h-6 w-6" data-ui-icon="pc/skills/crewOperations.png" />
                <div id="perks_mt_common" class="flex flex-col gap-1">
                </div>
            </div>
            <div class="flex flex-col gap-1">
                <img class="h-6 w-6" data-ui-icon="pc/skills/commander.png" />
                <div id="perks_mt_commander" class="flex flex-col gap-1">
                </div>
            </div>
            <div class="flex flex-col gap-1">
                <img class="h-6 w-6" data-ui-icon="pc/skills/driver.png" />
                <div id="perks_mt_driver" class="flex flex-col gap-1">
                </div>
            </div>
            <div class="flex flex-col gap-1">
                <img class="h-6 w-6" data-ui-icon="pc/skills/gunner.png" />
                <div id="perks_mt_gunner" class="flex flex-col gap-1">
                </div>
            </div>
            <div class="flex flex-col gap-1">
                <img class="h-6 w-6" data-ui-icon="pc/skills/loader.png" />
                <div id="perks_mt_loader" class="flex flex-col gap-1">
                </div>
            </div>
            <div class="flex flex-col gap-1">
                <img class="h-6 w-6" data-ui-icon="pc/skills/radioman.png" />
                <div id="perks_mt_radioman" class="flex flex-col gap-1">
                </div>
            </div>
        </div>
    </div>
</body>
</template>