<template name="optional_devices_pc" content="">
<head>
	<link type="text/rcss" href="/rml/main.rcss"/>
    <script>
local utils = require ("rml.scripts.utils")

EquipmentSelectorPc = {}
EquipmentSelectorPc.__index = EquipmentSelectorPc

function EquipmentSelectorPc:new(obj)
    setmetatable(obj, self)

    obj.elements = {}
    
    local element_ids = {
        "optional_devices_pc_container", "reset_button_pc", "camo_paint_row", "camo_paint_switch"
    }
    
    for _, id in ipairs(element_ids) do
        obj.elements[id] = obj.document:GetElementById(id)
    end
    
    obj.elements["reset_button_pc"]:AddEventListener("click", function() obj:reset() end)
    
    obj.elements["camo_paint_row"]:AddEventListener("click", function()
        local platform = db_service.platform
        if not obj.vehicle_descr then
            return
        end
        obj.vehicle_descr.camo_paint = not obj.vehicle_descr.camo_paint
        obj:syncCamoPaintUi()
        if obj.on_toggle_equipment then
            obj.on_toggle_equipment()
        end
    end)
    
    return obj
end

function EquipmentSelectorPc:init(vehicle_descr, vehicle_info, original_descr)
    self.vehicle_descr = vehicle_descr
    self.vehicle_info = vehicle_info
    self.original_equipment = EquipmentDescriptor.new((original_descr or self.vehicle_descr).equipment_descriptor)
    self.original_camo_paint = (original_descr or vehicle_descr).camo_paint
    
    self:updateEquipment()
end

function EquipmentSelectorPc:syncCamoPaintUi()
    if not self.vehicle_descr then
        return
    end
    self.elements["camo_paint_switch"]:SetClass("checked", self.vehicle_descr.camo_paint)
end

function EquipmentSelectorPc:getArtefactList(vehicle_info)
    local platform = vehicle_info and vehicle_info.shared.platform

    local result = { device_by_group = {}, group_order = {} }
    local supported_devices = platform and platform:getSupportedOptionalDevices(vehicle_info) or {}
    for device_name, device in pairs(supported_devices) do
        local group = device.archetype
        if device.status ~= PlatformDB.OptionalDevice.Status.TROPHY_BASIC then
            if not result.device_by_group[group] then
                result.device_by_group[group] = {}
                table.insert(result.group_order, group)
            end

            local categories = {}
            for _, category in ipairs(device.categories) do
                table.insert(categories, category)
            end

            table.insert(result.device_by_group[group], { device_name, { id = device.id, status = device.status, categories = categories, archetype = device.archetype, icon = device.icon } })
        end
    end
    
    table.sort(result.group_order, function(a, b)
        local device1 = result.device_by_group[a][1][2]
        local device2 = result.device_by_group[b][1][2]
        return device1.status < device2.status or device1.status == device2.status and result.device_by_group[a][1][1] < result.device_by_group[b][1][1]
    end)
    
    -- Sort devices in each group by device.status
    for group, devices in pairs(result.device_by_group) do
        table.sort(devices, function(a, b)
            return a[2].status < b[2].status
        end)
    end

    return result
end

function EquipmentSelectorPc:updateEquipment()
    local platform = db_service.platform
    
    local is_pc = platform.game_code == "pc" or platform.game_code == "mirtankov" or platform.game_code == "pcmod" or platform.game_code == "mtmod" 
    
    self.elements["optional_devices_pc_container"].parent_node:SetClass("hidden", not is_pc)
       
    local container = self.elements["optional_devices_pc_container"]
    container.inner_rml = ""
    
    if not is_pc then
        return
    end
        
    local artefact_list = self:getArtefactList(self.vehicle_info)
    self.device_by_group = artefact_list.device_by_group
    self.group_order = artefact_list.group_order
    self.device_group_idx = {}
    self.active_categories = {}
    
    for group, devices in pairs(self.device_by_group) do
        self.device_group_idx[group] = 0
        
        for idx, device in ipairs(devices) do
            if self.vehicle_descr.equipment_descriptor:has(device[1]) then
                self.device_group_idx[group] = idx
                break
            end
        end
    end
    
    for _, group in ipairs(self.group_order) do
        local device_container = container:AppendChild(container.owner_document:CreateElement("div"))
        device_container:SetClass("flex-none", true)
        device_container:SetClass("h-6", true)
        device_container:SetClass("relative", true)
        device_container:SetAttribute("data-group", group)
    
        local device_icon = device_container:AppendChild(container.owner_document:CreateElement("img"))
        device_icon:SetClass("w-6", true)
        device_icon:SetClass("h-6", true)
        device_icon:SetClass("box-border", true)
        device_icon:SetClass("icon", true)
        device_icon:SetClass("rounded", true)
        device_icon:SetClass("bg-content-dark", true)
        device_icon:AddEventListener("click", function() 
            if not device_icon:IsClassSet("disabled") then 
                self:selectNextDeviceInGroup(group)
            end 
        end)
        
        local device_overlay = device_container:AppendChild(container.owner_document:CreateElement("img"))
        device_overlay:SetClass("overlay", true)
        device_overlay:SetClass("absolute", true)
        device_overlay:SetClass("hidden", true)
        device_overlay:SetClass("pointer-events-none", true)
        device_overlay.style.left = "12dp"
        device_overlay.style.top = "12dp"
        device_overlay.style.width = "38dp"
        device_overlay.style.height = "38dp"
        device_overlay.style.transform = "translateX(-50%) translateY(-50%)"
        
        local category_overlay = device_container:AppendChild(container.owner_document:CreateElement("img"))
        category_overlay:SetClass("category", true)
        category_overlay:SetClass("absolute", true)
        category_overlay:SetClass("hidden", true)
        category_overlay:SetClass("pointer-events-none", true)
        category_overlay:SetClass("w-6", true)
        category_overlay:SetClass("h-6", true)
        category_overlay:SetClass("left-0", true)
        category_overlay:SetClass("top-0", true)
        category_overlay.style.transform = "translateX(-25%) translateY(-25%)"
        
        self:updateDeviceIcon(group)
    end
    self:updateDeviceStates()
    self:syncCamoPaintUi()
end

function EquipmentSelectorPc:updateDeviceIcon(group)
    local devices = self.device_by_group[group]
    local current_idx = self.device_group_idx[group]
    local device_name = devices[math.max(1, current_idx)][1]
    local status = current_idx > 0 and devices[current_idx][2].status or devices[1][2].status

    local device_icon = self.elements["optional_devices_pc_container"]:QuerySelector('div[data-group="' .. group .. '"] > img')
    device_icon:SetAttribute("src", utils.getOptionalDeviceIcon(db_service.platform, device_name))
    device_icon:SetClass("selected", current_idx > 0)
    
    local device_overlay = self.elements["optional_devices_pc_container"]:QuerySelector('div[data-group="' .. group .. '"]  > img.overlay')
    device_overlay:SetClass("hidden", status == PlatformDB.OptionalDevice.Status.REGULAR)
    
    local device_category = self.elements["optional_devices_pc_container"]:QuerySelector('div[data-group="' .. group .. '"]  > img.category')
    local category_image = status == PlatformDB.OptionalDevice.Status.REGULAR and utils.getOptionalDeviceStatusCategoryImage(self.active_categories[group])
    device_category:SetClass("hidden", not category_image)
    
    if status ~= PlatformDB.OptionalDevice.Status.REGULAR then
        device_overlay:SetAttribute("src", utils.getOptionalDeviceStatusOverlayImage(status))
    elseif category_image then
        device_category:SetAttribute("src", category_image)
    end
end

function EquipmentSelectorPc:selectNextDeviceInGroup(group)
    local devices = self.device_by_group[group]
    local current_idx = self.device_group_idx[group]
    local equipment_descriptor = self.vehicle_descr.equipment_descriptor
    
    if current_idx > 0 then
        local device_name = devices[current_idx][1]
        local device = devices[current_idx][2]
        local had_specialization = equipment_descriptor:has_specialization(device_name)
        
        if device.status == PlatformDB.OptionalDevice.Status.REGULAR and had_specialization then
            self.active_categories[group] = nil
        end
        
        equipment_descriptor:remove(device_name)
        
        if device.status == PlatformDB.OptionalDevice.Status.REGULAR and not had_specialization and self:tryActivateCategory(group, device.categories) then
            equipment_descriptor:add(devices[self.device_group_idx[group]][1], true)
        elseif current_idx >= #devices then
            self.device_group_idx[group] = 0
        else
            self.device_group_idx[group] = current_idx + 1
            equipment_descriptor:add(devices[self.device_group_idx[group]][1], false)
        end
    else
        self.device_group_idx[group] = 1
        equipment_descriptor:add(devices[self.device_group_idx[group]][1], false)
    end
                
    self:updateDeviceIcon(group)
    self:updateDeviceStates()
    
    if self.on_toggle_equipment then
        self.on_toggle_equipment()
    end
end

function EquipmentSelectorPc:updateDeviceStates()
    local platform = self.vehicle_info.shared.platform
    
    for group, group_idx in pairs(self.device_group_idx) do
        local devices = self.device_by_group[group]
        local device_icon = self.elements["optional_devices_pc_container"]:QuerySelector('div[data-group="' .. group .. '"] > img')
        
        local artefact = platform:getOptionalDevice(devices[1][1])
        local is_disabled = group_idx == 0 and not self.vehicle_info:canMountArtefact(self.vehicle_descr.equipment_descriptor, artefact)
        device_icon:SetClass("disabled", is_disabled)
        device_icon.parent_node:SetClass("grayscale", is_disabled)
        device_icon.parent_node:SetClass("opacity-50", is_disabled)
    end
end

function EquipmentSelectorPc:tryActivateCategory(group, categories)
    local active_categories_count = 0
    for _, _ in pairs(self.active_categories) do
        active_categories_count = active_categories_count + 1
    end
    
    if active_categories_count >= 2 then
        return false
    end
    
    for _, category in ipairs(categories) do
        if self.vehicle_info:isEquipmentCategorySupported(category) then
            local is_category_used = false
            for _, active_category in pairs(self.active_categories) do
                if category == active_category then
                    is_category_used = true
                    break
                end
            end
        
            if not is_category_used then
                self.active_categories[group] = category
                return true
            end
        end
    end
    
    return false
end

function EquipmentSelectorPc:reset()
    self.vehicle_descr.equipment_descriptor = EquipmentDescriptor.new(self.original_equipment)
    self.vehicle_descr.camo_paint = self.original_camo_paint
    self:updateEquipment()

    if self.on_toggle_equipment then
        self.on_toggle_equipment()
    end
end

    </script>
</head>
<body>
    <div>
        <div class="flex gap-2 text-xs mb-1 justify-between">
            <p>UI_equipment</p>
            <div id="reset_button_pc" class="flex flex-nowrap items-center text-secondary">
                <svg src="/rml/icons/UI-return-reload-reset-.svg" class="w-3 flex-none" />
                <p>UI_reset</p>
            </div>
        </div>
        <div id="optional_devices_pc_container" class="flex gap-1 flex-wrap">
        </div>
        <div id="camo_paint_row" class="text-sm flex gap-1 items-center text-secondary mt-2">
            <switch id="camo_paint_switch">
                <div class="thumb"></div>
            </switch>
            <p>UI_camo_paint</p>
        </div>
    </div>
</body>
</template>