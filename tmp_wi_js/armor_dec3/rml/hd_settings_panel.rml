<rml>
    <head>
        <title>HD Settings Panel</title>
        <link type="text/template" href="/rml/templates/info_panel.rml" />
        <link type="text/template" href="/rml/templates/button.rml" />
        <script>
HDSettingsPanelHelp = {}
HDSettingsPanelHelp.__index = HDSettingsPanelHelp

local function onHDPackagesSizeChanged(size)
    local self = HDSettingsPanelHelp
    local mbytes = size / 1024.0 / 1024.0
    
    self.elements["description"].inner_rml = fmt("UI_hd_erase_tab_desc", mbytes)
    self.elements["description_button"].inner_rml = fmt("UI_hd_erase_all_desc", mbytes)
end

function HDSettingsPanelHelp:new(o)
    setmetatable(self, {__index = InfoPanel})

    local obj = InfoPanel:new(o)
    setmetatable(obj, self)

    obj:setMainTitle("UI_title_hd_settings")
    obj:setSecondTitle("UI_title_options")

    obj.elements = {}
    
    local element_ids = {
        "description", "description_button"
    }

    for _, id in ipairs(element_ids) do
        obj.elements[id] = obj.document:GetElementById(id)
    end

    HDSettingsPanelHelp = obj
    
    -- connect signals
    data_packages_service:connect_hdPackagesSizeChanged(onHDPackagesSizeChanged)
    
    -- sync ui
    onHDPackagesSizeChanged(data_packages_service.hd_packages_size)
    return obj
end
        </script>
    </head>
    <body id="hd_settings_panel" template="info_panel" onload="HDSettingsPanelHelp:new{document = document}">
        <div class="text-xs">
            <p id="description">UI_hd_erase_tab_desc</p>
            <button class="mt-4 mb-2 w-full flex bg-secondary text-primary-foreground rounded" onclick="data_packages_service:eraseHDPackages()">
                <template src="button">
                    <svg src="/rml/icons/close.svg" class="w-8 flex-none" />
                    <p>UI_hd_erase_all</p>
                </template>
            </button>
            <p id="description_button">UI_hd_erase_all_desc</p>
        </div>
    </body>
</rml>