<rml>
	<head>
		<title>Options Menu</title>
		<link type="text/template" href="/rml/templates/button_icon.rml" />
		<link type="text/template" href="/rml/templates/menu.rml" />
		<script>
OptionsMenu = {}
OptionsMenu.__index = OptionsMenu
setmetatable(OptionsMenu, {__index = Menu})

function OptionsMenu:new(obj)
    local obj = Menu:new(obj)
    setmetatable(obj, self)

    obj.document:GetElementById("content"):SetClass("rounded-r", true)
    obj.elements = {}

    local element_ids = {
        "shop_button", "textures_button"
    }
    
    for _, id in ipairs(element_ids) do
        obj.elements[id] = obj.document:GetElementById(id)
    end

    OptionsMenu = obj
    
    if VERSION_MOD then
        obj.elements["shop_button"]:SetClass("hidden", true)
        obj.elements["textures_button"]:SetClass("hidden", true)
    end
    
    -- connect signals

    -- sync ui
    return obj
end

        </script>
	</head>
	<body id="options_menu" template="menu" style="top:42dp" onload="OptionsMenu:new{document = document}">
        <button class="bg-content text-secondary" onclick="LanguagesTab:toggle()">
            <template src="button_icon">
                <div class="w-8 flex flex-col truncate">
                    <p class="text-xs">UI_icon_language</p>
                    <svg src="/rml/icons/Flag-International-world-1.svg" class="w-8 flex-none" />
                </div>
            </template>
        </button>
        <button id="shop_button" class="bg-content text-secondary" onclick="ShopTab:toggle()">
            <template src="button_icon">
                <div class="w-8 flex flex-col truncate">
                    <p class="text-xs">UI_icon_shop</p>
                    <svg src="/rml/icons/Shop-.svg" class="w-8 flex-none" />
                </div>
            </template>
        </button>
        <button class="bg-content text-secondary" onclick="AboutTab:toggle()">
            <template src="button_icon">
                <div class="w-8 flex flex-col truncate">
                    <p class="text-xs">UI_icon_about</p>
                    <svg src="/rml/icons/UI-Info-.svg" class="w-8 flex-none" />
                </div>
            </template>
        </button>
        <button class="bg-content text-secondary" onclick="ContactsTab:toggle()">
            <template src="button_icon">
                <div class="w-8 flex flex-col truncate">
                    <p class="text-xs">UI_icon_contact</p>
                    <svg src="/rml/icons/UI-Help-.svg" class="w-8 flex-none" />
                </div>
            </template>
        </button>
        <button class="bg-content text-secondary" onclick="AccountTab:toggle()">
            <template src="button_icon">
                <div class="w-8 flex flex-col truncate">
                    <p class="text-xs">UI_icon_account</p>
                    <svg src="/rml/icons/Preferences-Account-.svg" class="w-8 flex-none" />
                </div>
            </template>
        </button>
        <button id="textures_button" class="bg-content text-secondary" onclick="HDSettingsPanelHelp:toggle()">
            <template src="button_icon">
                <div class="w-8 flex flex-col truncate">
                    <p class="text-xs">UI_icon_hd_textures</p>
                    <svg src="/rml/icons/Tank-resolution-HD-.svg" class="w-8 flex-none" />
                </div>
            </template>
        </button>
        <button class="bg-content text-secondary" onclick="RootMenu:open(true)">
            <template src="button_icon">
                <div class="w-8 flex flex-col truncate h-8 justify-between">
                    <p class="text-xs">UI_icon_back</p>
                    <svg src="/rml/icons/UI-Arrow-Right.svg" class="w-3 mb-1 flex-none self-center" crop-to-content="1" />
                </div>
            </template>
        </button>
    </body>
</rml>