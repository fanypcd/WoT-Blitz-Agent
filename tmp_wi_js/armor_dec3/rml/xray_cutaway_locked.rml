<rml>
    <head>
        <title>Xray Locked Panel</title>
        <link type="text/template" href="/rml/templates/info_panel.rml" />
        <link type="text/template" href="/rml/templates/button.rml" />
        <script>
XrayCutawayLocked = {}

local function onViewModeChanged()
    local self = XrayCutawayLocked
    self:updateVisibility()
end

local function onTargetVehicleChanged(old_vehicle, vehicle, vehicle_info)
    local self = XrayCutawayLocked
    self:updateVisibility()
end
    
function XrayCutawayLocked:new(o)
    self.__index = self
    setmetatable(self, {__index = InfoPanel})

    local obj = InfoPanel:new(o)
    setmetatable(obj, self)

    obj:setMainTitle("UI_title_locked")
    obj:setSecondTitle("UI_cutaway_purchase")

    obj.document:GetElementById("header"):SetClass("text-premium", true)
    
    XrayCutawayLocked = obj
    
    -- connect signals
    runOnChange(onViewModeChanged, "scene.viewMode")
    arena_service:connect_targetVehicleChangedSignal(onTargetVehicleChanged)

    -- sync ui
    onTargetVehicleChanged(nil, arena_service.target_vehicle, arena_service.target_vehicle_info)
    return obj
end

function XrayCutawayLocked:checkVisibility()
    local view_mode = settings:getInt("scene.viewMode")
    local target_locked = arena_service.target_vehicle_info and account_service:isVehicleLocked(arena_service.target_vehicle_info.shared, false)
    return (view_mode == ViewMode.CROSS_SECTION_XRAY or view_mode == ViewMode.CROSS_SECTION) and target_locked
end

        </script>
    </head>
    <body id="xray_cutaway_locked" template="info_panel" onload="XrayCutawayLocked:new{document = document}">
        <div class="text-xs">
            <p>UI_paid_content_descr_cutaway_xray</p>
            <button class="mt-1 w-full flex bg-premium text-primary-foreground rounded" onclick="ui_service:navigateToPurchase(IAPService.WOTINSPECTOR_SUB)">
                <template src="button">
                    <svg src="/rml/icons/Shop-.svg" class="w-8 flex-none" />
                    <p>UI_visit_purchases</p>
                </template>
            </button>
        </div>
    </body>
</rml>