<rml>
    <head>
        <title>Xray Info Panel</title>
        <link type="text/template" href="/rml/templates/info_panel.rml" />
        <link type="text/template" href="/rml/templates/button.rml" />
        <link type="text/template" href="/rml/templates/button_icon.rml" />
        <script>
XrayInfoPanel = {}

local Params = require ("rml.scripts.vehicle_params")
local utils = require ("rml.scripts.utils")

local function onTargetVehicleChanged(old_vehicle, vehicle, vehicle_info)
    local self = XrayInfoPanel
    local platform = vehicle_info and vehicle_info.shared and vehicle_info.shared.platform
    local target_name = platform and platform:getTextUTF8(vehicle_info.shared.localized_name) or "UI_not_set"

    self:setMainTitle("<span class='normal-case'>" .. target_name .. "</span>")
    
    if vehicle_info and vehicle_info.shared then
        local max_tier_armor = db_service.platform.getMaxArmorValueByTier(vehicle_info.shared.level)
        local max_vehicle_armor = vehicle_info:getMaxArmorValue(vehicle, false)
        local max_vehicle_spaced_armor = vehicle_info:getMaxArmorValue(vehicle, true)
        
        self.elements["armor95"].inner_rml = fmt("UI_millimeters_range_format", max_tier_armor * 0.8, math.min(max_vehicle_armor, max_tier_armor))
        self.elements["armor75"].inner_rml = fmt("UI_millimeters_range_format", max_tier_armor * 0.6, math.min(max_vehicle_armor, max_tier_armor * 0.8))
        self.elements["armor50"].inner_rml = fmt("UI_millimeters_range_format", max_tier_armor * 0.4, math.min(max_vehicle_armor, max_tier_armor * 0.6))
        self.elements["armor33"].inner_rml = fmt("UI_millimeters_range_format", max_tier_armor * 0.2, math.min(max_vehicle_armor, max_tier_armor * 0.4))
        self.elements["armor0"].inner_rml = fmt("UI_millimeters_range_format", max_tier_armor * 0.0, math.min(max_vehicle_armor, max_tier_armor * 0.2))
        
        self.elements["armor95"].parent_node:SetClass("hidden", max_vehicle_armor < max_tier_armor * 0.8)
        self.elements["armor75"].parent_node:SetClass("hidden", max_vehicle_armor < max_tier_armor * 0.6)
        self.elements["armor50"].parent_node:SetClass("hidden", max_vehicle_armor < max_tier_armor * 0.4)
        self.elements["armor33"].parent_node:SetClass("hidden", max_vehicle_armor < max_tier_armor * 0.2)
        
        self.elements["spaced_armor95"].inner_rml = fmt("UI_millimeters_range_format", max_tier_armor * 0.8, math.min(max_vehicle_spaced_armor, max_tier_armor))
        self.elements["spaced_armor75"].inner_rml = fmt("UI_millimeters_range_format", max_tier_armor * 0.6, math.min(max_vehicle_spaced_armor, max_tier_armor * 0.8))
        self.elements["spaced_armor50"].inner_rml = fmt("UI_millimeters_range_format", max_tier_armor * 0.4, math.min(max_vehicle_spaced_armor, max_tier_armor * 0.6))
        self.elements["spaced_armor33"].inner_rml = fmt("UI_millimeters_range_format", max_tier_armor * 0.2, math.min(max_vehicle_spaced_armor, max_tier_armor * 0.4))
        self.elements["spaced_armor0"].inner_rml = fmt("UI_millimeters_range_format", max_tier_armor * 0.0, math.min(max_vehicle_spaced_armor, max_tier_armor * 0.2))
        
        self.elements["spaced_armor95"].parent_node:SetClass("hidden", max_vehicle_spaced_armor < max_tier_armor * 0.8)
        self.elements["spaced_armor75"].parent_node:SetClass("hidden", max_vehicle_spaced_armor < max_tier_armor * 0.6)
        self.elements["spaced_armor50"].parent_node:SetClass("hidden", max_vehicle_spaced_armor < max_tier_armor * 0.4)
        self.elements["spaced_armor33"].parent_node:SetClass("hidden", max_vehicle_spaced_armor < max_tier_armor * 0.2)
        self:checkForNoModulesPopup()
        
        local effective_values = settings:getInt("ui.specsEffectiveValues")
        for _, param in ipairs(self.document:QuerySelectorAll("p[data-param]")) do
            local value, units, fmt = table.unpack(Params.getItemValue(Params[param:GetAttribute("data-param")], arena_service.target_specs, effective_values))
            if value ~= nil then
                param.inner_rml = Params.format(value, units, fmt)
            end
        end
    end
end

local function onArmorTraced(ray, points, bounding_box)
    local self = XrayInfoPanel
    self.points = points
    self:updateData()
end

local function requestUpdate()
    local self = XrayInfoPanel
    self:updateData()
    self:checkForNoModulesPopup()
end

function XrayInfoPanel:new(o)
    self.__index = self
    setmetatable(self, {__index = InfoPanel})

    local obj = InfoPanel:new(o)
    setmetatable(obj, self)

    obj:setSecondTitle("UI_title_xray")

    obj.elements = {}
    obj.points = {}
    
    local element_ids = {
        "module_information", "module_icon", "module_name", "module_thickness",
        "module_hitpoints", "module_hit_chance", "module_hitpoints_regen",
        "module_expl_hit_chance", "engine_fire_chance",
        "armor95", "armor75", "armor50", "armor33", "armor0",
        "spaced_armor95", "spaced_armor75", "spaced_armor50", "spaced_armor33", "spaced_armor0",
        "primary_armor", "spaced_armor", "external_modules", "internal_modules", "crew",
        "no_modules", "no_modules_text"
    }
    
    for _, id in ipairs(element_ids) do
        obj.elements[id] = obj.document:GetElementById(id)
    end
    
    XrayInfoPanel = obj
    
    -- connect signals
    runOnChange(requestUpdate, "scene.showModules", "scene.armorFilter", "arena.target.hasInternals")
    arena_service:connect_targetVehicleChangedSignal(onTargetVehicleChanged)
    scene_service:connect_armorTracedSignal(onArmorTraced)
    
    -- sync ui
    onTargetVehicleChanged(nil, arena_service.target_vehicle, arena_service.target_vehicle_info)
    return obj
end

function XrayInfoPanel:checkVisibility()
    local view_mode = settings:getInt("scene.viewMode")
    local target_locked = arena_service.target_vehicle_info and account_service:isVehicleLocked(arena_service.target_vehicle_info.shared, false)
    return view_mode == ViewMode.ARMOR or view_mode == ViewMode.CROSS_SECTION_XRAY and not target_locked
end

function XrayInfoPanel:checkForNoModulesPopup()
    local has_internals = settings:getBool("arena.target.hasInternals")
    local show_modules = settings:getBool("scene.showModules")
    if show_modules and not has_internals then
        self:updateVisibility()
    end
end

function XrayInfoPanel:updateArmorFilter(container, is_visible)
    container:QuerySelector(".hide-label").inner_rml = is_visible and "UI_hide" or "UI_show"
    container:QuerySelector(".hide-icon"):SetAttribute("src", "/rml/icons/" .. (is_visible and "chevron-down.svg" or "chevron-left.svg"))
    container:QuerySelector(".legend"):SetClass("opacity-50", not is_visible)
end

function XrayInfoPanel:updateData()
    if not self:checkVisibility() then
        return
    end
    
    local show_modules = settings:getBool("scene.showModules")
    local point
    
    -- module information
    
    if show_modules then
        for _, col_point in ipairs(self.points) do
            if col_point.material and col_point.material.device_type ~= PlatformDB.DeviceType.ARMOR then
                point = col_point
                break
            end
        end
    else
        point = self.points and self.points[1]
    end
        
    local material = point and point.material
    self.elements["module_information"]:SetClass("hidden", not material)
    
    if material then
        local device_type = material.device_type
        local module_name, module_color, module_icon
        local target_info = arena_service.target_vehicle_info
        local health, health_regen
        local effective_values = settings:getInt("ui.specsEffectiveValues")
        
        if device_type == PlatformDB.DeviceType.ARMOR then
            module_name = material.vehicle_damage_factor > 0 and "UI_primary_armor" or "UI_spaced_armor"
        elseif target_info then
            module_name = PlatformDB.getModuleName(material.device_type)
            health, health_regen = Params.getModuleHealth(material.device_type, arena_service.target_specs, effective_values)
        end
        
        if device_type == PlatformDB.DeviceType.ARMOR then
            module_icon = material.vehicle_damage_factor > 0 and "Specs-ArmorPrimary.svg" or "Specs-ArmorSpace.svg"
            module_color = ui_service.palette:getArmorColor(target_info and target_info.shared, material)
            self.elements["module_thickness"].parent_node:SetClass("hidden", false)
            self.elements["module_hitpoints"].parent_node:SetClass("hidden", true)
            self.elements["module_hitpoints_regen"].parent_node:SetClass("hidden", true)
            self.elements["module_hit_chance"].parent_node:SetClass("hidden", true)
            self.elements["module_expl_hit_chance"].parent_node:SetClass("hidden", true)
            self.elements["engine_fire_chance"].parent_node:SetClass("hidden", true)
        else
            module_icon = utils.getModuleIcon(material.device_type)
            module_color = ui_service.palette:getModuleColor(material.device_type)
            self.elements["module_thickness"].parent_node:SetClass("hidden", not PlatformDB.isExternalDevice(device_type))
            self.elements["module_hitpoints"].parent_node:SetClass("hidden", false)
            self.elements["module_hitpoints_regen"].parent_node:SetClass("hidden", PlatformDB.isCrew(device_type))
            self.elements["module_hit_chance"].parent_node:SetClass("hidden", false)
            
            local chance_to_hit_by_projectile = Params.getEffectiveChanceToHit(material, arena_service.target_specs, effective_values)
            self.elements["module_expl_hit_chance"].parent_node:SetClass("hidden", chance_to_hit_by_projectile == material.chance_to_hit_by_explosion)
            self.elements["module_hit_chance"].inner_rml = fmt("UI_percent_format", fmt("{:.0Lf}", chance_to_hit_by_projectile * 100))
            self.elements["module_expl_hit_chance"].inner_rml = fmt("UI_percent_format", fmt("{:.0Lf}", material.chance_to_hit_by_explosion * 100))
            self.elements["module_hitpoints"].inner_rml = fmt("UI_hp_format", fmt("{:.0Lf}", health))
            self.elements["module_hitpoints_regen"].inner_rml = fmt("UI_hp_format", fmt("{:.0Lf}", health_regen))
            
            
            self.elements["engine_fire_chance"].parent_node:SetClass("hidden", device_type ~= PlatformDB.DeviceType.ENGINE)
        end

        self.elements["module_thickness"].inner_rml = fmt("UI_millimeters_format", fmt("{:Lg}", material.armor))
        self.elements["module_icon"]:SetAttribute("src", "/rml/icons/" .. module_icon)
        self.elements["module_name"].inner_rml = module_name
        
        self.elements["module_icon"].parent_node.style["background-color"] = module_color
    end
    
    -- filters
   
    local filters = settings:getInt("scene.armorFilter")
    self:updateArmorFilter(self.elements["primary_armor"], (filters & PlatformDB.ArmorFilterType.PRIMARY_ARMOR) ~= 0)
    self:updateArmorFilter(self.elements["spaced_armor"], (filters & PlatformDB.ArmorFilterType.SPACED_ARMOR) ~= 0)
    self:updateArmorFilter(self.elements["external_modules"], (filters & PlatformDB.ArmorFilterType.EXTERNAL_DEVICE) ~= 0)
    self:updateArmorFilter(self.elements["internal_modules"], (filters & PlatformDB.ArmorFilterType.INTERNAL_DEVICE) ~= 0)
    self:updateArmorFilter(self.elements["crew"], (filters & PlatformDB.ArmorFilterType.CREW) ~= 0)
    
    -- visibility
    
    local has_internals = settings:getBool("arena.target.hasInternals")
    self.elements["primary_armor"]:SetClass("hidden", show_modules)
    self.elements["spaced_armor"]:SetClass("hidden", show_modules)
    self.elements["internal_modules"]:SetClass("hidden", not has_internals or not show_modules)
    self.elements["crew"]:SetClass("hidden", not has_internals or not show_modules)

    self.elements["no_modules"]:SetClass("hidden", has_internals or not show_modules)
    
    local platform = db_service.platform
    if platform then
        self.elements["no_modules_text"].inner_rml = fmt("UI_modules_no_information", (platform.game_code == "mirtankov" or platform.game_code == "tanksblitz" or platform.game_code == "mtmod") and "Lesta" or "Wargaming")
    end
end

function XrayInfoPanel.openHeatmaps()
    HeatmapsMenu:open(false)
    HeatmapsMenu:onModulesButton()
end
        </script>
    </head>
    <body id="xray_info_panel" template="info_panel" onload="XrayInfoPanel:new{document = document}">
        <div class="text-xs">
            <div id="module_information" class="hidden mb-2">
                <div class="flex gap-2 items-center mb-1 text-black p-0_5">
                    <svg id="module_icon" src="/rml/icons/Modules-Ammorack-.svg" class="w-4 flex-none" />
                    <p id="module_name">ammo rack</p>
                </div>
                <div class="flex gap-2 items-end">
                    <p class="flex-1">UI_hit_chance</p>
                    <p id="module_hit_chance">100</p>
                </div>
                <div class="flex gap-2 items-end">
                    <p class="flex-1">UI_explosion_hit_chance</p>
                    <p id="module_expl_hit_chance">100</p>
                </div>
                <div class="flex gap-2 items-end">
                    <p class="flex-1">UI_engine_fire_chance</p>
                    <p id="engine_fire_chance" data-param="EngineFireChance"></p>
                </div>
                <div class="flex gap-2 items-end">
                    <p class="flex-1">UI_thickness</p>
                    <p id="module_thickness">100</p>
                </div>
                <div class="flex gap-2 items-end">
                    <p class="flex-1">UI_hitpoints</p>
                    <p id="module_hitpoints">100</p>
                </div>
                <div class="flex gap-2 items-end">
                    <p class="flex-1 pl-2">UI_hitpoints_repaired</p>
                    <p id="module_hitpoints_regen">100</p>
                </div>
            </div>
            <div id="primary_armor" class="mb-2" onclick='settings:setInt("scene.armorFilter", settings:getInt("scene.armorFilter") ~ PlatformDB.ArmorFilterType.PRIMARY_ARMOR)'>
                <div class="flex items-center mb-1 text-secondary">
                    <svg src="/rml/icons/Specs-ArmorPrimary.svg" class="w-6 flex-none mr-2" />
                    <p class="flex-1 text-sm">UI_primary_armor</p>
                    <p class="hide-label mr-0_5">hide</p>
                    <svg class="hide-icon w-2 flex-none" src="/rml/icons/chevron-down.svg" />
                </div>
                <div class="legend">
                    <div class="flex gap-1 items-end mb-0_5">
                        <div class="w-4 h-4 bg-armor-95 ml-4"></div>
                        <p id="armor95">100 - 200</p>
                    </div>
                    <div class="flex gap-1 items-end mb-0_5">
                        <div class="w-4 h-4 bg-armor-75 ml-4"></div>
                        <p id="armor75">100 - 200</p>
                    </div>
                    <div class="flex gap-1 items-end mb-0_5">
                        <div class="w-4 h-4 bg-armor-50 ml-4"></div>
                        <p id="armor50">100 - 200</p>
                    </div>
                    <div class="flex gap-1 items-end mb-0_5">
                        <div class="w-4 h-4 bg-armor-33 ml-4"></div>
                        <p id="armor33">100 - 200</p>
                    </div>
                    <div class="flex gap-1 items-end mb-0_5">
                        <div class="w-4 h-4 bg-armor-0 ml-4"></div>
                        <p id="armor0">100 - 200</p>
                    </div>
                </div>
            </div>
            <div id="spaced_armor" class="mb-2" onclick='settings:setInt("scene.armorFilter", settings:getInt("scene.armorFilter") ~ PlatformDB.ArmorFilterType.SPACED_ARMOR)'>
                <div class="flex items-center mb-1 text-secondary">
                    <svg src="/rml/icons/Specs-ArmorSpace.svg" class="w-6 flex-none mr-2" />
                    <p class="flex-1 text-sm">UI_spaced_armor</p>
                    <p class="hide-label mr-0_5">hide</p>
                    <svg class="hide-icon w-2 flex-none" src="/rml/icons/chevron-down.svg" />
                </div>
                <div class="legend">
                    <div class="flex gap-1 items-end mb-0_5">
                        <div class="w-4 h-4 bg-spaced-armor-95 ml-4"></div>
                        <p id="spaced_armor95">100 - 200</p>
                    </div>
                    <div class="flex gap-1 items-end mb-0_5">
                        <div class="w-4 h-4 bg-spaced-armor-75 ml-4"></div>
                        <p id="spaced_armor75">100 - 200</p>
                    </div>
                    <div class="flex gap-1 items-end mb-0_5">
                        <div class="w-4 h-4 bg-spaced-armor-50 ml-4"></div>
                        <p id="spaced_armor50">100 - 200</p>
                    </div>
                    <div class="flex gap-1 items-end mb-0_5">
                        <div class="w-4 h-4 bg-spaced-armor-33 ml-4"></div>
                        <p id="spaced_armor33">100 - 200</p>
                    </div>
                    <div class="flex gap-1 items-end mb-0_5">
                        <div class="w-4 h-4 bg-spaced-armor-0 ml-4"></div>
                        <p id="spaced_armor0">100 - 200</p>
                    </div>
                </div>
            </div>
            <div id="external_modules" class="mb-2" onclick='settings:setInt("scene.armorFilter", settings:getInt("scene.armorFilter") ~ PlatformDB.ArmorFilterType.EXTERNAL_DEVICE)'>
                <div class="flex items-center mb-1 text-secondary">
                    <svg src="/rml/icons/Modules-External.svg" class="w-6 flex-none mr-2" />
                    <p class="flex-1 text-sm">UI_external_modules_legend</p>
                    <p class="hide-label mr-0_5">hide</p>
                    <svg class="hide-icon w-2 flex-none" src="/rml/icons/chevron-down.svg" />
                </div>
                <div class="legend">
                    <div class="flex gap-1 items-end mb-0_5">
                        <div class="w-4 h-4 bg-module-track ml-4"></div>
                        <svg class="w-4 self-center flex-none" src="/rml/icons/Modules-Tracks-.svg" />
                        <p class="flex-1">UI_module_track</p>
                        <p data-param="TracksHealth"></p>
                    </div>
                    <div class="flex gap-1 items-end mb-0_5">
                        <div class="w-4 h-4 bg-module-gun ml-4"></div>
                        <svg class="w-4 self-center flex-none" src="/rml/icons/Modules-Gun-.svg" />
                        <p class="flex-1">UI_module_gun</p>
                        <p data-param="GunHealth"></p>
                    </div>
                    <div class="flex gap-1 items-end mb-0_5">
                        <div class="w-4 h-4 bg-module-surveying-device ml-4"></div>
                        <svg class="w-4 self-center flex-none" src="/rml/icons/TankSelector-Equipment-CoatedOptics.svg" />
                        <p class="flex-1">UI_module_surveying_device</p>
                        <p data-param="SurveyingDeviceHealth"></p>
                    </div>
                </div>
            </div>
            <div id="no_modules" class="mb-2 space-y-2">
                <p id="no_modules_text"></p>
                <p>UI_modules_try_heatmaps</p>
                <button class="flex bg-secondary text-primary-foreground rounded" onclick="XrayInfoPanel.openHeatmaps()">
                    <template src="button">
                        <p>UI_open_heatmaps</p>
                    </template>
                </button>
            </div>
            <div id="internal_modules" class="mb-2" onclick='settings:setInt("scene.armorFilter", settings:getInt("scene.armorFilter") ~ PlatformDB.ArmorFilterType.INTERNAL_DEVICE)'>
                <div class="flex items-center mb-1 text-secondary">
                    <svg src="/rml/icons/Modules-.svg" class="w-6 flex-none mr-2" />
                    <p class="flex-1 text-sm">UI_internal_modules_legend</p>
                    <p class="hide-label mr-0_5">hide</p>
                    <svg class="hide-icon w-2 flex-none" src="/rml/icons/chevron-down.svg" />
                </div>
                <div class="legend">
                    <div class="flex gap-1 items-end mb-0_5">
                        <div class="w-4 h-4 bg-module-fuel-tank ml-4"></div>
                        <svg class="w-4 self-center flex-none" src="/rml/icons/Modules-GasTank-1.svg" />
                        <p class="flex-1">UI_module_fuel_tank</p>
                        <p data-param="FuelTankHealth"></p>
                    </div>
                    <div class="flex gap-1 items-end mb-0_5">
                        <div class="w-4 h-4 bg-module-engine ml-4"></div>
                        <svg class="w-4 self-center flex-none" src="/rml/icons/Modules-Engine-1.svg" />
                        <p class="flex-1">UI_module_engine</p>
                        <p data-param="EngineHealth"></p>
                    </div>
                    <div class="flex gap-1 items-end mb-0_5">
                        <div class="w-4 h-4 bg-module-ammo-bay ml-4"></div>
                        <svg class="w-4 self-center flex-none" src="/rml/icons/Modules-Ammorack-.svg" />
                        <p class="flex-1">UI_module_ammo_bay</p>
                        <p data-param="AmmorackHealth"></p>
                    </div>
                    <div class="flex gap-1 items-end mb-0_5">
                        <div class="w-4 h-4 bg-module-turret-rotator ml-4"></div>
                        <svg class="w-4 self-center flex-none" src="/rml/icons/modules-turret-3.svg" />
                        <p class="flex-1">UI_module_turret_rotator</p>
                        <p data-param="TurretHealth"></p>
                    </div>
                    <div class="flex gap-1 items-end mb-0_5">
                        <div class="w-4 h-4 bg-module-radio ml-4"></div>
                        <svg class="w-4 self-center flex-none" src="/rml/icons/Modules-Radio-1.svg" />
                        <p class="flex-1">UI_module_radio</p>
                        <p data-param="RadioHealth"></p>
                    </div>
                </div>
            </div>
            <div id="crew" class="mb-2" onclick='settings:setInt("scene.armorFilter", settings:getInt("scene.armorFilter") ~ PlatformDB.ArmorFilterType.CREW)'>
                <div class="flex items-center mb-1 text-secondary">
                    <svg src="/rml/icons/Modules-Crew.svg" class="w-6 flex-none mr-2" />
                    <p class="flex-1 text-sm">UI_crew_legend</p>
                    <p class="hide-label mr-0_5">hide</p>
                    <svg class="hide-icon w-2 flex-none" src="/rml/icons/chevron-down.svg" />
                </div>
                <div class="legend">
                    <div class="flex gap-1 items-end mb-0_5">
                        <div class="w-4 h-4 bg-module-driver ml-4"></div>
                        <svg class="w-4 self-center flex-none" src="/rml/icons/modules-Crew-Driver-2.svg" />
                        <p>UI_crew_driver</p>
                    </div>
                    <div class="flex gap-1 items-end mb-0_5">
                        <div class="w-4 h-4 bg-module-gunner ml-4"></div>
                        <svg class="w-4 self-center flex-none" src="/rml/icons/modules-Crew-Gunner-1.svg" />
                        <p>UI_crew_gunner</p>
                    </div>
                    <div class="flex gap-1 items-end mb-0_5">
                        <div class="w-4 h-4 bg-module-loader ml-4"></div>
                        <svg class="w-4 self-center flex-none" src="/rml/icons/modules-Crew-LoaderAmmo-1.svg" />
                        <p>UI_crew_loader</p>
                    </div>
                    <div class="flex gap-1 items-end mb-0_5">
                        <div class="w-4 h-4 bg-module-commander ml-4"></div>
                        <svg class="w-4 self-center flex-none" src="/rml/icons/modules-Crew-Commander-1.svg" />
                        <p>UI_crew_commander</p>
                    </div>
                    <div class="flex gap-1 items-end mb-0_5">
                        <div class="w-4 h-4 bg-module-radioman ml-4"></div>
                        <svg class="w-4 self-center flex-none" src="/rml/icons/modules-Crew-Radioman-1.svg" />
                        <p>UI_crew_radioman</p>
                    </div>
                </div>
            </div>
        </div>
    </body>
</rml>