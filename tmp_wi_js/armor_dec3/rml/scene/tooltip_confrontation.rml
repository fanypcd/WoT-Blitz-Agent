<rml>
    <head>
        <title>Confrontation Tooltip</title>
        <link type="text/template" href="/rml/templates/tooltip.rml" />
        <script>
ConfrontationTooltip = {}

local utils = require('rml.scripts.utils')

local function onViewModeChanged()
    ConfrontationTooltip:updateVisibility()
end

local function onTooltipUpdated(pen_chance, effective_thickness, has_ricochet, modules_mask, internal_travel_distance)
    local self = ConfrontationTooltip
    
    self.pen_chance = pen_chance
    self.effective_thickness = math.min(999, effective_thickness)
    self.has_ricochet = has_ricochet
    self.modules_mask = modules_mask
    self.internal_travel_distance = internal_travel_distance or 0.0
    self:updateTooltip()
end

function ConfrontationTooltip:new(o)
    self.__index = self
    setmetatable(self, {__index = Tooltip})

    local obj = Tooltip:new(o)
    setmetatable(obj, self)

    obj:setHeader([[
    <div class="flex gap-2 items-center">
        <svg id="header_pen_result_icon" src="/rml/icons/Event-PenNO-Bounce.svg" class="w-8 flex-none" />
        <p id="header_pen_chance">100%</p>
    </div>
    ]])

    ConfrontationTooltip = obj
    obj.damage_he_min = 0
    obj.damage_he_max = 0
    obj.damage_he_avg = 0
    obj.pen_chance = 0
    obj.effective_thickness = 0
    obj.has_ricochet = false
    obj.modules_mask = 0
    obj.internal_travel_distance = 0.0
    
    -- connect signals
    runOnChange(onViewModeChanged, "scene.viewMode")
    scene_service:connect_damageHECalculatedSignal(function(damage_min, damage_max, damage_avg)
        local self = ConfrontationTooltip
        self.damage_he_min = damage_min
        self.damage_he_max = damage_max
        self.damage_he_avg = damage_avg
        self:updateTooltip()
    end)
    confrontation_scene_objects:connect_tooltipUpdatedSignal(onTooltipUpdated)
end

function ConfrontationTooltip:checkVisibility()
    if not Tooltip.checkVisibility(self) then
        return false
    end

    local view_mode = settings:getInt("scene.viewMode")
    return view_mode == ViewMode.PENETRATION or view_mode == ViewMode.CROSS_SECTION
end

function ConfrontationTooltip:updateTooltip()
    self.document:GetElementById("header_pen_chance").inner_rml = fmt("{:.0Lf}<small>%</small>", self.pen_chance * 100.0)
    self.document:GetElementById("effective_thickness").inner_rml = fmt("UI_millimeters_format", fmt("{:.0Lf}", self.effective_thickness))
    self.document:GetElementById("thickness_icon"):SetAttribute("src", self.has_ricochet and "/rml/icons/Specs-Armor-ThicknessNominal-.svg" or "/rml/icons/Specs-Armor-ThicknessEffective-.svg")
    
    local damage_he_min = self.damage_he_min
    local damage_he_max = self.damage_he_max
    local platform = db_service.platform
    local damage_distribution = platform and platform.damage_distribution or 0.25

    local shell_properties = arena_service.shell_properties
    local he_shell = PlatformDB.isHEShell(shell_properties.shell.kind)
    local damage_he_avg = 0.0
    if he_shell then
        local damage_armor_nominal = shell_properties.shell.damage_armor
        damage_he_avg = self.pen_chance * damage_armor_nominal + (1.0 - self.pen_chance) * self.damage_he_avg

        if self.pen_chance >= 1.0 then
            damage_he_min = damage_armor_nominal * (1.0 - damage_distribution)
            damage_he_max = damage_armor_nominal * (1.0 + damage_distribution)
        elseif self.pen_chance > 0.0 then
            damage_he_max = damage_armor_nominal * (1.0 + damage_distribution)
        end
    end

    if damage_he_max > 0.0 and he_shell then
        self.document:GetElementById("damage_row"):SetClass("hidden", false)
        self.document:GetElementById("damage_avg_row"):SetClass("hidden", false)
        self.document:GetElementById("damage").inner_rml = fmt("UI_damage_range_format", damage_he_min, damage_he_max)
        self.document:GetElementById("damage_avg").inner_rml = fmt("UI_avg") .. " " .. fmt("UI_hp_format", fmt("{:.0Lf}", damage_he_avg))
    else
        self.document:GetElementById("damage_avg_row"):SetClass("hidden", true)
        local has_distance_damage = shell_properties.shell.has_distance_damage
        if has_distance_damage and self.internal_travel_distance and self.internal_travel_distance > 0.0 and self.pen_chance > 0.0 then
            local distance = settings:getFloat("scene.distance")
            local damage_armor = shell_properties:getDamageArmorForDistance(self.internal_travel_distance or 0.0, distance)
            self.document:GetElementById("damage_row"):SetClass("hidden", false)
            self.document:GetElementById("damage").inner_rml = fmt("UI_hp_format", fmt("{:.0Lf}", damage_armor))
        else
            self.document:GetElementById("damage_row"):SetClass("hidden", true)
        end
    end

    if self.has_ricochet then
        self.document:GetElementById("header_pen_result_icon"):SetAttribute("src", "/rml/icons/Events-Armor-ricochetYES-.svg")
        self.document:GetElementById("header_pen_chance").inner_rml = "UI_pen_ricochet"
    elseif self.pen_chance <= 0.0 then
        self.document:GetElementById("header_pen_result_icon"):SetAttribute("src", "/rml/icons/Event-PenNO-Bounce.svg")
    else
        self.document:GetElementById("header_pen_result_icon"):SetAttribute("src", "/rml/icons/Event-Penetration-3.svg")
    end
    
    local modules_container = self.document:GetElementById("modules")
    modules_container:SetClass("hidden", self.modules_mask == 0)
    modules_container.inner_rml = ''
    for module =  1, PlatformDB.DeviceType.MAX_DEVICES do
        if self.modules_mask & (1 << module) ~= 0 then
            local module_icon = utils.getModuleIcon(module)
            local icon_element = self.document:CreateElement("svg")
            icon_element = modules_container:AppendChild(icon_element)
            icon_element:SetClass("w-8", true)
            icon_element:SetAttribute("src", "/rml/icons/" .. module_icon)            
            -- icon_element.style["image-color"] = ui_service.palette:getModuleColor(module)
        end
    end
end
        </script>
    </head>
    <body id="tooltip_confrontation" template="tooltip" onload="ConfrontationTooltip:new{document = document}">
        <div class="flex gap-2 items-center">
            <svg id="thickness_icon" src="/rml/icons/Specs-Armor-ThicknessEffective-.svg" class="w-8 flex-none" />
            <p id="effective_thickness">1000</p>
        </div>
        <div id="damage_row" class="flex gap-2 items-center">
            <svg src="/rml/icons/Event-Damage-target.svg" class="w-8 flex-none" />
            <p id="damage">1000</p>
        </div>
        <div id="damage_avg_row" class="flex gap-2 items-center whitespace-nowrap">
            <svg src="/rml/icons/Event-Damage-target.svg" class="w-8 flex-none" />
            <p id="damage_avg">1000</p>
        </div>
        <div id="modules" class="flex gap-2 items-center">
        </div>
    </body>
</rml>