<rml>
    <head>
        <title>Heatmaps Locked Panel</title>
        <link type="text/template" href="/rml/templates/info_panel.rml" />
        <link type="text/template" href="/rml/templates/button.rml" />
        <script>
HeatmapsPanelLocked = {}

local function onViewModeChanged()
    local self = HeatmapsPanelLocked
    self:updateVisibility()
end

local function onTargetVehicleChanged(old_vehicle, vehicle, vehicle_info)
    local self = HeatmapsPanelLocked
    self:updateVisibility()
end

local function onVehicleUnlocked(vehicle_id)
    local self = HeatmapsPanelLocked
    self:updateVisibility()
end
    
function HeatmapsPanelLocked:new(o)
    self.__index = self
    setmetatable(self, {__index = InfoPanel})

    local obj = InfoPanel:new(o)
    setmetatable(obj, self)

    obj:setMainTitle("UI_title_locked")
    obj:setSecondTitle(fmt("UI_title_heatmaps") .. '<span class="text-black bg-beta px-1 ml-1">' .. fmt("UI_beta_badge") .. '</span>')

    obj.elements = {}
    
    local label_ids = {
    }
    
    for _, id in ipairs(label_ids) do
        obj.elements[id] = obj.document:GetElementById(id)
    end
    
    HeatmapsPanelLocked = obj
    
    -- connect signals
    runOnChange(onViewModeChanged, "scene.viewMode")
    arena_service:connect_targetVehicleChangedSignal(onTargetVehicleChanged)
    account_service:connect_vehicleUnlockedSignal(onVehicleUnlocked)

    -- sync ui
    onTargetVehicleChanged(nil, arena_service.target_vehicle, arena_service.target_vehicle_info)
    return obj
end

function HeatmapsPanelLocked:checkVisibility()
    local view_mode = settings:getInt("scene.viewMode")
    local target_locked = arena_service.target_vehicle_info and account_service:isVehicleLocked(arena_service.target_vehicle_info.shared, false)
    return view_mode == ViewMode.HEATMAP and target_locked
end

        </script>
    </head>
    <body id="heatmaps_panel_locked" template="info_panel" onload="HeatmapsPanelLocked:new{document = document}">
        <div class="text-xs">
            <p>UI_paid_content_descr_heatmaps</p>
            <button class="mt-3 w-full flex bg-secondary text-primary-foreground rounded" onclick="UnlockDialog.open()">
                <template src="button">
                    <svg src="/rml/icons/UI-smiley-.svg" class="w-8 flex-none" />
                    <p>UI_unlock_with_ad</p>
                </template>
            </button>
            <button class="mt-1 w-full flex bg-premium text-primary-foreground rounded" onclick="ui_service:navigateToPurchase(IAPService.WOTINSPECTOR_SUB)">
                <template src="button">
                    <svg src="/rml/icons/Shop-.svg" class="w-8 flex-none" />
                    <p>UI_subscribe_now</p>
                </template>
            </button>
        </div>
    </body>
</rml>