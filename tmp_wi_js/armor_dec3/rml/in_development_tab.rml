<rml>
    <head>
        <title>In Development Tab</title>
        <link type="text/template" href="/rml/templates/info_panel.rml" />
        <link type="text/template" href="/rml/templates/button.rml" />
        <script>
InDevelopmentTab = {}

function InDevelopmentTab:new(o)
    self.__index = self
    setmetatable(self, {__index = InfoPanel})

    local obj = InfoPanel:new(o)
    setmetatable(obj, self)

    obj:setMainTitle("UI_in_development")
    
    InDevelopmentTab = obj
    return obj
end

function InDevelopmentTab:open(subtitle)
    self:setSecondTitle(subtitle)
	InfoPanel.open(self)
end
        </script>
    </head>
    <body id="in_development_tab" template="info_panel" onload="InDevelopmentTab:new{document = document}">
        <p class="text-xs">UI_in_development_description</p>
        <p class="text-xs mt-4">UI_join_discord_description</p>
        <button class="mt-3 w-full flex bg-secondary text-primary-foreground rounded" onclick="game:launchURL('https://discord.gg/TkPjTRc')">
            <template src="button">
                <svg src="/rml/icons/discord.svg" class="w-8 flex-none" />
                <p>UI_discord</p>
            </template>
        </button>
    </body>
</rml>