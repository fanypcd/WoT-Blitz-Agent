<rml>
    <head>
        <title>Languages Tab</title>
        <link type="text/template" href="/rml/templates/info_panel.rml" />
        <link type="text/template" href="/rml/templates/button.rml" />
        <style>
            select {
                height: 32dp;
            }

            select selectvalue{
                height: 24dp;
            }

            select selectarrow {
                display: block;
            }
        </style>
        <script>
LanguagesTab = {}
LanguagesTab.__index = LanguagesTab

function LanguagesTab:new(o)
    setmetatable(self, {__index = InfoPanel})

    local obj = InfoPanel:new(o)
    setmetatable(obj, self)

    obj:setMainTitle("UI_language")
    obj:setSecondTitle("UI_title_options")

    obj.elements = {}
    
    local element_ids = {
        "language_select"
    }

    for _, id in ipairs(element_ids) do
        obj.elements[id] = obj.document:GetElementById(id)
    end

    LanguagesTab = obj
    
    -- connect signals
    
    -- sync ui
    local language_select = Element.As["ElementFormControlSelect"](obj.elements["language_select"])
    for idx, child in ipairs(language_select.options) do
        if child.value == settings:getString("app.language") then
            language_select.selection = idx
            break
        end
    end
    
    obj.initialized = true
    return obj
end

function LanguagesTab:setLanguage(lang)
    if obj.initialized then
        settings:setString("app.language", lang)
    end
end

        </script>
    </head>
    <body id="language_tab" template="info_panel" onload="LanguagesTab:new{document = document}">
        <div class="text-xs">
            <p>UI_select_language</p>
            <select id="language_select" class="mt-1 h-8 w-full p-1 box-border text-base" onchange='settings:setString("app.language", event.parameters["value"])'>
                <option value="en" class="h-8 p-1 box-border">
                    <div class="flex items-center h-full">
                        <p>English</p>
                    </div>
                </option>
                <option value="ru" class="h-8 p-1 box-border">
                    <div class="flex items-center h-full">
                        <p>Русский</p>
                    </div>
                </option>
                <option value="uk" class="h-8 p-1 box-border">
                    <div class="flex items-center h-full">
                        <p>Українська</p>
                    </div>
                </option>
                <option value="pl" class="h-8 p-1 box-border">
                    <div class="flex items-center h-full">
                        <p>Polski</p>
                    </div>
                </option>
                <option value="de" class="h-8 p-1 box-border">
                    <div class="flex items-center h-full">
                        <p>Deutsch</p>
                    </div>
                </option>
                <option value="fr" class="h-8 p-1 box-border">
                    <div class="flex items-center h-full">
                        <p>Français</p>
                    </div>
                </option>
                <option value="es" class="h-8 p-1 box-border">
                    <div class="flex items-center h-full">
                        <p>Español</p>
                    </div>
                </option>
                <option value="it" class="h-8 p-1 box-border">
                    <div class="flex items-center h-full">
                        <p>Italiano</p>
                    </div>
                </option>
                <option value="pt" class="h-8 p-1 box-border">
                    <div class="flex items-center h-full">
                        <p>Português</p>
                    </div>
                </option>
                <option value="cs" class="h-8 p-1 box-border">
                    <div class="flex items-center h-full">
                        <p>Česky</p>
                    </div>
                </option>
                <option value="tr" class="h-8 p-1 box-border">
                    <div class="flex items-center h-full">
                        <p>Türkçe</p>
                    </div>
                </option>
                <option value="zh_Hans" class="h-8 p-1 box-border">
                    <div class="flex items-center h-full">
                        <p>中文</p>
                    </div>
                </option>
                <option value="ja" class="h-8 p-1 box-border">
                    <div class="flex items-center h-full">
                        <p>日本語</p>
                    </div>
                </option>
            </select>
            <p>* <span>UI_language_help</span></p>
            <p class="mt-4 mb-1">UI_help_us_translate</p>
            <button class="w-full flex bg-secondary text-primary-foreground rounded" onclick="game:launchURL('https://crowdin.com/project/wotinspector')">
                <template src="button">
                    <svg src="/rml/icons/Flag-International-world-1.svg" class="w-6 flex-none" />
                    <p>UI_translate_the_app</p>
                </template>
            </button>
        </div>
    </body>
</rml>