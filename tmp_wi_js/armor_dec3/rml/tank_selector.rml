<rml>
	<head>
		<title>Tank Selector</title>
		<link type="text/template" href="/rml/templates/window.rml" />
		<link type="text/template" href="/rml/templates/button.rml" />
		<link type="text/template" href="/rml/templates/button_icon.rml" />
		<style>
			body {
				width: 90%;
				max-height: 90%;
			}

            .tiers > p {
                height: 16.5dp;
            }

            select {
                height: 32dp;
            }

            select selectvalue{
                height: 32dp;
            }
            
            select selectarrow {
                display: block;
            }
            
            #role_filters img:not(.text-secondary) {
                image-color: #9b9b9b;
            }

            #nations_reforged img:not(.text-secondary) {
                image-color: #888;
            }

            #nations_reforged img.text-secondary {
                image-color: #fff;
            }
        </style>
		<script>
TankSelector = {}
TankSelector.__index = TankSelector

local utils = require ("rml.scripts.utils")

local function onPlatformChanged(platform)
	local self = TankSelector
    
    if platform then
        local is_reforged = platform.game_code == "reforged"
        self.elements["nations_pc"]:SetClass("hidden", is_reforged)
        self.elements["nations_reforged"]:SetClass("hidden", not is_reforged)

        if is_reforged then
            self:rebuildReforgedNationButtons(platform)
        else
            local nation_idx = 0
            local nation_element

            repeat
                nation_element = self.elements["nation" .. nation_idx]

                if nation_element then
                    nation_element:SetClass("hidden", not platform:hasVehicles(nation_idx))
                    nation_idx = nation_idx + 1
                end
            until nation_element == nil
        end

        self.nation_mask = 0

        self.elements["type4"]:SetClass("hidden", not platform.has_spg_class)

        local tier = 3
        local tier_element
        
        repeat
            tier_element = self.elements["tier" .. tier]
            
            if tier_element then
                tier_element:SetClass("hidden", tier > platform.max_tier)
                tier = tier + 1
            end
        until tier_element == nil
        
        self.new_vehicles = platform.new_vehicles
        self.elements["new"]:SetClass("hidden", #self.new_vehicles == 0)
       
        -- update platform inside select
        local option_index = 0
        local found = false
        for _, game_code in ipairs(utils.getPlatformCodes()) do
            for i = 0, db_service.platform_count - 1 do
                local option_platform = db_service:getPlatform(i)
                if option_platform.game_code == game_code then
                    option_index = option_index + 1
                    if option_platform.short_name == platform.short_name then
                        self.platform_select_guard = true
                        Element.As["ElementFormControlSelect"](self.elements["platform_select"]).selection = option_index
                        self.platform_select_guard = false
                        found = true
                        break
                    end
                end
            end
            if found then
                break
            end
        end

        self.elements["tier1-2"]:SetClass("hidden", is_reforged)
        self.elements["tier3"]:SetClass("hidden", is_reforged)
        self.elements["tier1-3"]:SetClass("hidden", not is_reforged)

        if self.is_opened then
            self:rebuildList()
        end
	end

    self.elements["role_filters"]:SetClass("hidden", not platform or platform.game_code ~= "pc" and platform.game_code ~= "mirtankov")
    -- self.elements["role_flame"]:SetClass("hidden", not platform or platform.game_code ~= "mirtankov")
end

local function onPlatformListChanged()
	local self = TankSelector

    local platform_template = [[
        <div class="flex gap-2 items-center h-8 px-1">
            <svg src="/rml/icons/AI-platform-Blitz-.svg" class="w-8 flex-none" />
            <p class="text-sm mt-1 leading-none"></p>
        </div>
    ]]
    
    local container = self.elements["platform_select"]
    Element.As["ElementFormControlSelect"](container):RemoveAll()
    
    local current_platform = db_service.platform
    local current_selection = -1
    local option_index = 0
    
    for _, game_code in ipairs(utils.getPlatformCodes()) do
        for i = 0, db_service.platform_count - 1 do
            local platform = db_service:getPlatform(i)
            if platform.game_code == game_code then
                local option = container:AppendChild(self.document:CreateElement("option"))
                option.inner_rml = platform_template
                option:SetAttribute("value", i)
                
                option:QuerySelector("svg"):SetAttribute("src", "/rml/icons/" .. utils.getPlatformIcon(platform.game_code))
                option:QuerySelector("p").inner_rml = platform.version
                
                option_index = option_index + 1
                if current_platform and platform.short_name == current_platform.short_name then
                    current_selection = option_index
                end
            end
        end
    end
    
    if current_selection >= 0 then
        self.platform_select_guard = true
        Element.As["ElementFormControlSelect"](container).selection = current_selection
        self.platform_select_guard = false
    end
end

function TankSelector:new(obj)
    setmetatable(obj, self)
    TankSelector = obj
    
    obj.document:SetClass("h-full", true)
    obj.document:SetClass("flex", true)
    obj.document:SetClass("flex-col", true)
    local content = obj.document:GetElementById("content")
    content:SetClass("flex-1", true)
    content:SetClass("flex", true)
    content:SetClass("gap-2", true)
    content:SetClass("p-2", true)

	local rml = [[
        <div class="flex justify-between items-center font-light text-xl">
            <select id="platform_select" class="my-auto" style="min-width:220dp" onchange='TankSelector:onPlatformSelect(event.parameters["value"])'>
            </select>
            <svg src="/rml/icons/UI-return-reload-reset-.svg" class="w-6 flex-none text-secondary" onclick="TankSelector:onResetButton()" />
        </div>
    ]]

    local title_element = obj.document:GetElementById("title").parent_node
    title_element:SetClass("flex-1", true)
    title_element.inner_rml = rml

    obj.elements = {}
    obj.tier_mask = 0
    obj.nation_mask = 0
    obj.type_mask = 0
    obj.status_mask = 0
    obj.role_mask = 0
    obj.new_vehicles = {}
    obj.platform_select_guard = false
    obj.reforged_nation_elements = {}

    local element_ids = {
        "nation0", "nation1", "nation2", "nation3", "nation4",
        "nation5", "nation6", "nation7", "nation8", "nation9",
        "nation10", "nation11", "nation12", "nation13", "nation14",
        "tier1-2", "tier1-3", "tier3", "tier4", "tier5", "tier6",
        "tier7", "tier8", "tier9", "tier10", "tier11",
        "type0", "type1", "type2", "type3", "type4",
        "regular", "premium", "reward", "hidden", "new",
        "vehicles", "vehicle_info",
        "platform_select", "vehicles_empty",
        "nations_pc", "nations_reforged",
        "tank_image", "tank_name", "tank_tier", "tank_type", "tank_nation_svg", "tank_nation_img", "tank_status", "tank_flag",
        "role_filters", "role_assault", "role_break", "role_sniper", "role_support", "role_universal", 
        "role_wheeled", "role_flame", "tank_role_icon", "tank_role_name"
    }

    for _, id in ipairs(element_ids) do
        obj.elements[id] = obj.document:GetElementById(id)
    end

    -- connect signals
    db_service:connect_platformChangedSignal(onPlatformChanged)
    db_service:connect_platformListChangedSignal(onPlatformListChanged)

    -- sync ui
    onPlatformListChanged()
    onPlatformChanged(db_service.platform)
    return o
end

function TankSelector:open(vehicle_descr, on_select)
    self.document:Show()
    self.is_opened = true
    self.on_select = on_select

    self.vehicle_descr = vehicle_descr
    local platform = db_service.platform 
    if platform then
        self:selectVehicle(vehicle_descr, nil)            
        if self.vehicle_info then
            self.tier_mask = 1 << math.max(self.vehicle_info.shared.level - 1, 0)
            self.type_mask = 1 << self.vehicle_info.shared.type
            -- self.nation_mask = 1 << platform:getNationById(self.vehicle_info.shared.id)
        end
    else
        self.specs = nil
        self.vehicle_info = nil
    end

    self:rebuildList()
end

function TankSelector:close()
    self.document:Hide()
    self.is_opened = false
end

function TankSelector:setNationIconElements(svg_element, img_element, icon_path)
    if not icon_path then
        if svg_element then
            svg_element:SetClass("hidden", true)
        end
        if img_element then
            img_element:SetClass("hidden", true)
        end
        return
    end

    if utils.isRasterIcon(icon_path) then
        if svg_element then
            svg_element:SetClass("hidden", true)
        end
        if img_element then
            img_element:SetAttribute("src", utils.resolveUiIcon(icon_path))
            img_element:SetClass("hidden", false)
        end
    else
        if img_element then
            img_element:SetClass("hidden", true)
        end
        if svg_element then
            svg_element:SetAttribute("src", icon_path)
            svg_element:SetClass("hidden", false)
        end
    end
end

function TankSelector:rebuildReforgedNationButtons(platform)
    local container = self.elements["nations_reforged"]
    container.inner_rml = ""
    self.reforged_nation_elements = {}

    local nations_present = {}
    local vehicles = platform:filterVehicles(-1, -1, -1, function() return true end, -1)
    for _, vehicle_info in ipairs(vehicles) do
        nations_present[platform:getNationById(vehicle_info.id)] = true
    end

    for nation = 1, 37 do
        if nations_present[nation] and platform:hasVehicles(nation) then
            local icon = utils.getNationIcon(platform, nation)
            if icon then
                local button = container:AppendChild(self.document:CreateElement("img"))
                button:SetAttribute("src", icon)
                button:SetClass("w-6", true)
                button:SetClass("h-6", true)
                button:SetClass("flex-none", true)
                button:SetClass("my-auto", true)
                button:AddEventListener("click", function() self:onToggleFilter("nation_mask", nation) end)
                self.reforged_nation_elements[nation] = button
            end
        end
    end
end

function TankSelector:onToggleFilter(mask_name, index)
    if mask_name == "status_mask" and index >= 3 and self.status_mask & (1 << index) == 0 then
        -- reset other filters when turning on new
        self.tier_mask = 0
        self.type_mask = 0
        self.nation_mask = 0
        self.status_mask = 1 << index
    elseif self[mask_name] ~= 1 << index then
        self[mask_name] = 1 << index
    else
        self[mask_name] = 0
    end
    
    self:rebuildList()
end

function TankSelector:filterByStatus(vehicle_info)
    if self.status_mask & (1 << 4) ~= 0 then
        if table.find(self.new_vehicles, vehicle_info.id) == nil then
            return false
        end
        return true
    end

    if self.status_mask & 0xf == 0 then
        return not vehicle_info.is_hidden
    end

    if vehicle_info.is_hidden then
        if self.status_mask & (1 << 3) == 0 then
            return false
        end
    elseif vehicle_info.is_collectible then
        if self.status_mask & (1 << 2) == 0 then
            return false
        end
    elseif vehicle_info.is_premium then
        if self.status_mask & (1 << 1) == 0 then
            return false
        end
    else
        if self.status_mask & (1 << 0) == 0 then
            return false
        end
    end

    return true
end

function TankSelector:getVehicleRoleTag(vehicle_info)
    if not vehicle_info or not vehicle_info.tags then
        return nil, nil
    end

    local role_tag
    for _, tag in pairs(vehicle_info.tags) do
        if tag:find("^role_") then
            role_tag = tag
            break
        end
    end
    
    return role_tag, role_tag and string.match(role_tag, ".*_(.+)$")
end

function TankSelector:filterByRole(vehicle_info)
    if self.role_mask == 0 then
        return true
    end
    
    local role_tag, role = self:getVehicleRoleTag(vehicle_info)
    if role_tag then
        if role == "assault" then
            if self.role_mask & (1 << 0) ~= 0 then
                return true
            end
        elseif role == "break" then
            if self.role_mask & (1 << 1) ~= 0 then
                return true
            end
        elseif role == "sniper" then
            if self.role_mask & (1 << 2) ~= 0 then
                return true
            end
        elseif role == "support" then
            if self.role_mask & (1 << 3) ~= 0 then
                return true
            end
        elseif role == "universal" then
            if self.role_mask & (1 << 4) ~= 0 then
                return true
            end
        elseif role == "wheeled" then
            if self.role_mask & (1 << 5) ~= 0 then
                return true
            end
        elseif role == "flame" then
            if self.role_mask & (1 << 6) ~= 0 then
                return true
            end
        end
    end
    
    return false
end

function TankSelector:filterVehicle(vehicle_info)
    return self:filterByStatus(vehicle_info) and self:filterByRole(vehicle_info)
end

function TankSelector:selectVehicle(vehicle_descr, vehicle_element)
    if not vehicle_descr then
        return
    end
    
    db_service:preloadVehicleInfo(db_service.platform, vehicle_descr, function() TankSelector:onSelectPreloadedVehicle(vehicle_descr, vehicle_element) end)
end

function TankSelector:onSelectPreloadedVehicle(vehicle_descr, vehicle_element)
    local platform = db_service.platform
    self.vehicle_descr = vehicle_descr
    self.specs, self.vehicle_info = db_service:getSpecs(platform, self.vehicle_descr, "", false)

    local vehicle_info = self.vehicle_info
    self.elements["vehicle_info"]:SetClass("hidden", not vehicle_info)

    self.elements["tank_image"]:SetClass("hidden", true)
    self.elements["tank_flag"]:SetClass("hidden", true)
    if vehicle_info then

        self.elements["tank_image"]:SetAttribute("src", platform:getVehiclePreviewUrl(vehicle_info.shared.id))
        self.elements["tank_image"]:SetClass("hidden", false)
            
        -- flag texture
        local flag_filename = utils.getVehicleFlagImage(vehicle_info.shared)
        
        if flag_filename then
            self.elements["tank_flag"]:SetAttribute("src", "https://armor.wotinspector.com/static/armorinspector/" .. flag_filename)
            self.elements["tank_flag"]:SetClass("hidden", false)
            
            local is_blitz = platform.game_code == "blitz" or platform.game_code == "tanksblitz"
            self.elements["tank_flag"].style.width = is_blitz and "152%" or "100%"
            self.elements["tank_flag"].style.height = is_blitz and "114%" or (platform.game_code == "reforged" and "57%" or "69%")
            self.elements["tank_flag"].style["mask-image"] = (is_blitz or platform.game_code == "reforged") and "linear-gradient(to bottom, white, transparent 75%)" or "none"
        end

        local vehicle_container = self.elements["tank_name"].parent_node        
        local style = utils.getVehicleStatusStyle(vehicle_info.shared)
        
        self.elements["tank_name"].inner_rml = platform:getTextUTF8(vehicle_info.shared.localized_name)
        vehicle_container:SetClass("text-primary", false)
        vehicle_container:SetClass("text-premium", false)
        vehicle_container:SetClass("text-reward", false)
        vehicle_container:SetClass("text-muted", false)
        vehicle_container:SetClass(style, true)
        
        self.elements["tank_tier"].inner_rml = utils.tier_labels[vehicle_info.shared.level] or ""
        self.elements["tank_type"]:SetAttribute("src", "/rml/icons/" .. utils.getTypeIcon(vehicle_info.shared.type))
        self:setNationIconElements(
            self.elements["tank_nation_svg"],
            self.elements["tank_nation_img"],
            utils.getNationIcon(platform, platform:getNationById(vehicle_info.shared.id)))
        self.elements["tank_status"]:SetClass("hidden", vehicle_info.shared.is_hidden or (not vehicle_info.shared.is_premium and not vehicle_info.shared.is_collectible))
        
        local role_tag, role = self:getVehicleRoleTag(vehicle_info.shared)
        self.elements["tank_role_icon"].parent_node:SetClass("hidden", not role_tag)
        if role_tag then
            local icon
            if role == "assault" then
                icon = "/rml/icons/Role-Assault.svg"
            elseif role == "break" then
                icon = "/rml/icons/Role-Breakthrough.svg"
            elseif role == "flame" then
                icon = "/rml/icons/Role-Flamed.svg"
            elseif role == "sniper" then
                icon = "/rml/icons/Role-Sniper.svg"
            elseif role == "support" then
                icon = "/rml/icons/Role-Support.svg"
            elseif role == "universal" then
                icon = "/rml/icons/Role-Universal.svg"
            elseif role == "wheeled" then
                icon = "/rml/icons/Role-Wheeled.svg"
            end
            if icon and FileSystem.fileExists(icon) then
                self.elements["tank_role_icon"]:SetAttribute("src", icon)
                self.elements["tank_role_icon"]:SetClass("hidden", false)
            else
                self.elements["tank_role_icon"]:SetClass("hidden", true)
            end
            self.elements["tank_role_name"].inner_rml = "UI_" .. role_tag
        end
    end
end

function TankSelector:rebuildList()

    -- update filters
    local tier = 3
    local tier_element
        
    self.elements["tier1-2"]:SetClass("text-secondary", self.tier_mask & (1 << 0) ~= 0)
    self.elements["tier1-3"]:SetClass("text-secondary", self.tier_mask & (1 << 0) ~= 0)
    repeat
        tier_element = self.elements["tier" .. tier]
            
        if tier_element then
            tier_element:SetClass("text-secondary", self.tier_mask & (1 << (tier - 1)) ~= 0)
            tier = tier + 1
        end
    until tier_element == nil

    local nation_idx = 0
    local nation_element
        
    repeat
        nation_element = self.elements["nation" .. nation_idx]

        if nation_element then
            nation_element:SetClass("text-secondary", self.nation_mask & (1 << nation_idx) ~= 0)
            nation_idx = nation_idx + 1
        end
    until nation_element == nil

    if self.reforged_nation_elements then
        for nation, button in pairs(self.reforged_nation_elements) do
            button:SetClass("text-secondary", self.nation_mask & (1 << nation) ~= 0)
        end
    end

    for type_idx = 0, 4 do
        local type_element = self.elements["type" .. type_idx]
        type_element:SetClass("text-secondary", self.type_mask & (1 << type_idx) ~= 0)
    end
    
    self.elements["regular"]:SetClass("text-secondary", self.status_mask & (1 << 0) ~= 0)
    self.elements["premium"]:SetClass("text-premium", self.status_mask & (1 << 1) ~= 0)
    self.elements["reward"]:SetClass("text-reward", self.status_mask & (1 << 2) ~= 0)
    self.elements["hidden"]:SetClass("text-secondary", self.status_mask & (1 << 3) ~= 0)
    self.elements["new"]:SetClass("text-secondary", self.status_mask & (1 << 4) ~= 0)

    self.elements["role_assault"]:SetClass("text-secondary", self.role_mask & (1 << 0) ~= 0)
    self.elements["role_break"]:SetClass("text-secondary", self.role_mask & (1 << 1) ~= 0)
    self.elements["role_sniper"]:SetClass("text-secondary", self.role_mask & (1 << 2) ~= 0)
    self.elements["role_support"]:SetClass("text-secondary", self.role_mask & (1 << 3) ~= 0)
    self.elements["role_universal"]:SetClass("text-secondary", self.role_mask & (1 << 4) ~= 0)
    self.elements["role_wheeled"]:SetClass("text-secondary", self.role_mask & (1 << 5) ~= 0)
    self.elements["role_flame"]:SetClass("text-secondary", self.role_mask & (1 << 6) ~= 0)
    
    -- rebuild vehicles
    self.elements["vehicles"].inner_rml = ""
    
    local tier_group_template = [[
        <p class="text-xl leading-none"></p>
        <div class="flex-1 flex flex-wrap text-sm gap-1 pl-2"></div>
    ]]
    
    local vehicle_template = [[
        <svg class="type w-4 mb-0_5 flex-none" src="/rml/icons/TankSelector-ClassHeavy-big.svg" />
        <svg class="nation-svg w-4 mb-0_5 flex-none hidden" src="/rml/icons/flag-usa.svg" />
        <img class="nation-img w-4 h-4 mb-0_5 flex-none hidden" src="/materials/system/grey.png" />
        <p class="name truncate"></p>
    ]]
    
    local vehicles_limited_template = [[
        <p class="text-xs text-muted text-center"></p>
    ]]
    
    local platform = db_service.platform
    if platform then
        local vehicles = platform:filterVehicles(
            self.nation_mask == 0 and -1 or self.nation_mask, 
            self.tier_mask == 0 and -1 or self.tier_mask, 
            self.type_mask == 0 and -1 or self.type_mask, 
            function(vehicle_info) return self:filterVehicle(vehicle_info) end, 100)

        local container, locked_container
        local current_tier
        for _, vehicle_info in ipairs(vehicles) do
            if current_tier ~= vehicle_info.level then
                current_tier = vehicle_info.level
                local tier_title = self.elements["vehicles"]:AppendChild(self.document:CreateElement("div"))
                tier_title.inner_rml = tier_group_template
                tier_title:QuerySelector("p").inner_rml = utils.tier_labels[current_tier] or ""
                
                container = tier_title:QuerySelector("div")
            end
        
            local vehicle_element = container:AppendChild(self.document:CreateElement("div"))
            vehicle_element.inner_rml = vehicle_template
            vehicle_element.style.width = "140dp"
            vehicle_element:SetClass("flex", true)
            vehicle_element:SetClass("gap-0_5", true)
            vehicle_element:SetClass("items-center", true)
            vehicle_element:SetClass("leading-none", true)
            vehicle_element:SetClass("border", true)
            vehicle_element:SetClass("border-0_5", true)
            vehicle_element:SetClass("rounded", true)
            vehicle_element:SetClass("border-transparent", true)
            vehicle_element:SetClass("p-0_5", true)
            vehicle_element:SetClass(utils.getVehicleStatusStyle(vehicle_info), true)
            
            vehicle_element:QuerySelector(".name").inner_rml = platform:getTextUTF8(vehicle_info.short_name)
            self:setNationIconElements(
                vehicle_element:QuerySelector(".nation-svg"),
                vehicle_element:QuerySelector(".nation-img"),
                utils.getNationIcon(platform, platform:getNationById(vehicle_info.id)))
            vehicle_element:QuerySelector(".type"):SetAttribute("src", "/rml/icons/" .. utils.getTypeIcon(vehicle_info.type))
            vehicle_element:AddEventListener("click", function() self:selectVehicle(WOTVehicleDescriptor.new(vehicle_info.id), vehicle_element) end, true)
        end
        
        self.elements["vehicles_empty"]:SetClass("hidden", #vehicles > 0)
        self.elements["vehicles"]:SetClass("hidden", #vehicles == 0)
    
        if #vehicles >= 100 then
            local vehicles_limited = self.elements["vehicles"]:AppendChild(self.document:CreateElement("div"))
            vehicles_limited.inner_rml = vehicles_limited_template
            vehicles_limited:QuerySelector("p").inner_rml = fmt("UI_vehicle_list_limited", 100)
        end
    end
end

function TankSelector:onResetButton()
    self.tier_mask = 0
    self.nation_mask = 0
    self.type_mask = 0
    self.status_mask = 0
    self.role_mask = 0
    self:rebuildList()
end

function TankSelector:onPlatformSelect(value)
    if self.platform_select_guard or value == nil or #value == 0 then
        return
    end

    db_service:selectPlatform(db_service:getPlatform(tonumber(value)))
end

function TankSelector:onSelect()
    if self.on_select then
        self.on_select(self.vehicle_descr)
    end
    self:close()
end

function TankSelector:onSetup()
    self.document:Hide()
    TankSetup:open(self.vehicle_descr, function(vehicle_descr) self.vehicle_descr = vehicle_descr end, function() self.document:Show() end)
end

		</script>
	</head>
	<body id="tank_selector" class="m-auto" template="window" onload="TankSelector:new{document = document}">
        <div class="flex gap-2 flex-col overflow-y-auto" style="width:152dp">
            <div>
                <p class="text-xs">UI_icon_tiers</p>
                <div class="text-sm tiers text-muted flex gap-1 flex-wrap text-sm font-bold text-center p-1">
                    <p id="tier1-2" class="w-6" onclick="TankSelector.tier_mask = (TankSelector.tier_mask ~= 3 and 3 or 0) TankSelector:rebuildList()">I-II</p>
                    <p id="tier3" class="w-6" onclick='TankSelector:onToggleFilter("tier_mask", 2)'>III</p>
                    <p id="tier1-3" class="w-6" onclick="TankSelector.tier_mask = (TankSelector.tier_mask ~= 7 and 7 or 0) TankSelector:rebuildList()">I-III</p>
                    <p id="tier4" class="w-6" onclick='TankSelector:onToggleFilter("tier_mask", 3)'>IV</p>
                    <p id="tier5" class="w-6" onclick='TankSelector:onToggleFilter("tier_mask", 4)'>V</p>
                    <p id="tier6" class="w-6" onclick='TankSelector:onToggleFilter("tier_mask", 5)'>VI</p>
                    <p id="tier7" class="w-6" onclick='TankSelector:onToggleFilter("tier_mask", 6)'>VII</p>
                    <p id="tier8" class="w-6" onclick='TankSelector:onToggleFilter("tier_mask", 7)'>VIII</p>
                    <p id="tier9" class="w-6" onclick='TankSelector:onToggleFilter("tier_mask", 8)'>IX</p>
                    <p id="tier10" class="w-6" onclick='TankSelector:onToggleFilter("tier_mask", 9)'>X</p>
                    <p id="tier11" class="w-6" onclick='TankSelector:onToggleFilter("tier_mask", 10)'>XI</p>
                </div>
            </div>
            <div>
                <p class="text-xs">UI_icon_type</p>
                <div class="text-sm text-muted flex gap-1 flex-wrap p-1">
                    <svg id="type0" class="w-6 my-auto flex-none" src="/rml/icons/TankSelector-ClassLight-big.svg" onclick='TankSelector:onToggleFilter("type_mask", 0)' />
                    <svg id="type1" class="w-6 my-auto flex-none" src="/rml/icons/TankSelector-ClassMedium-big.svg" onclick='TankSelector:onToggleFilter("type_mask", 1)' />
                    <svg id="type2" class="w-6 my-auto flex-none" src="/rml/icons/TankSelector-ClassHeavy-big.svg" onclick='TankSelector:onToggleFilter("type_mask", 2)' />
                    <svg id="type3" class="w-6 my-auto flex-none" src="/rml/icons/TankSelector-ClassTankDestroyer-big.svg" onclick='TankSelector:onToggleFilter("type_mask", 3)' />
                    <svg id="type4" class="w-6 my-auto flex-none" src="/rml/icons/TankSelector-ClassArtillery-big.svg" onclick='TankSelector:onToggleFilter("type_mask", 4)' />
                </div>
            </div>
            <div>
                <p class="text-xs">UI_icon_nation</p>
                <div id="nations_pc" class="text-sm text-muted flex gap-1 flex-wrap p-1">
                    <svg id="nation0" class="w-6 my-auto flex-none" src="/rml/icons/Flag-China-.svg" onclick='TankSelector:onToggleFilter("nation_mask", 0)' />
                    <svg id="nation1" class="w-6 my-auto flex-none" src="/rml/icons/Flag-France-.svg" onclick='TankSelector:onToggleFilter("nation_mask", 1)' />
                    <svg id="nation2" class="w-6 my-auto flex-none" src="/rml/icons/Flag-Germany-.svg" onclick='TankSelector:onToggleFilter("nation_mask", 2)' />
                    <svg id="nation3" class="w-6 my-auto flex-none" src="/rml/icons/flag-japan.svg" onclick='TankSelector:onToggleFilter("nation_mask", 3)' />
                    <svg id="nation4" class="w-6 my-auto flex-none" src="/rml/icons/flag-british.svg" onclick='TankSelector:onToggleFilter("nation_mask", 4)' />
                    <svg id="nation5" class="w-6 my-auto flex-none" src="/rml/icons/Flag-SovietUnion-.svg" onclick='TankSelector:onToggleFilter("nation_mask", 5)' />
                    <svg id="nation6" class="w-6 my-auto flex-none" src="/rml/icons/flag-usa.svg" onclick='TankSelector:onToggleFilter("nation_mask", 6)' />
                    <svg id="nation7" class="w-6 my-auto flex-none" src="/rml/icons/flag-czech.svg" onclick='TankSelector:onToggleFilter("nation_mask", 7)' />
                    <svg id="nation8" class="w-6 my-auto flex-none" src="/rml/icons/flag-sweden.svg" onclick='TankSelector:onToggleFilter("nation_mask", 8)' />
                    <svg id="nation9" class="w-6 my-auto flex-none" src="/rml/icons/flag-poland.svg" onclick='TankSelector:onToggleFilter("nation_mask", 9)' />
                    <svg id="nation10" class="w-6 my-auto flex-none" src="/rml/icons/flag-italy.svg" onclick='TankSelector:onToggleFilter("nation_mask", 10)' />
                    <svg id="nation11" class="w-6 my-auto flex-none" src="/rml/icons/AI-platform-Blitz-.svg" onclick='TankSelector:onToggleFilter("nation_mask", 11)' />
                    <svg id="nation12" class="w-6 my-auto flex-none" src="/rml/icons/Flag-Mercenaries.svg" onclick='TankSelector:onToggleFilter("nation_mask", 12)' />
                    <svg id="nation13" class="w-6 my-auto flex-none" src="/rml/icons/flag-euro.svg" onclick='TankSelector:onToggleFilter("nation_mask", 13)' />
                    <svg id="nation14" class="w-6 my-auto flex-none" src="/rml/icons/Flag-International-world-1.svg" onclick='TankSelector:onToggleFilter("nation_mask", 14)' />
                </div>
                <div id="nations_reforged" class="hidden text-sm text-muted flex gap-1 flex-wrap p-1">
                </div>
            </div>
            <div id="role_filters">
                <p class="text-xs">UI_icon_roles</p>
                <div class="text-sm text-muted flex gap-1 flex-wrap p-1">
                    <svg id="role_assault" class="w-6 my-auto flex-none" src="/rml/icons/Role-Assault.svg" onclick='TankSelector:onToggleFilter("role_mask", 0)' />
                    <svg id="role_break" class="w-6 my-auto flex-none" src="/rml/icons/Role-Breakthrough.svg" onclick='TankSelector:onToggleFilter("role_mask", 1)' />
                    <svg id="role_sniper" class="w-6 my-auto flex-none" src="/rml/icons/Role-Sniper.svg" onclick='TankSelector:onToggleFilter("role_mask", 2)' />
                    <svg id="role_support" class="w-6 my-auto flex-none" src="/rml/icons/Role-Support.svg" onclick='TankSelector:onToggleFilter("role_mask", 3)' />
                    <svg id="role_universal" class="w-6 my-auto flex-none" src="/rml/icons/Role-Universal.svg" onclick='TankSelector:onToggleFilter("role_mask", 4)' />
                    <svg id="role_wheeled" class="hidden w-6 my-auto flex-none" src="/rml/icons/Role-Wheeled.svg" onclick='TankSelector:onToggleFilter("role_mask", 5)' />
                    <svg id="role_flame" class="hidden w-6 my-auto flex-none" src="/rml/icons/Role-Flamed.svg" onclick='TankSelector:onToggleFilter("role_mask", 6)' />
                </div>
            </div>
            <div>
                <p class="text-xs">UI_status</p>
                <div class="text-sm flex gap-1 flex-wrap p-1">
                    <svg id="regular" class="w-6 my-auto flex-none text-muted" src="/rml/icons/TankSelector-Premium-.svg" onclick='TankSelector:onToggleFilter("status_mask", 0)' />
                    <svg id="premium" class="w-6 my-auto flex-none text-premium-muted" src="/rml/icons/TankSelector-Premium-.svg" onclick='TankSelector:onToggleFilter("status_mask", 1)' />
                    <svg id="reward" class="w-6 my-auto flex-none text-reward-muted" src="/rml/icons/TankSelector-Premium-.svg" onclick='TankSelector:onToggleFilter("status_mask", 2)' />
                    <svg id="hidden" class="w-6 my-auto flex-none text-muted" src="/rml/icons/UI-secret-spy.svg" onclick='TankSelector:onToggleFilter("status_mask", 3)' />
                    <svg id="new" class="w-6 my-auto flex-none text-muted" src="/rml/icons/UI-NEW-.svg" onclick='TankSelector:onToggleFilter("status_mask", 4)' />
                </div>
            </div>
        </div>
        <div class="flex flex-col flex-1 gap-1">
            <div class="text-xs flex-none hidden">
                <p>UI_icon_search</p>
                <input type="text" class="text-sm bg-content p-1 leading-none" />
            </div>
            <p class="text-xs">UI_tank_list</p>
            <div id="vehicles" class="overflow-y-auto flex-1 flex flex-col gap-4">
            </div>
            <div id="vehicles_empty" class="hidden flex flex-1 flex-col gap-2 items-center justify-center">
                <p>UI_no_vehicles_found</p>
                <button class="bg-secondary text-primary-foreground rounded" onclick="TankSelector:onResetButton()">
                    <template src="button">
                        <svg src="/rml/icons/UI-return-reload-reset-.svg" class="w-8 flex-none" />
                        <p>UI_reset_filters</p>
                    </template>
                </button>
            </div>
        </div>
        <div id="vehicle_info" class="hidden bg-header p-1 flex flex-col" style="width:150dp">
            <p class="text-xs">UI_selection</p>
            <div class="flex-none overflow-hidden relative" style="width:150dp;height:100dp">
                <img id="tank_flag" class="hidden" src="/materials/system/grey.png" />
                <img id="tank_image" class="hidden w-full h-full absolute top-0 left-0" src="/materials/system/grey.png" />
            </div>
            <div class="flex flex-col">
                <p id="tank_name" class="text-base font-light leading-none"></p>
                <div class="flex items-center gap-1">
                    <p id="tank_tier" class="text-base leading-none"></p>
                    <svg id="tank_type" class="w-6 mb-0_5 flex-none" src="/rml/icons/TankSelector-ClassHeavy-big.svg" />
                    <svg id="tank_nation_svg" class="w-6 mb-0_5 flex-none hidden" src="/rml/icons/flag-usa.svg" />
                    <img id="tank_nation_img" class="w-6 h-6 mb-0_5 flex-none hidden" src="/materials/system/grey.png" />
                    <svg id="tank_status" class="w-6 mb-0_5 flex-none" src="/rml/icons/TankSelector-Premium-.svg" />
                </div>
                <div class="flex items-start gap-1">
                    <svg id="tank_role_icon" class="w-3 my-auto flex-none" src="/rml/icons/Role-Assault.svg" style="image-color:#ffb34d" />
                    <p id="tank_role_name" class="text-xs" style="color:#ffb34d">UI_role_MT_support</p>
                </div>
            </div>
            <button class="text-secondary mt-1" onclick="TankSelector:onSetup()">
                <template src="button_icon">
                    <p>UI_icon_setup</p>
                    <svg src="/rml/icons/tools.svg" class="w-8 flex-none" />
                </template>
            </button>
            <button class="flex flex-none bg-secondary text-primary-foreground rounded" onclick="TankSelector:onSelect()" style="margin-top:auto">
                <template src="button">
                    <p>UI_confirm</p>
                </template>
            </button>
        </div>
    </body>
</rml>