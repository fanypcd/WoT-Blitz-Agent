#version 300 es
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif

in vec2 v_texCoord;
in vec4 v_color;
out vec4 fragColor;
uniform sampler2D u_texture;

void main()
{
    vec4 color;
    
    color = v_color * texture(u_texture, v_texCoord);    
    if (color.a == 0.0)
        discard;

    fragColor = color;
}