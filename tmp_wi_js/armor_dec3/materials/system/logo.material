material:
  sampler:
    id: u_texture
    path: materials/system/logo.png
    mipmap: true
    wrapS: CLAMP
    wrapT: CLAMP
    minFilter: LINEAR_MIPMAP_LINEAR
    magFilter: LINEAR

  technique:
    pass:
      id: 0
      vertexShader: shaders/textured_quad.vsh
      fragmentShader: shaders/textured_quad.psh

      renderState:
        blend: true
        blendSrc: SRC_ALPHA
        blendDst: ONE_MINUS_SRC_ALPHA
