material:
  sampler:
    id: u_texture
    path: materials/system/white.png
    mipmap: false
    wrapS: CLAMP
    wrapT: CLAMP
    minFilter: NEAREST
    magFilter: NEAREST

  technique:
    pass:
      id: 0
      vertexShader: shaders/blit.vert
      fragmentShader: shaders/sprite.frag

      renderState:
        blend: true
        blendSrc: SRC_ALPHA
        blendDst: ONE_MINUS_SRC_ALPHA
