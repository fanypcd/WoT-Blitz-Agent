material:

  u_invWorldMatrix: INVERSE_WORLD_MATRIX
  u_invViewProjectionMatrix: INVERSE_VIEW_PROJECTION_MATRIX
  u_cameraPosition: CAMERA_WORLD_POSITION
  u_maxDamageDistance: HEATMAP_MAX_DAMAGE_DISTANCE
  u_vehicleAngles: VEHICLE_ANGLES

  u_classHeatmaps: HEATMAP_GROUND_CLASS_HEATMAPS
  u_maxWeightInvLog: HEATMAP_GROUND_MAX_WEIGHT_INV_LOG

  u_damagePoint: HEATMAP_DAMAGE_POINT
  u_trajectoryPosition: TRAJECTORY_LOCAL_POSITION
  
  renderState:
    cullFace: true
    blend: true
    blendSrc: SRC_ALPHA
    blendDst: ONE_MINUS_SRC_ALPHA

  technique:
  - id: default
    pass:
      vertexShader: shaders/ground_heatmap.vert
      fragmentShader: shaders/ground_heatmap.frag
  
  - id: impacts
    sampler:
    - id: u_heatmapGradient
      path: materials/vehicle/heatmap_gradient.png
      mipmap: false
      wrapS: CLAMP
      wrapT: CLAMP
      minFilter: LINEAR
      magFilter: LINEAR
    pass:
      defines: "IMPACTS"
      vertexShader: shaders/ground_heatmap.vert
      fragmentShader: shaders/ground_heatmap.frag
