material:
  
  u_worldViewProjectionMatrix: VIEW_PROJECTION_MATRIX

  renderState:
    cullFace: true

  technique:
  - id: default
    u_shadowMap: SHADOW_MAP_SAMPLER
    u_shadowMapViewProjection0: SHADOW_MAP_VIEW_PROJECTION_MATRIX_0
    pass:
      vertexShader: shaders/background_spot.vert
      fragmentShader: shaders/background_spot.frag

  - id: defaultScreenshot
    u_shadowMap: SHADOW_MAP_SAMPLER
    u_shadowMapViewProjection0: SHADOW_MAP_VIEW_PROJECTION_MATRIX_0
    pass:
      vertexShader: shaders/background_spot.vert
      fragmentShader: shaders/background_spot_screenshot.frag

  - id: defaultHE
    parentID: default
    sampler:
    - id: u_damageRamp
      path: materials/vehicle/damage_ramp.png
      mipmap: false
      wrapS: CLAMP
      wrapT: CLAMP
      minFilter: NEAREST
      magFilter: NEAREST
    u_damageTexture: HE_DAMAGE_SAMPLER
    pass: {defines: "HEDAMAGE"}

  - id: depthHE
    u_depthConstants: DEPTH_FACTORS
    u_viewMatrix: VIEW_MATRIX
    pass:
      defines: "HE_SHELL"
      vertexShader: shaders/background_spot.vert
      fragmentShader: shaders/background_spot.frag  

  - id: ramming
    parentID: default
    u_cameraWorldPosition: CAMERA_WORLD_POSITION
    u_worldToVehicleMatrix: WORLD_TO_VEHICLE_MATRIX
    pass: {defines: "RAMMING"}
