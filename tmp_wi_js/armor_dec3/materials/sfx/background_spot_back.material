material:
  
  u_worldViewProjectionMatrix: VIEW_PROJECTION_MATRIX

  renderState:
    cullFace: true
    blend: true
    blendSrc: SRC_ALPHA
    blendDst: ONE_MINUS_SRC_ALPHA

  technique:
  - id: default
    pass:
      defines: "BACK"
      vertexShader: shaders/background_spot.vert
      fragmentShader: shaders/background_spot.frag

  - id: defaultHE
    parentID: default
    sampler:
    - id: u_damageRamp
      path: materials/vehicle/damage_ramp.png
      mipmap: false
      wrapS: CLAMP
      wrapT: CLAMP
      minFilter: NEAREST
      magFilter: NEAREST
    u_damageTexture: HE_DAMAGE_SAMPLER
    pass: {defines: "HEDAMAGE;BACK"}

  - id: depthHE

  - id: ramming
    parentID: default
    u_cameraWorldPosition: CAMERA_WORLD_POSITION
    u_worldToVehicleMatrix: WORLD_TO_VEHICLE_MATRIX
    pass: {defines: "RAMMING;BACK"}
