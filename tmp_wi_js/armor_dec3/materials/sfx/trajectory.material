material:
  u_worldViewProjectionMatrix: WORLD_VIEW_PROJECTION_MATRIX
  u_alpha: 1.0
  
  renderState:
    depthTest: true
    depthWrite: false
    blend: true
    blendSrc: SRC_ALPHA
    blendDst: ONE

  technique:
  - id: default
    pass:
      vertexShader: materials/sfx/trajectory.vert
      fragmentShader: materials/sfx/trajectory.frag
  - id: crossSection
    renderState:
      blend: true
      blendSrc: SRC_ALPHA
      blendDst: ONE_MINUS_SRC_ALPHA
    pass:
      defines: "CROSS_SECTION"
      vertexShader: materials/sfx/trajectory.vert
      fragmentShader: materials/sfx/trajectory.frag
