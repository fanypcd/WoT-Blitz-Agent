material:

  u_invViewProjectionMatrix: INVERSE_VIEW_PROJECTION_MATRIX
  u_cameraPosition: CAMERA_WORLD_POSITION
  u_lightDirection: LIGHT_DIRECTION_0_WORLD
  u_shadowMap: SHADOW_MAP_SAMPLER
  u_shadowMapViewProjection0: SHADOW_MAP_VIEW_PROJECTION_MATRIX_0
  u_directionalLightColor[0]: SUN_COLOR
  u_ambientColor: SCENE_AMBIENT_COLOR
  #u_cloudyFactor: CLOUDY_FACTOR

  technique:
    pass:
      vertexShader: shaders/ground_hd.vert
      fragmentShader: shaders/ground_hd.frag
