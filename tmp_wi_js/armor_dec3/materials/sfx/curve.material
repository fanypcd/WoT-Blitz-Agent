material:
  u_worldViewMatrix: WORLD_VIEW_MATRIX
  u_projectionMatrix: PROJECTION_MATRIX
  
  renderState:
    depthWrite: false
    blend: true
    blendSrc: SRC_ALPHA
    blendDst: ONE_MINUS_SRC_ALPHA

  technique:
  - id: default
    u_alpha: 1.0
    renderState:
      depthTest: false
    pass:
    - u_color: SCENE_MAIN_COLOR
      u_alphaMod: 1.0
      vertexShader: shaders/curve.vert
      fragmentShader: shaders/curve.frag

  - id: defaultOcclusion
    u_alpha: 1.0
    renderState:
      depthTest: true
    pass:
    - u_color: SCENE_MAIN_COLOR
      u_alphaMod: 1.0
      vertexShader: shaders/curve.vert
      fragmentShader: shaders/curve.frag
    - renderState:
       depthFunc: GREATER
      u_alphaMod: 0.4
      u_color: [1.0, 1.0, 1.0, 1.0]
      vertexShader: shaders/curve.vert
      fragmentShader: shaders/curve.frag

  - id: defaultDepthTest
    parentID: default
    renderState:
      depthTest: true

  - id: vertexAlpha
    parentID: default
    pass:
    - u_color: SCENE_MAIN_COLOR
      u_alphaMod: 1.0
      defines: "VERTEX_ALPHA"
      vertexShader: shaders/curve.vert
      fragmentShader: shaders/curve.frag
    

  - id: trajectory
    renderState:
      depthTest: false
    sampler:
      id: u_penetrationRamp
      path: materials/vehicle/penetration_ramp_legacy.png
      mipmap: false
      wrapS: CLAMP
      wrapT: CLAMP
      minFilter: LINEAR
      magFilter: LINEAR
    pass:
      vertexShader: shaders/trajectory.vert
      fragmentShader: shaders/trajectory.frag
