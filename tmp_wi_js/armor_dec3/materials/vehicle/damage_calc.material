material:
  sampler:
  - id: u_piercingTexture
    path: materials/system/white.png
    mipmap: false
    wrapS: CLAMP
    wrapT: CLAMP
    minFilter: NEAREST
    magFilter: NEAREST

  renderState:
    blend: false
    depthTest: false
    depthWrite: false
    #depthFunc: GREATER

  technique:
  - id: initialCalc
    u_platform: PLATFORM_DATA
    u_damage: SHELL_DAMAGE_SPLASH
    pass:
      vertexShader: shaders/blit.vert
      fragmentShader: shaders/damage_calc.frag
  - id: accumulateDamage
    u_damage: SHELL_DAMAGE_SPLASH
    sampler:
      id: u_oldDamageTexture
      path: materials/system/white.png
      mipmap: false
      wrapS: CLAMP
      wrapT: CLAMP
      minFilter: NEAREST
      magFilter: NEAREST

    pass:
      vertexShader: shaders/blit.vert
      fragmentShader: shaders/damage_accum.frag
  - id: accumulateDamageRamming
    parentID: accumulateDamage
    pass: {defines: "RAMMING"}