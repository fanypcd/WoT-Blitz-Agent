material:
  u_worldViewProjectionMatrix: WORLD_VIEW_PROJECTION_MATRIX

  renderState:
    depthFunc: LEQUAL
    depthTest: true
    depthWrite: true
    cullFace: false #true

  technique:
  - id: default
    sampler:
    - id: u_diffuseTexture
      path: materials/system/grey.png
      mipmap: false
      wrapS: CLAMP
      wrapT: CLAMP
      minFilter: NEAREST
      magFilter: NEAREST

    renderState:
      blend: false
      stencilTest: true
      stencilOpSfail: KEEP
      stencilOpDpfail: KEEP
      stencilOpDppass: REPLACE
      stencilFunc: ALWAYS
      stencilFuncRef: 1

    u_ambientColor: SCENE_AMBIENT_COLOR
    u_directionalLightDirection[0]: LIGHT_DIRECTION_0
    u_directionalLightColor[0]: SUN_COLOR
    u_directionalLightDirection[1]: LIGHT_DIRECTION_1
    u_directionalLightColor[1]: LIGHT_COLOR_1

    u_worldViewMatrix: WORLD_VIEW_MATRIX
    u_worldMatrix: WORLD_MATRIX

    u_viewMatrix: VIEW_MATRIX
    u_shadowMap: SHADOW_MAP_SAMPLER
    u_shadowMapViewProjection[0]: SHADOW_MAP_VIEW_PROJECTION_MATRIX_0
    u_shadowMapInvSize: SHADOW_MAP_INVSIZE

    pass:
      defines: "DIRECTIONAL_LIGHT_COUNT 2;USE_SHADOWS;CLIP_INTERIOR"
      vertexShader: shaders/textured.vert
      fragmentShader: shaders/textured.frag

  - id: transitionFx
    parentID: default
    renderState:
      blend: true
      blendSrc: SRC_ALPHA
      blendDst: ONE_MINUS_SRC_ALPHA
    u_time: GAME_TIME
    pass:
      defines: "DIRECTIONAL_LIGHT_COUNT 2;USE_SHADOWS;CLIP_INTERIOR;TRANSITION_FX"
      vertexShader: shaders/textured.vert
      fragmentShader: shaders/textured.frag

  - id: shadowCaster
    renderState:
      blend: false
    pass:
      defines: "CLIP_INTERIOR"
      vertexShader: shaders/shadow_caster.vert
      fragmentShader: shaders/shadow_caster.frag