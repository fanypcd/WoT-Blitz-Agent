material:
  u_worldViewProjectionMatrix: WORLD_VIEW_PROJECTION_MATRIX

  renderState:
    depthTest: true
    depthWrite: true
    stencilTest: true
    stencilOpSfail: KEEP
    stencilOpDpfail: KEEP
    stencilOpDppass: REPLACE

  technique:
  - id: default
    pass:
      vertexShader: shaders/ricochet_plane.vert
      fragmentShader: shaders/ricochet_plane.frag
