form:
  id: main
  size: [100%, 100%]
  style: Empty
  batchingEnabled: false

  ${spacerSize}: 4
  ${spacerSize2}: 8
  ${spacerSize3}: 12
  ${iconSize}: 32
  ${iconSize2}: 64
  ${iconSize3}: 96
  ${iconSize4}: 128
  ${iconSize5}: 160
  ${iconSize6}: 192
  ${iconSpacerSize}: 36
  ${icon2SpacerSize}: 68
  ${icon2SpacerSize2}: 72
  ${halfSize}: 16

  ${negIconSize}: -32
  ${negSpacerSize}: -4

  ${tabSize}: 150

  container:
  - id: sceneViewContainer
    width: 100%
    height: 100%
    
    container:
    - width: 100%
      alignment: ALIGN_BOTTOM
      container:
      - style: background
        height: 16
        width: 100%
        container:
        - width: 30%
          button: {y: -4, id: options, width: 20, height: 20, style: preferencesMode}
        - x: 30%
          width: 70%
          container: {y: -4, id: targetIcon, width: 20, height: 20, style: flagChina}
          label: {id: targetName, width: 100%, height: 100%, padding: {left: 24, right: "${iconSize}"}, text: target, style: listLabelSmall}

    # camera panel
    - id: cameraPanel
      alignment: ALIGN_BOTTOM_HCENTER
      margin: {bottom: 22}
      layout: {type: LAYOUT_HORIZONTAL, spacing: "${spacerSize}"}
      container:
      - id: cameraPanelLeft
        alignment: ALIGN_BOTTOM
        container:
          layout: {type: LAYOUT_HORIZONTAL, spacing: "${spacerSize}"}
          container:
          - id: cameraPanelViews
            layout: {type: LAYOUT_HORIZONTAL, spacing: "${spacerSize}"}
            container:
            - label: {y: -2, width: 100%, text: UI_icon_front_view, style: iconCaption, height: 11, textColor: "${colorHUDActive}", consumeInputEvents: false}
              button: {id: frontView, width: 24, height: 24, style: frontView, skinColor: "${colorHUDActive}", receiveInputEvents: true, consumeInputEvents: false}
            - label: {y: -2, width: 100%, text: UI_icon_left_view, style: iconCaption, height: 11, textColor: "${colorHUDActive}", consumeInputEvents: false}
              button: {id: leftView, width: 24, height: 24, style: leftView, skinColor: "${colorHUDActive}", receiveInputEvents: true, consumeInputEvents: false}
            - label: {y: -2, width: 100%, text: UI_icon_back_view, style: iconCaption, height: 11, textColor: "${colorHUDActive}", consumeInputEvents: false}
              button: {id: backView, width: 24, height: 24, style: backView, skinColor: "${colorHUDActive}", receiveInputEvents: true, consumeInputEvents: false}
            - label: {y: -2, width: 100%, text: UI_icon_right_view, style: iconCaption, height: 11, textColor: "${colorHUDActive}", consumeInputEvents: false}
              button: {id: rightView, width: 24, height: 24, style: rightView, skinColor: "${colorHUDActive}", receiveInputEvents: true, consumeInputEvents: false}
            - {width: 1, height: 100%, style: white, skinColor: "${colorHUDActive}"}
          - label: {y: -2, width: 100%, text: UI_icon_animate, style: iconCaption, height: 11, textColor: "${colorHUDActive}", consumeInputEvents: false}
            button: {id: animate, width: 24, height: 24, style: animate, skinColor: "${colorHUDActive}", receiveInputEvents: true, consumeInputEvents: false}
          - {id: cameraPanelLeftSeparator, width: 1, height: 100%, style: white, skinColor: "${colorHUDActive}"}
        label:
          {id: tagPosition, y: 24, text: UI_icon_position, style: iconCaption, height: 11, textColor: "${colorHUDActive}", consumeInputEvents: false}
      - id: cameraPanelCenter
        layout: {type: LAYOUT_HORIZONTAL, spacing: "${spacerSize}"}
        container:
        - label: {id: distanceLabel, width: 100%, text: distance, style: infoText, textColor: "${colorHUDActive}", consumeInputEvents: false, textAlignment: ALIGN_HCENTER}
          button: {y: 4, id: cameraButton, width: "${iconSize}", height: "${iconSize}", style: camera, skinColor: "${colorHUDActive}", receiveInputEvents: true, consumeInputEvents: false}
          label: {y: 36, width: 100%, text: UI_icon_camera, style: iconCaption, height: 11, textColor: "${colorHUDActive}", consumeInputEvents: false}
      - id: cameraPanelRight
        alignment: ALIGN_BOTTOM
        container:
          layout: {type: LAYOUT_HORIZONTAL, spacing: "${spacerSize}"}
          container:
          - {width: 1, height: 100%, style: white, skinColor: "${colorHUDActive}"}
          - label: {y: -2, width: 100%, text: UI_icon_verticalcut, style: iconCaption, height: 11, textColor: "${colorHUDActive}", consumeInputEvents: false}
            button: {id: verticalCut, width: 24, height: 24, style: verticalCut, skinColor: "${colorHUDActive}", receiveInputEvents: true, consumeInputEvents: false}
          - label: {y: -2, width: 100%, text: UI_icon_horizontalcut, style: iconCaption, height: 11, textColor: "${colorHUDActive}", consumeInputEvents: false}
            button: {id: horizontalCut, width: 24, height: 24, style: horizontalCut, skinColor: "${colorHUDActive}", receiveInputEvents: true, consumeInputEvents: false}
          - {width: 1, height: 100%, style: white, skinColor: "${colorHUDActive}"}
          - label: {y: -2, width: 100%, text: UI_icon_email, style: iconCaption, height: 11, textColor: "${colorHUDActive}", consumeInputEvents: false}
            button: {id: screenshotEmailButton, width: 24, height: 24, style: shareEmail, skinColor: "${colorHUDActive}", receiveInputEvents: true, consumeInputEvents: false}
          - label: {y: -2, width: 100%, text: UI_icon_pic, style: iconCaption, height: 11, textColor: "${colorHUDActive}", consumeInputEvents: false}
            button: {id: screenshotCameraButton, width: 24, height: 24, style: sharePhotos, skinColor: "${colorHUDActive}", receiveInputEvents: true, consumeInputEvents: false}
          - label: {y: -2, width: 100%, text: UI_icon_link, style: iconCaption, height: 11, textColor: "${colorHUDActive}", consumeInputEvents: false}
            button: {id: screenshotUrlButton, width: 24, height: 24, style: shareLink, skinColor: "${colorHUDActive}", receiveInputEvents: true, consumeInputEvents: false}
        label:
          {y: 24, text: UI_icon_share, alignment: ALIGN_RIGHT, style: iconCaption, height: 11, textColor: "${colorHUDActive}", consumeInputEvents: false}

  - id: contextInfo
    visible: false
    width: 171
    scroll: SCROLL_VERTICAL
    layout: LAYOUT_HORIZONTAL
    alignment: ALIGN_TOP_RIGHT
    style: background
    margin: {top: "${halfSize}", right: "${halfSize}", bottom: "${iconSize}"}
    padding: {top: "${spacerSize}", bottom: "${spacerSize}", left: "${spacerSize}", right: "${spacerSize}"}

    expandedTab:
    - id: infoPanelTab
      width: 162
      widthMinimized: 0
      group: contextTabs
      state: MAXIMIZED
      consumeInputEvents: true

      container:
        width: 162
        container: {id: componentIcon, width: "${iconSize}", height: "${iconSize}", style: gun}
        label: {id: componentTypeName, width: 100%, text: UI_icon_visual, style: iconCaption, height: 11}
        label: {id: componentName, x: "${iconSpacerSize}", height: "${iconSize}", width: 100%, margin: {left: "${iconSpacerSize}", right: "${iconSpacerSize}"}, padding: {bottom: 0}, text: gun, style: listLabelSmall, textAlignment: ALIGN_BOTTOM}
        button: {id: closeButton, width: "${iconSize}", height: "${iconSize}", alignment: ALIGN_RIGHT}
        container: {y: 12, width: "${halfSize}", height: "${halfSize}", style: close, alignment: ALIGN_RIGHT, margin: {right: 8}}
        container:
        - {y: "${iconSpacerSize}", width: 100%, height: 1, style: white, skinColor: "${colorUIActive}"}
        - width: 100%
          y: 40 #"${iconSpacer2Size}"
          layout: LAYOUT_VERTICAL
          container:
          - id: tankInfo
            width: 100%
            label: {width: 100%, text: UI_icon_search, style: iconCaption, height: 11}
            button: {id: tankSelectorButton, width: "${iconSize}", height: "${iconSize}", style: search}
            textbox:
              id: tankSearchTextbox
              x: "${iconSpacerSize}"
              y: 12
              height: 20
              width: 100%
              margin: {left: "${iconSpacerSize}", right: "${spacerSize}"}
              padding: {left: "${spacerSize}", right: "${spacerSize}"}

          - id: itemList
            width: 100%
            layout: LAYOUT_VERTICAL
            x: "${iconSpacerSize}"
            margin: {top: "${spacerSize}", left: "${iconSpacerSize}"}

          - {width: 100%, height: 1, style: white, skinColor: "${colorUIActive}", margin: {top: "${spacerSize}", bottom: "${spacerSize}"}}

          - id: camoSection
            width: 100%
            label: {width: 100%, text: UI_icon_camo, style: iconCaption, height: 11}
            button: {id: camoSelector, width: "${iconSize}", height: "${iconSize}", style: camoSelector}
            label: {id: camoName, x: "${iconSpacerSize}", width: 100%, margin: {left: "${iconSpacerSize}"}, text: UI_default, style: iconCaption, height: 11}
            image: {id: camoPreview, path: materials/system/white_alpha_sprite.material, x: "${iconSpacerSize}", width: 100%, margin: {left: "${iconSpacerSize}"}, y: 10, height: 22}

          - {width: 100%, height: 1, style: white, skinColor: "${colorUIActive}", margin: {top: "${spacerSize}", bottom: "${spacerSize}"}}

          - container: {width: "${iconSize}", height: "${iconSize}", style: gamepad}
            label: {width: 100%, text: UI_icon_game, style: iconCaption, height: 11}
            label: {x: "${iconSpacerSize}", height: "${iconSize}", text: WoT game data, style: secondTitleLabel, textAlignment: ALIGN_BOTTOM}
          - {width: 100%, height: 1, style: white, skinColor: "${colorUIActive}", margin: {top: "${spacerSize}", bottom: "${spacerSize}"}}

          # wot specs
          - id: wotSpecs
            width: 100%
            layout: LAYOUT_VERTICAL
            padding: {right: 1}

    - id: camoListTab
      width: 162
      height: 100%
      widthMinimized: 0
      group: contextTabs
      state: HIDDEN
      consumeInputEvents: true

      container:
      - layout: LAYOUT_VERTICAL
        width: "${iconSpacerSize}"
        container:
        - button: {id: camoBack, width: "${iconSize}", height: "${iconSize}"}
          label: {width: 100%, text: UI_icon_back, style: iconCaption, height: 11, consumeInputEvents: false}
          container: {x: "${spacerSize}", y: 16, width: "${halfSize}", height: "${halfSize}", style: leftArrow}
        - {width: "${iconSize}", height: 1, style: white, skinColor: "${colorUIActive}", margin: {top: "${spacerSize}", bottom: "${spacerSize}"}}
        - label: {width: 100%, text: UI_icon_no_camo, style: iconCaption, height: 11, textColor: "${colorUIInactive}"}
          button: {id: camoReset, width: "${iconSize}", height: "${iconSize}", style: tank, skinColor: "${colorUIInactive}"}
        - label: {width: 100%, text: UI_icon_camo_realistic, style: iconCaption, height: 11}
          button: {id: camoRealistic, width: "${iconSize}", height: "${iconSize}", style: realisticCamo}
        - label: {width: 100%, text: UI_icon_camo_fantasy, style: iconCaption, height: 11}
          button: {id: camoFantasy, width: "${iconSize}", height: "${iconSize}", style: fantasyCamo}
        - label: {width: 100%, text: UI_icon_fade, style: iconCaption, height: 11}
          button: {id: paintSettings, width: "${iconSize}", height: "${iconSize}", style: time}
        - {width: "${iconSize}", height: 1, style: white, skinColor: "${colorUIActive}", margin: {top: "${spacerSize}", bottom: "${spacerSize}"}}
        - label: {width: 100%, text: UI_icon_no_3d, style: iconCaption, height: 11}
          button: {id: 3ddefault, width: "${iconSize}", height: "${iconSize}", style: tank}
        - id: 3dStyles
          layout: LAYOUT_VERTICAL
          width: "${iconSize}"

      - width: 126
        x: "${iconSpacerSize}"
        height: 100%

        container:
        - id: camoListRealistic
          layout: LAYOUT_VERTICAL
          scroll: SCROLL_VERTICAL
          consumeInputEvents: true
          width: 126
          height: 100%
          visible: true
        - id: camoListFantasy
          layout: LAYOUT_VERTICAL
          scroll: SCROLL_VERTICAL
          consumeInputEvents: true
          width: 126
          height: 100%
          visible: false
        - id: paintSettingsTab
          layout: LAYOUT_VERTICAL
          scroll: SCROLL_VERTICAL
          consumeInputEvents: true
          width: 126
          height: 100%
          visible: false
          slider: {id: paintFadeSlider, width: 100%, height: "${iconSize}", style: Slider, min: 0, max: 1, value: 0.8, step: 0.01, margin: {right: "${spacerSize}"}}

  - id: optionsDialog
    alignment: ALIGN_VCENTER_HCENTER
    height: 328
    width: 488
    style: white
    skinColor: "#000000a0"
    visible: false
    padding: {left: "${spacerSize}", right: "${spacerSize}", top: "${spacerSize}", bottom: "${spacerSize}"}
    consumeInputEvents: true

    # menu
    container:
      layout: LAYOUT_VERTICAL
      width: ${iconSpacerSize}
      height: 100%
      container:
      - container: {style: background, width: "${iconSize}", height: "${iconSize}"}
        label: {width: 100%, text: UI_icon_more, style: iconCaption, height: 11}
        button: {id: logoButton, width: "${iconSize}", height: "${iconSize}", style: hdModel, skinColor: "${colorUILogo}"}
      - container: {style: background, width: "${iconSize}", height: "${iconSize}"}
        label: {width: 100%, text: UI_icon_shop, style: iconCaption, height: 11}
        button: {id: shop, width: "${iconSize}", height: "${iconSize}", style: shop}
      - alignment: ALIGN_BOTTOM
        button: {id: back, style: background, width: "${iconSize}", height: "${iconSize}"}
        label: {y: 9, width: 100%, text: UI_icon_back, style: iconCaption, height: 11, consumeInputEvents: false}
        container: {x: "${spacerSize}", y: 16, width: "${halfSize}", height: "${halfSize}", style: leftArrow}

    expandedTab:
    - id: logoTab
      x: "${iconSpacerSize}"
      width: 444
      height: 100%
      widthMinimized: 0
      group: optionTabs
      state: MAXIMIZED
      style: background

      container:
        width: 444
        heigh: 100%
        alignment: ALIGN_RIGHT
        label: {text: More, style: titleLabel}

    - id: shopTab
      x: "${iconSpacerSize}"
      width: 444
      height: 100%
      widthMinimized: 0
      group: optionTabs
      state: HIDDEN
      style: background

      container:
        width: 444
        heigh: 100%
        alignment: ALIGN_RIGHT
        label: {text: Shop, style: titleLabel}

  - id: tankSelector
    alignment: ALIGN_VCENTER_HCENTER
    height: 328
    width: 488
    #style: background
    style: white
    skinColor: "#000000a0"
    visible: false
    padding: {left: "${spacerSize}", right: "${spacerSize}", top: "${spacerSize}", bottom: "${spacerSize}"}
    consumeInputEvents: true

    container:
    - x: 0 # title
      width: 480
      height: ${iconSize}
      container: {width: 100%, height: 100%, style: white, skinColor: "${colorUILogoBackground}"}
      label: {x: 0, text: UI_icon_close, style: iconCaption, height: 11}
      button: {x: 0, id: close, width: "${iconSize}", height: "${iconSize}"}
      container: {x: 8, y: 12, width: "${halfSize}", height: "${halfSize}", style: close}
      label: {x: 32, text: UI_icon_reset, style: iconCaption, height: 11}
      button: {x: 32, id: reset, width: "${iconSize}", height: "${iconSize}"}
      container: {x: 40, y: 12, width: "${halfSize}", height: "${halfSize}", style: reset}
      label: {x: 64, text: UI_icon_apply, style: iconCaption, height: 11}
      button: {x: 64, id: ok, width: "${iconSize}", height: "${iconSize}"}
      container: {x: 72, y: 12, width: "${halfSize}", height: "${halfSize}", style: apply}

    - x: 0 # tank image and specs
      width: 148
      height: 100%
      y: "${iconSize}"
      margin: {top: "${iconSize}"}
      padding: {bottom: "${spacerSize}"}
      style: background
      layout: LAYOUT_VERTICAL
      label: {id: title, margin: {top: "${spacerSize}"}, style: secondTitleLabel, width: 100%, padding: {left: "${spacerSize}", right: "${spacerSize}"}}
      httpImage: {id: tankImage, x: 10, margin: {left: 10, right: 10}, path: "", width: 100%, preserveAspect: true}
      container:
      - width: 100%
        padding: {left: "${spacerSize}", right: "${spacerSize}"}
        margin: {bottom: "${spacerSize}"}
        label: {id: tankNationLabel, width: 100%, style: iconCaption}
        container: {id: tankNationIcon, width: "${iconSize}", height: "${iconSize}", style: flag}
        label: {id: tankClassLabel, x: 36, width: 100%, style: iconCaption}
        container: {id: tankClassIcon, style: typeTD, x: 44, y: 14, width: "${halfSize}", height: "${halfSize}"}
        label: {id: tankTierLabel, x: 72, width: 100%, style: iconCaption}
        label: {id: tankTierIcon, x: 72, width: "${iconSize}", height: "${iconSize}", style: tierLabel}
      container:
      - width: 100%
        padding: {left: "${spacerSize}", right: "${spacerSize}"}
        height: 100
        scroll: SCROLL_VERTICAL
        scrollBarsAutoHide: true
        label: {id: description, width: 100%}

    - x: 148 # list
      y: ${iconSize}
      width: 136
      height: 100%
      margin: {top: "${iconSize}"}
      container: {width: 1, height: 100%, margin: {top: "${iconSize}"}, y: "${iconSize}", style: background, x: 1}
      container: {width: 100%, height: 20, margin: {right: "${spacerSize}", left: "${spacerSize}"}, style: background, x: "${spacerSize}", y: "${spacerSize}"}
      textbox:
        id: tankSearchTextbox
        x: "${spacerSize}"
        y: "${spacerSize}"
        height: 20
        width: 100%
        margin: {right: "${spacerSize}", left: "${spacerSize}"}
        padding: {left: "${spacerSize}", right: "${spacerSize}"}
      scrollablePrefab:
      - id: tankList
        size: [100%, 100%]
        alignment: ALIGN_TOP_LEFT
        margin: {top: 28, left: 2}
        container:
        - id: upArrow
          y: 0
          width: 100%
          height: "${halfSize}"
          opacity: 0.0
          container:
          - {size: [100%, 2], alignment: ALIGN_BOTTOM, style: white, skinColor: "${colorUIActive}"}
          - {width: "${halfSize}", height: "${halfSize}", alignment: ALIGN_BOTTOM_HCENTER, style: upArrow}
        - {id: contentContainer, y: "${halfSize}", size: [100%, 100%], margin: {bottom: "${iconSize}"}, padding: {right: "${spacerSize}"}, scroll: SCROLL_VERTICAL, scrollBarsAutoHide: true, layout: LAYOUT_VERTICAL}
        - id: downArrow
          width: 100%
          height: "${halfSize}"
          opacity: 0.0
          alignment: ALIGN_BOTTOM
          container:
          - {size: [100%, 2], alignment: ALIGN_TOP, style: white, skinColor: "${colorUIActive}"}
          - {width: "${halfSize}", height: "${halfSize}", alignment: ALIGN_HCENTER, style: downArrow}

    - x: 284 # nations
      y: ${iconSize}
      height: 100%
      width: ${icon2SpacerSize2}
      margin: {top: "${iconSize}"}
      label: {width: 100%, text: UI_icon_nation, style: iconCaption, x: "${spacerSize}"}
      button: {id: nationReset, width: "${iconSize}", height: "${iconSize}", style: flag, x: "${spacerSize}"}
      container:
      - {width: 1, height: 100%, margin: {top: "${iconSize}"}, y: "${iconSize}", style: background, x: 1}
      - y: "${iconSize}"
        x: "${spacerSize}"
        width: 100%
        margin: {right: "${spacerSize}"}
        layout: {type: LAYOUT_FLOW, horizontalSpacing: "${spacerSize}"}
        container:
        - style: background
          label: {width: 100%, text: UI_icon_china, style: iconCaption}
          button: {id: nation0, width: "${iconSize}", height: "${iconSize}", style: flagChina}
        - style: background
          label: {width: 100%, text: UI_icon_france, style: iconCaption}
          button: {id: nation1, width: "${iconSize}", height: "${iconSize}", style: flagFrance}
        - style: background
          label: {width: 100%, text: UI_icon_germany, style: iconCaption}
          button: {id: nation2, width: "${iconSize}", height: "${iconSize}", style: flagGermany}
        - style: background
          label: {width: 100%, text: UI_icon_japan, style: iconCaption}
          button: {id: nation3, width: "${iconSize}", height: "${iconSize}", style: flagJapan}
        - style: background
          label: {width: 100%, text: UI_icon_uk, style: iconCaption}
          button: {id: nation4, width: "${iconSize}", height: "${iconSize}", style: flagUk}
        - style: background
          label: {width: 100%, text: UI_icon_ussr, style: iconCaption}
          button: {id: nation5, width: "${iconSize}", height: "${iconSize}", style: flagUssr}
        - style: background
          label: {width: 100%, text: UI_icon_usa, style: iconCaption}
          button: {id: nation6, width: "${iconSize}", height: "${iconSize}", style: flagUsa}
        - style: background
          label: {width: 100%, text: UI_icon_czech, style: iconCaption}
          button: {id: nation7, width: "${iconSize}", height: "${iconSize}", style: flagCzech}
        - style: background
          label: {width: 100%, text: UI_icon_sweden, style: iconCaption}
          button: {id: nation8, width: "${iconSize}", height: "${iconSize}", style: flagSweden}
        - style: background
          label: {width: 100%, text: UI_icon_poland, style: iconCaption}
          button: {id: nation9, width: "${iconSize}", height: "${iconSize}", style: flagPoland}
        - style: background
          label: {width: 100%, text: UI_icon_italy, style: iconCaption}
          button: {id: nation10, width: "${iconSize}", height: "${iconSize}", style: flagItaly}
        - style: background
          label: {width: 100%, text: UI_icon_blitz, style: iconCaption}
          button: {id: nation11, width: "${iconSize}", height: "${iconSize}", style: flagBlitz}
        - style: background
          label: {width: 100%, text: UI_icon_merc, style: iconCaption}
          button: {id: nation12, width: "${iconSize}", height: "${iconSize}", style: flagMerc}
        - style: background
          label: {width: 100%, text: UI_icon_euro, style: iconCaption}
          button: {id: nation13, width: "${iconSize}", height: "${iconSize}", style: flagEuro}

    - x: 356 # classes
      y: ${iconSize}
      width: ${iconSpacerSize}
      height: 100%
      margin: {top: "${iconSize}"}
      label: {width: 100%, text: UI_icon_type, style: iconCaption, x: "${spacerSize}"}
      button: {id: classReset, width: "${iconSize}", height: "${iconSize}", style: typeAny, x: "${spacerSize}"}
      container:
      - {width: 1, height: 100%, margin: {top: "${iconSize}"}, y: "${iconSize}", style: background, x: 1}
      - y: "${iconSize}"
        x: "${spacerSize}"
        width: 100%
        margin: {right: "${spacerSize}"}
        layout: LAYOUT_VERTICAL
        container:
        - style: background
          label: {width: 100%, text: UI_icon_lt, style: iconCaption}
          container: {style: typeLT, x: "${spacerSize2}", y: 14, width: "${halfSize}", height: "${halfSize}"}
          button: {id: type0, width: "${iconSize}", height: "${iconSize}"}
        - style: background
          label: {width: 100%, text: UI_icon_mt, style: iconCaption}
          container: {style: typeMT, x: "${spacerSize2}", y: 14, width: "${halfSize}", height: "${halfSize}"}
          button: {id: type1, width: "${iconSize}", height: "${iconSize}"}
        - style: background
          label: {width: 100%, text: UI_icon_ht, style: iconCaption}
          container: {style: typeHT, x: "${spacerSize2}", y: 14, width: "${halfSize}", height: "${halfSize}"}
          button: {id: type2, width: "${iconSize}", height: "${iconSize}"}
        - style: background
          label: {width: 100%, text: UI_icon_td, style: iconCaption}
          container: {style: typeTD, x: "${spacerSize2}", y: 14, width: "${halfSize}", height: "${halfSize}"}
          button: {id: type3, width: "${iconSize}", height: "${iconSize}"}
        - style: background
          label: {width: 100%, text: UI_icon_arty, style: iconCaption}
          container: {style: typeSPG, x: "${spacerSize2}", y: 14, width: "${halfSize}", height: "${halfSize}"}
          button: {id: type4, width: "${iconSize}", height: "${iconSize}"}

    - x: 392 # years
      y: ${iconSize}
      width: 52
      height: 100%
      margin: {top: "${iconSize}"}
      label: {width: 100%, text: UI_icon_years, style: iconCaption, x: "${spacerSize}"}
      button: {id: yearReset, width: "${iconSize}", height: "${iconSize}", style: calendar, x: "${spacerSize}"}
      container:
      - {width: 1, height: 100%, margin: {top: "${iconSize}"}, y: "${iconSize}", style: background, x: 1}
      - y: "${iconSize}"
        x: "${spacerSize}"
        width: 100%
        margin: {right: "${spacerSize}"}
        layout: LAYOUT_VERTICAL
        container:
        - style: background
          label: {id: year0, width: 48, height: "${iconSize}", text: "1910's", style: secondTitleLabel, textAlignment: ALIGN_BOTTOM_HCENTER, userString: "1910-1920"}
        - style: background
          label: {id: year1, width: 48, height: "${iconSize}", text: "1920's", style: secondTitleLabel, textAlignment: ALIGN_BOTTOM_HCENTER, userString: "1920-1930"}
        - style: background
          label: {id: year2, width: 48, height: "${iconSize}", text: "1930's", style: secondTitleLabel, textAlignment: ALIGN_BOTTOM_HCENTER, userString: "1930-1935"}
        - style: background
          label: {id: year3, width: 48, height: "${iconSize}", text: "1935's", style: secondTitleLabel, textAlignment: ALIGN_BOTTOM_HCENTER, userString: "1935-1940"}
        - style: background
          label: {id: year4, width: 48, height: "${iconSize}", text: "1940's", style: secondTitleLabel, textAlignment: ALIGN_BOTTOM_HCENTER, userString: "1940-1945"}
        - style: background
          label: {id: year5, width: 48, height: "${iconSize}", text: "1945's", style: secondTitleLabel, textAlignment: ALIGN_BOTTOM_HCENTER, userString: "1945-1950"}
        - style: background
          label: {id: year6, width: 48, height: "${iconSize}", text: "1950's", style: secondTitleLabel, textAlignment: ALIGN_BOTTOM_HCENTER, userString: "1950-1955"}
        - style: background
          label: {id: year7, width: 48, height: "${iconSize}", text: "1955+", style: secondTitleLabel, textAlignment: ALIGN_BOTTOM_HCENTER, userString: "1955-1999"}

    - x: 444 # tiers
      y: ${iconSize}
      width: ${iconSpacerSize}
      height: 100%
      margin: {top: "${iconSize}"}
      label: {width: 100%, text: UI_icon_tiers, style: iconCaption, x: "${spacerSize}"}
      button: {id: tierReset, width: "${iconSize}", height: "${iconSize}", style: tierI-X, x: "${spacerSize}"}
      container:
      - {width: 1, height: 100%, margin: {top: "${iconSize}"}, y: "${iconSize}", style: background, x: 1}
      scrollablePrefab:
      - size: [100%, 100%]
        alignment: ALIGN_TOP_LEFT
        margin: {left: 2, top: "${iconSize}"}
        container:
        - id: contentContainer
          size: [100%, 100%]
          scroll: SCROLL_VERTICAL
          scrollBarsAutoHide: false
          layout: LAYOUT_VERTICAL
          container:
          - style: background
            label:
            - {width: 100%, text: UI_icon_tier1, style: iconCaption}
            - {id: tier1, width: "${iconSize}", height: "${iconSize}", text: "I", style: tierLabel}
          - style: background
            label:
            - {width: 100%, text: UI_icon_tier2, style: iconCaption}
            - {id: tier2, width: "${iconSize}", height: "${iconSize}", text: "II", style: tierLabel}
          - style: background
            label:
            - {width: 100%, text: UI_icon_tier3, style: iconCaption}
            - {id: tier3, width: "${iconSize}", height: "${iconSize}", text: "III", style: tierLabel}
          - style: background
            label:
            - {width: 100%, text: UI_icon_tier4, style: iconCaption}
            - {id: tier4, width: "${iconSize}", height: "${iconSize}", text: "IV", style: tierLabel}
          - style: background
            label:
            - {width: 100%, text: UI_icon_tier5, style: iconCaption}
            - {id: tier5, width: "${iconSize}", height: "${iconSize}", text: "V", style: tierLabel}
          - style: background
            label:
            - {width: 100%, text: UI_icon_tier6, style: iconCaption}
            - {id: tier6, width: "${iconSize}", height: "${iconSize}", text: "VI", style: tierLabel}
          - style: background
            label:
            - {width: 100%, text: UI_icon_tier7, style: iconCaption}
            - {id: tier7, width: "${iconSize}", height: "${iconSize}", text: "VII", style: tierLabel}
          - style: background
            label:
            - {width: 100%, text: UI_icon_tier8, style: iconCaption}
            - {id: tier8, width: "${iconSize}", height: "${iconSize}", text: "VIII", style: tierLabel}
          - style: background
            label:
            - {width: 100%, text: UI_icon_tier9, style: iconCaption}
            - {id: tier9, width: "${iconSize}", height: "${iconSize}", text: "IX", style: tierLabel}
          - style: background
            label:
            - {width: 100%, text: UI_icon_tier10, style: iconCaption}
            - {id: tier10, width: "${iconSize}", height: "${iconSize}", text: "X", style: tierLabel}

  - id: downloadProgressWindow
    alignment: ALIGN_BOTTOM
    width: 100%
    consumeInputEvents: false
    margin: {bottom: "${halfSize}"}
    visible: false

    label:
    - id: downloadLabel
      text: UI_downloading
      textColor: "${colorUIMoving}"
      margin: {bottom: 1}
    progressBar:
    - id: downloadProgress
      style: ProgressBarMoving
      alignment: ALIGN_BOTTOM
      width: 100%
      height: 1
      consumeInputEvents: false
      value: 0.5

  - id: linkShareWindow
    alignment: ALIGN_VCENTER_HCENTER
    layout: LAYOUT_VERTICAL
    consumeInputEvents: true
    style: background 
    width: 60%
    padding: {left: "${halfSize}", top: "${halfSize}", right: "${halfSize}", bottom: "${halfSize}"}
    visible: false

    label:
    - {id: title, style: titleLabel, textAlignment: ALIGN_HCENTER, width: 100%, margin: {bottom: "${halfSize}"}}
    - {id: message, textAlignment: ALIGN_HCENTER, width: 100%, margin: {bottom: "${spacerSize}"}}
    clipLabel: {id: url, textAlignment: ALIGN_HCENTER, width: 100%, margin: {bottom: "${halfSize}"}}
    button: {id: okButton, alignment: ALIGN_HCENTER, style: textButton, text: UI_ok}

  - id: popupWindow
    alignment: ALIGN_VCENTER_HCENTER
    layout: LAYOUT_VERTICAL
    consumeInputEvents: true
    style: background
    width: 60%
    padding: {left: "${halfSize}", top: "${halfSize}", right: "${halfSize}", bottom: "${halfSize}"}

    label:
    - {id: title, style: titleLabel, textAlignment: ALIGN_HCENTER, width: 100%, margin: {bottom: "${halfSize}"}}
    - {id: message, textAlignment: ALIGN_HCENTER, width: 100%, margin: {bottom: "${halfSize}"}}

    container:
      alignment: ALIGN_HCENTER
      layout: LAYOUT_HORIZONTAL
      button:
      - {id: actionButton, style: textButton, text: UI_ok, margin: {right: "${halfSize}"}}
      - {id: okButton, style: textButton, text: UI_ok}