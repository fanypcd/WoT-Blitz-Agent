material:
  sampler:
    id: u_diffuseTexture
    path: materials/system/white.png
    mipmap: false
    wrapS: CLAMP
    wrapT: CLAMP
    minFilter: NEAREST
    magFilter: NEAREST

  u_worldViewProjectionMatrix: WORLD_VIEW_PROJECTION_MATRIX

  renderState:
    depthTest: true

  technique:
  - id: default

    renderState:
      depthWrite: false
      blend: false
      cullFace: true

    pass:
    - u_modulateColor: [0.9, 0.9, 0.9, 1.0]
      defines: "MODULATE_COLOR"
      vertexShader: res/shaders/textured.vert
      fragmentShader: res/shaders/textured.frag
    - renderState:
       depthFunc: GREATER
      u_modulateColor: [0.64, 0.64, 0.64, 1.0]
      defines: "MODULATE_COLOR"
      vertexShader: res/shaders/textured.vert
      fragmentShader: res/shaders/textured.frag

  - id: hiddenPart
  - id: transparent

    renderState:
      depthWrite: false
      blend: true
      blendSrc: SRC_ALPHA
      blendDst: ONE_MINUS_SRC_ALPHA
      cullFace: true

    pass:
    - u_modulateColor: SCENE_MAIN_COLOR
      u_modulateAlpha: 0.3
      defines: "MODULATE_COLOR;MODULATE_ALPHA"
      vertexShader: res/shaders/textured.vert
      fragmentShader: res/shaders/textured.frag

